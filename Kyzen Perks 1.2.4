--------------------------------------------------------
-- SAFETY LOOP
--------------------------------------------------------

task.spawn(function()
	while ScreenGui.Parent do

		if CurrentTarget then
			local model = CurrentTarget.Model

			if not model
				or not model.Parent
				or not IsAlive(model) then

				if Settings.TargetLostProtection then

					if not TargetLostSince then
						TargetLostSince = os.clock()
					end

					if os.clock() - TargetLostSince
						> Settings.TargetLostTime then

						CurrentTarget = nil
						LockedTarget = nil
						TargetLostSince = nil

						ClearTargetVisual()
					end

				else
					CurrentTarget = nil
					LockedTarget = nil

					ClearTargetVisual()
				end
			end
		end

		task.wait(0.05)
	end
end)

