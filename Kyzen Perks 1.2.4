--------------------------------------------------------
-- TARGET VARIABLES
--------------------------------------------------------

local CurrentTarget = nil
local LockedTarget = nil

local TargetHighlight = nil
local TargetBillboard = nil

local LastTargetSwitch = 0
local TargetLostSince = nil

local CandidateCache = {}
local LastCandidateUpdate = 0

--------------------------------------------------------
-- CHARACTER
--------------------------------------------------------

local function GetCharacterRoot(model)
	if not model or not model:IsA("Model") then
		return nil
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return nil
	end

	return model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("Torso")
		or model.PrimaryPart
end

local function IsAlive(model)
	if not model then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")

	return humanoid
		and humanoid.Health > 0
end

--------------------------------------------------------
-- TARGET PART
--------------------------------------------------------

local function GetTargetPart(model)
	if not model then
		return nil
	end

	if Settings.TargetPart == "HEAD" then
		return model:FindFirstChild("Head")
			or model:FindFirstChild("HumanoidRootPart")
			or GetCharacterRoot(model)
	end

	if Settings.TargetPart == "TORSO" then
		return model:FindFirstChild("UpperTorso")
			or model:FindFirstChild("Torso")
			or model:FindFirstChild("HumanoidRootPart")
			or GetCharacterRoot(model)
	end

	return model:FindFirstChild("HumanoidRootPart")
		or GetCharacterRoot(model)
end

--------------------------------------------------------
-- VALID TARGET
--------------------------------------------------------

local function IsValidTarget(model)
	if not model or not model:IsA("Model") then
		return false
	end

	if model == LocalPlayer.Character then
		return false
	end

	if not IsAlive(model) then
		return false
	end

	local root = GetCharacterRoot(model)
	local localCharacter = LocalPlayer.Character

	if not root or not localCharacter then
		return false
	end

	local localRoot = GetCharacterRoot(localCharacter)

	if not localRoot then
		return false
	end

	local distance =
		(root.Position - localRoot.Position).Magnitude

	return distance <= Settings.TargetRange
end

--------------------------------------------------------
-- BUILD PLAYER CANDIDATES
--------------------------------------------------------

local function RefreshCandidates()
	local candidates = {}
	local localCharacter = LocalPlayer.Character
	local localRoot = localCharacter
		and GetCharacterRoot(localCharacter)

	if not localRoot then
		CandidateCache = {}
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character

			if character and IsValidTarget(character) then
				local root = GetCharacterRoot(character)
				local part = GetTargetPart(character)

				if root and part then
					local offset =
						part.Position - localRoot.Position

					local distance = offset.Magnitude

					table.insert(candidates, {
						Model = character,
						Player = player,
						Root = root,
						Part = part,
						Distance = distance,
					})
				end
			end
		end
	end

	CandidateCache = candidates
	LastCandidateUpdate = os.clock()
end

--------------------------------------------------------
-- NEAREST
--------------------------------------------------------

local function FindNearest(candidates)
	local best = nil

	for _, candidate in ipairs(candidates) do
		if not best
			or candidate.Distance < best.Distance then

			best = candidate
		end
	end

	return best
end

--------------------------------------------------------
-- SMART TARGET
--------------------------------------------------------

local function FindSmart(candidates)
	if #candidates == 0 then
		return nil
	end

	----------------------------------------------------
	-- KEEP CURRENT TARGET
	----------------------------------------------------

	if CurrentTarget
		and CurrentTarget.Model then

		for _, candidate in ipairs(candidates) do
			if candidate.Model == CurrentTarget.Model then
				local nearest = FindNearest(candidates)

				if nearest
					and nearest.Model ~= candidate.Model
					and nearest.Distance
						< candidate.Distance
						* Settings.TargetSwitchThreshold then

					return nearest
				end

				return candidate
			end
		end
	end

	----------------------------------------------------
	-- HEAD / DISTANCE SMART SCORE
	----------------------------------------------------

	local best = nil
	local bestScore = math.huge

	for _, candidate in ipairs(candidates) do
		local score = candidate.Distance

		if Settings.HeadPriority then
			if candidate.Model:FindFirstChild("Head") then
				score *= 0.88
			end
		end

		if candidate.Distance < 50 then
			score *= 0.92
		end

		if score < bestScore then
			bestScore = score
			best = candidate
		end
	end

	return best
end

--------------------------------------------------------
-- LOCK TARGET
--------------------------------------------------------

local function FindLocked(candidates)
	if not LockedTarget then
		return nil
	end

	for _, candidate in ipairs(candidates) do
		if candidate.Model == LockedTarget then
			return candidate
		end
	end

	return nil
end

--------------------------------------------------------
-- TARGET VISUAL
--------------------------------------------------------

local function ClearTargetVisual()
	if TargetHighlight then
		TargetHighlight:Destroy()
		TargetHighlight = nil
	end

	if TargetBillboard then
		TargetBillboard:Destroy()
		TargetBillboard = nil
	end
end

local function GetTargetDisplayName(model)
	local player = Players:GetPlayerFromCharacter(model)

	if player then
		return player.DisplayName
	end

	return model.Name
end

local function ApplyTargetVisual(model)
	ClearTargetVisual()

	if not model then
		return
	end

	local root = GetCharacterRoot(model)

	if not root then
		return
	end

	TargetHighlight = New("Highlight", {
		Name = "DeveloperTargetHighlight",
		Adornee = model,
		FillColor = COLORS.Red,
		FillTransparency = 0.78,
		OutlineColor = COLORS.Red,
		OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
	}, ScreenGui)

	TargetBillboard = New("BillboardGui", {
		Name = "TargetBillboard",
		Adornee = root,
		Size = UDim2.fromOffset(145, 48),
		StudsOffset = Vector3.new(0, 3.3, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, ScreenGui)

	New("TextLabel", {
		Name = "TargetText",
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Text = "TARGET",
		TextColor3 = COLORS.Red,
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		TextStrokeColor3 = COLORS.Black,
		TextStrokeTransparency = 0,
	}, TargetBillboard)

	New("TextLabel", {
		Name = "DistanceText",
		Position = UDim2.new(0, 0, 0, 21),
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = COLORS.White,
		TextSize = 9,
		Font = Enum.Font.GothamBold,
		TextStrokeColor3 = COLORS.Black,
		TextStrokeTransparency = 0,
		Visible = Settings.TargetDistance,
	}, TargetBillboard)

	task.spawn(function()
		while TargetHighlight
			and TargetHighlight.Parent
			and CurrentTarget
			and CurrentTarget.Model == model do

			if Settings.TargetHighlightPulse then
				Tween(
					TargetHighlight,
					{FillTransparency = 0.60},
					0.35
				)

				task.wait(0.35)

				if not TargetHighlight
					or not TargetHighlight.Parent then
					break
				end

				Tween(
					TargetHighlight,
					{FillTransparency = 0.82},
					0.35
				)

				task.wait(0.35)
			else
				TargetHighlight.FillTransparency = 0.78
				task.wait(0.15)
			end
		end
	end)
end

--------------------------------------------------------
-- BILLBOARD
--------------------------------------------------------

local function UpdateTargetBillboard()
	if not CurrentTarget
		or not TargetBillboard then
		return
	end

	local model = CurrentTarget.Model
	local root = GetCharacterRoot(model)

	if not root then
		return
	end

	TargetBillboard.Adornee = root

	local distanceText =
		TargetBillboard:FindFirstChild("DistanceText")

	if distanceText then
		distanceText.Visible = Settings.TargetDistance

		if Settings.TargetDistance then
			local localRoot =
				LocalPlayer.Character
				and GetCharacterRoot(LocalPlayer.Character)

			if localRoot then
				local distance =
					(root.Position - localRoot.Position).Magnitude

				distanceText.Text =
					GetTargetDisplayName(model)
					.. "  •  "
					.. math.floor(distance)
					.. " STUDS"
			end
		end
	end
end

--------------------------------------------------------
-- SELECT TARGET
--------------------------------------------------------

local function SelectTarget(candidate, force)
	if not candidate then
		return
	end

	if CurrentTarget
		and CurrentTarget.Model == candidate.Model then

		return
	end

	local now = os.clock()

	if Settings.TargetSwitchDelay
		and not force
		and CurrentTarget
		and now - LastTargetSwitch
			< Settings.TargetSwitchTime then

		return
	end

	CurrentTarget = candidate
	LockedTarget = candidate.Model

	LastTargetSwitch = now
	TargetLostSince = nil

	ApplyTargetVisual(candidate.Model)
end

--------------------------------------------------------
-- TARGET UPDATE
--------------------------------------------------------

local function UpdateTarget()
	if not (Settings.TargetLock or Settings.AimAssist) then
		CurrentTarget = nil
		LockedTarget = nil
		TargetLostSince = nil

		ClearTargetVisual()

		return
	end

	if os.clock() - LastCandidateUpdate
		>= Settings.TargetRefreshRate then

		RefreshCandidates()
	end

	local candidates = CandidateCache

	if #candidates == 0 then

		if Settings.TargetLostProtection
			and CurrentTarget then

			if not TargetLostSince then
				TargetLostSince = os.clock()
			end

			if os.clock() - TargetLostSince
				<= Settings.TargetLostTime then

				return
			end
		end

		CurrentTarget = nil
		LockedTarget = nil
		TargetLostSince = nil

		ClearTargetVisual()

		return
	end

	TargetLostSince = nil

	local selected

	if Settings.TargetMode == "LOCK" then
		selected = FindLocked(candidates)

		if not selected then
			selected = FindSmart(candidates)
		end

	elseif Settings.TargetMode == "NEAREST" then
		selected = FindNearest(candidates)

	else
		selected = FindSmart(candidates)
	end

	if selected then
		SelectTarget(selected, false)
	end
end

--------------------------------------------------------
-- CAMERA
--------------------------------------------------------

local function GetCameraAlpha(dt)
	if Settings.SmoothnessPreset == "INSTANT" then
		return 1
	end

	local smooth =
		math.clamp(Settings.AimSmoothness, 0.01, 1)

	----------------------------------------------------
	-- EXPONENTIAL SMOOTHING
	-- Independent of FPS
	----------------------------------------------------

	local response =
		3 + (smooth * 35)

	response *= math.clamp(Settings.CameraSpeed, 0.25, 3)

	local alpha =
		1 - math.exp(-response * dt)

	return math.clamp(alpha, 0.01, 1)
end

local function UpdateCamera(dt)
	if not (Settings.TargetLock or Settings.AimAssist) then
		return
	end

	local target = CurrentTarget

	if not target then
		return
	end

	local model = target.Model

	if not model
		or not model.Parent
		or not IsValidTarget(model) then

		return
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local targetPart = GetTargetPart(model)

	if not targetPart then
		return
	end

	----------------------------------------------------
	-- HEAD LOCK
	----------------------------------------------------

	local targetPosition = targetPart.Position

	if Settings.TargetPart == "HEAD" then
		targetPosition += Vector3.new(0, 0.08, 0)
	end

	local cameraPosition = camera.CFrame.Position

	local desired =
		CFrame.lookAt(
			cameraPosition,
			targetPosition
		)

	local alpha = GetCameraAlpha(dt)

	----------------------------------------------------
	-- CAMERA ORIENTATION ONLY
	-- CHARACTER MOVEMENT IS NEVER MODIFIED
	----------------------------------------------------

	camera.CFrame =
		camera.CFrame:Lerp(
			desired,
			alpha
		)
end

