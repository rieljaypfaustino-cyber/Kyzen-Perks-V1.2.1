local function CreateSelector(parent, title, subtitle, values, initial, callback)
	local holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 82),
		BackgroundColor3 = COLORS.Panel2,
		BorderSizePixel = 0,
		LayoutOrder = 5,
		ZIndex = 23,
	}, parent)

	AddCorner(holder, 8)
	AddStroke(holder, Color3.fromRGB(38, 45, 57), 1, 0)

	New("TextLabel", {
		Position = UDim2.new(0, 13, 0, 8),
		Size = UDim2.new(1, -26, 0, 20),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = COLORS.White,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 24,
	}, holder)

	New("TextLabel", {
		Position = UDim2.new(0, 13, 0, 28),
		Size = UDim2.new(1, -26, 0, 16),
		BackgroundTransparency = 1,
		Text = subtitle,
		TextColor3 = COLORS.Muted,
		TextSize = 9,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 24,
	}, holder)

	local buttons = {}
	local current = initial

	for index, value in ipairs(values) do
		local button = New("TextButton", {
			Position = UDim2.new(
				0,
				13 + ((index - 1) * 92),
				0,
				52
			),
			Size = UDim2.fromOffset(84, 22),
			BackgroundColor3 = Color3.fromRGB(27, 32, 41),
			BorderSizePixel = 0,
			Text = value,
			TextColor3 = COLORS.Light,
			TextSize = 8,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
			ZIndex = 25,
		}, holder)

		AddCorner(button, 6)

		button.MouseButton1Click:Connect(function()
			current = value

			for _, item in ipairs(buttons) do
				local active = item.value == current

				Tween(item.button, {
					BackgroundColor3 =
						active
						and COLORS.Blue
						or Color3.fromRGB(27, 32, 41)
				}, 0.12)

				item.button.TextColor3 =
					active
					and COLORS.White
					or COLORS.Light
			end

			if callback then
				callback(value)
			end
		end)

		table.insert(buttons, {
			value = value,
			button = button,
		})
	end

	for _, item in ipairs(buttons) do
		local active = item.value == current

		item.button.BackgroundColor3 =
			active
			and COLORS.Blue
			or Color3.fromRGB(27, 32, 41)

		item.button.TextColor3 =
			active
			and COLORS.White
			or COLORS.Light
	end

	return holder
end

