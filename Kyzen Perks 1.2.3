pcall(function()
	RunService:UnbindFromRenderStep("KyzenPerksCamera")
end)

RunService:BindToRenderStep(
	"KyzenPerksCamera",
	Enum.RenderPriority.Camera.Value + 1,
	function()
		UpdateCamera()
	end
)

