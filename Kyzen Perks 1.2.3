--------------------------------------------------------
-- DRAGGING
--------------------------------------------------------

local function MakeDraggable(object)
	local dragging = false
	local dragStart
	local startPosition

	object.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPosition = object.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - dragStart

		object.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)
end

MakeDraggable(Main)
MakeDraggable(DevButton)

--------------------------------------------------------
-- TARGET SYSTEM
--------------------------------------------------------

local CurrentTarget = nil
local LockedTarget = nil

local TargetHighlight = nil
local TargetBillboard = nil

local LastTargetSwitch = 0
local TargetLostSince = nil

--------------------------------------------------------
-- CHARACTER ROOT
--------------------------------------------------------

local function GetCharacterRoot(model)
	if not model or not model:IsA("Model") then
		return nil
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return nil
	end

	return model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("Torso")
		or model.PrimaryPart
end

--------------------------------------------------------
-- ALIVE
--------------------------------------------------------

local function IsAlive(model)
	if not model then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")

	return humanoid ~= nil and humanoid.Health > 0
end

--------------------------------------------------------
-- TARGET PART
--------------------------------------------------------

local function GetTargetPart(model)
	if not model then
		return nil
	end

	if Settings.TargetPart == "HEAD" then
		return model:FindFirstChild("Head")
			or model:FindFirstChild("HumanoidRootPart")
			or GetCharacterRoot(model)
	end

	if Settings.TargetPart == "TORSO" then
		return model:FindFirstChild("UpperTorso")
			or model:FindFirstChild("Torso")
			or model:FindFirstChild("HumanoidRootPart")
			or GetCharacterRoot(model)
	end

	if Settings.TargetPart == "ROOT" then
		return model:FindFirstChild("HumanoidRootPart")
			or GetCharacterRoot(model)
	end

	return model:FindFirstChild("Head")
		or GetCharacterRoot(model)
end

--------------------------------------------------------
-- VALID TARGET
--------------------------------------------------------

local function IsValidTarget(model)
	if not model or not model:IsA("Model") then
		return false
	end

	if model == LocalPlayer.Character then
		return false
	end

	if not IsAlive(model) then
		return false
	end

	local root = GetCharacterRoot(model)
	local localCharacter = LocalPlayer.Character

	if not root or not localCharacter then
		return false
	end

	local localRoot = GetCharacterRoot(localCharacter)

	if not localRoot then
		return false
	end

	local distance = (
		root.Position - localRoot.Position
	).Magnitude

	return distance <= Settings.TargetRange
end

--------------------------------------------------------
-- GET CANDIDATES
--------------------------------------------------------

local function GetCandidates()
	local candidates = {}
	local seen = {}

	local localCharacter = LocalPlayer.Character
	local localRoot = localCharacter
		and GetCharacterRoot(localCharacter)

	if not localRoot then
		return candidates
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character

			if character
				and not seen[character]
				and IsValidTarget(character) then

				seen[character] = true

				local root = GetCharacterRoot(character)

				if root then
					table.insert(candidates, {
						Model = character,
						Player = player,
						Root = root,
						Distance = (
							root.Position - localRoot.Position
						).Magnitude,
					})
				end
			end
		end
	end

	----------------------------------------------------
	-- NPC / DUMMIES
	----------------------------------------------------

	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Humanoid") then
			local model = descendant.Parent

			if model
				and model:IsA("Model")
				and model ~= localCharacter
				and not seen[model]
				and IsValidTarget(model) then

				seen[model] = true

				local root = GetCharacterRoot(model)

				if root then
					table.insert(candidates, {
						Model = model,
						Player = nil,
						Root = root,
						Distance = (
							root.Position - localRoot.Position
						).Magnitude,
					})
				end
			end
		end
	end

	return candidates
end

--------------------------------------------------------
-- FIND NEAREST
--------------------------------------------------------

local function FindNearest(candidates)
	local best

	for _, candidate in ipairs(candidates) do
		if not best or candidate.Distance < best.Distance then
			best = candidate
		end
	end

	return best
end

--------------------------------------------------------
-- SMART
--------------------------------------------------------

local function FindSmart(candidates)
	if #candidates == 0 then
		return nil
	end

	if CurrentTarget then
		local currentModel = CurrentTarget.Model

		for _, candidate in ipairs(candidates) do
			if candidate.Model == currentModel then
				local nearest = FindNearest(candidates)

				if nearest
					and nearest.Model ~= currentModel
					and nearest.Distance < candidate.Distance * 0.78 then

					return nearest
				end

				return candidate
			end
		end
	end

	return FindNearest(candidates)
end

--------------------------------------------------------
-- LOCK
--------------------------------------------------------

local function FindLock(candidates)
	if not LockedTarget then
		return nil
	end

	for _, candidate in ipairs(candidates) do
		if candidate.Model == LockedTarget then
			return candidate
		end
	end

	return nil
end

--------------------------------------------------------
-- TARGET VISUAL
--------------------------------------------------------

local function ClearTargetVisual()
	if TargetHighlight then
		TargetHighlight:Destroy()
		TargetHighlight = nil
	end

	if TargetBillboard then
		TargetBillboard:Destroy()
		TargetBillboard = nil
	end
end

local function GetTargetDisplayName(model)
	local player = Players:GetPlayerFromCharacter(model)

	if player then
		return player.DisplayName
	end

	return model.Name
end

local function ApplyTargetVisual(model)
	ClearTargetVisual()

	if not model then
		return
	end

	local root = GetCharacterRoot(model)

	if not root then
		return
	end

	TargetHighlight = New("Highlight", {
		Name = "DeveloperTargetHighlight",
		Adornee = model,
		FillColor = COLORS.Red,
		FillTransparency = 0.78,
		OutlineColor = COLORS.Red,
		OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
	}, ScreenGui)

	TargetBillboard = New("BillboardGui", {
		Name = "TargetBillboard",
		Adornee = root,
		Size = UDim2.fromOffset(145, 48),
		StudsOffset = Vector3.new(0, 3.3, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, ScreenGui)

	local TargetText = New("TextLabel", {
		Name = "TargetText",
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Text = "TARGET",
		TextColor3 = COLORS.Red,
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		TextStrokeColor3 = COLORS.Black,
		TextStrokeTransparency = 0,
		ZIndex = 5,
	}, TargetBillboard)

	local DistanceText = New("TextLabel", {
		Name = "DistanceText",
		Position = UDim2.new(0, 0, 0, 21),
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = COLORS.White,
		TextSize = 9,
		Font = Enum.Font.GothamBold,
		TextStrokeColor3 = COLORS.Black,
		TextStrokeTransparency = 0,
		Visible = Settings.TargetDistance,
		ZIndex = 5,
	}, TargetBillboard)

	AddStroke(TargetText, COLORS.Red, 1, 0.8)

	----------------------------------------------------
	-- PULSE
	----------------------------------------------------

	task.spawn(function()
		while TargetHighlight
			and TargetHighlight.Parent
			and CurrentTarget
			and CurrentTarget.Model == model do

			if Settings.TargetHighlightPulse then
				Tween(
					TargetHighlight,
					{FillTransparency = 0.60},
					0.45
				)

				task.wait(0.45)

				if not TargetHighlight
					or not TargetHighlight.Parent then
					break
				end

				Tween(
					TargetHighlight,
					{FillTransparency = 0.82},
					0.45
				)

				task.wait(0.45)
			else
				TargetHighlight.FillTransparency = 0.78
				task.wait(0.15)
			end
		end
	end)
end

--------------------------------------------------------
-- TARGET INFO UPDATE
--------------------------------------------------------

local function UpdateTargetBillboard()
	if not CurrentTarget or not TargetBillboard then
		return
	end

	local model = CurrentTarget.Model

	if not model then
		return
	end

	local root = GetCharacterRoot(model)

	if not root then
		return
	end

	local distanceText = TargetBillboard:FindFirstChild("DistanceText")

	if distanceText then
		distanceText.Visible = Settings.TargetDistance

		if Settings.TargetDistance then
			local localRoot = LocalPlayer.Character
				and GetCharacterRoot(LocalPlayer.Character)

			if localRoot then
				local distance = (
					root.Position - localRoot.Position
				).Magnitude

				distanceText.Text =
					GetTargetDisplayName(model)
					.. "  •  "
					.. math.floor(distance)
					.. " STUDS"
			end
		end
	end
end

--------------------------------------------------------
-- SELECT TARGET
--------------------------------------------------------

local function SelectTarget(candidate)
	if not candidate then
		CurrentTarget = nil
		ClearTargetVisual()
		return
	end

	if CurrentTarget
		and CurrentTarget.Model == candidate.Model then

		return
	end

	local now = os.clock()

	if Settings.TargetSwitchDelay
		and CurrentTarget
		and now - LastTargetSwitch < Settings.TargetSwitchTime then

		return
	end

	CurrentTarget = candidate
	LockedTarget = candidate.Model
	LastTargetSwitch = now
	TargetLostSince = nil

	ApplyTargetVisual(candidate.Model)
end

--------------------------------------------------------
-- TARGET UPDATE
--------------------------------------------------------

local function UpdateTarget()
	if not (Settings.TargetLock or Settings.AimAssist) then
		CurrentTarget = nil
		LockedTarget = nil
		TargetLostSince = nil
		ClearTargetVisual()
		return
	end

	local candidates = GetCandidates()

	if #candidates == 0 then

		if Settings.TargetLostProtection
			and CurrentTarget
			and CurrentTarget.Model then

			if not TargetLostSince then
				TargetLostSince = os.clock()
			end

			if os.clock() - TargetLostSince
				<= Settings.TargetLostTime then

				return
			end
		end

		CurrentTarget = nil
		LockedTarget = nil
		TargetLostSince = nil
		ClearTargetVisual()

		return
	end

	TargetLostSince = nil

	local selected

	if Settings.TargetMode == "LOCK" then
		selected = FindLock(candidates)

		if not selected then
			selected = FindNearest(candidates)
		end

	elseif Settings.TargetMode == "NEAREST" then
		selected = FindNearest(candidates)

	else
		selected = FindSmart(candidates)
	end

	if selected then
		SelectTarget(selected)
	end
end

--------------------------------------------------------
-- CAMERA
--------------------------------------------------------

local function UpdateCamera()
	if not (Settings.TargetLock or Settings.AimAssist) then
		return
	end

	if not CurrentTarget then
		return
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local model = CurrentTarget.Model

	if not model
		or not model.Parent
		or not IsValidTarget(model) then

		return
	end

	local targetPart = GetTargetPart(model)

	if not targetPart then
		return
	end

	local cameraPosition = camera.CFrame.Position

	local desiredCFrame = CFrame.lookAt(
		cameraPosition,
		targetPart.Position
	)

	local smoothness =
		math.clamp(
			Settings.AimSmoothness,
			0.01,
			1
		)

	local alpha

	if Settings.SmoothnessPreset == "INSTANT" then
		alpha = 1
	else
		local response = smoothness * 12

		alpha = 1 - math.exp(
			-response * (1 / 60)
		)

		alpha = math.clamp(alpha, 0.01, 1)
	end

	alpha = math.clamp(
		alpha * Settings.CameraSpeed,
		0.01,
		1
	)

	camera.CFrame = camera.CFrame:Lerp(
		desiredCFrame,
		alpha
	)
end

