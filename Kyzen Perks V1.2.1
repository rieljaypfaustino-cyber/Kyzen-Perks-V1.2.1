--========================================================--
-- TARGET SYSTEM
--========================================================--

local function GetCharacterFromTarget(target)

	if not target then
		return nil
	end

	if target:IsA("Player") then
		return target.Character
	end

	if target:IsA("Model") then
		return target
	end

	return nil
end

local function GetAimPart(character)

	if not character then
		return nil
	end

	local head = character:FindFirstChild("Head")

	if head and head:IsA("BasePart") then
		return head
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root
	end

	return nil
end

local function IsAlive(character)

	if not character then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	return humanoid.Health > 0
end

local function GetLocalRoot()

	local character = LocalPlayer.Character

	if not character then
		return nil
	end

	return character:FindFirstChild(
		"HumanoidRootPart"
	)
end

local function GetDistanceFromLocal(character)

	local localRoot = GetLocalRoot()
	local targetPart = GetAimPart(character)

	if not localRoot or not targetPart then
		return math.huge
	end

	return (
		localRoot.Position -
		targetPart.Position
	).Magnitude
end

local function GetCandidates()

	local candidates = {}

	-- PLAYERS
	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer then

			local character = player.Character

			if character and IsAlive(character) then

				local distance =
					GetDistanceFromLocal(character)

				if distance <= Settings.MaxTargetDistance then

					table.insert(
						candidates,
						{
							Object = player,
							Character = character,
							Distance = distance
						}
					)

				end
			end
		end
	end

	-- NPC / DUMMIES
	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("Model") then

			local humanoid =
				object:FindFirstChildOfClass(
					"Humanoid"
				)

			if humanoid and humanoid.Health > 0 then

				local player =
					Players:GetPlayerFromCharacter(
						object
					)

				if not player then

					local distance =
						GetDistanceFromLocal(object)

					if distance <=
						Settings.MaxTargetDistance then

						table.insert(
							candidates,
							{
								Object = object,
								Character = object,
								Distance = distance
							}
						)

					end
				end
			end
		end
	end

	return candidates
end

local function FindNearest()

	local candidates = GetCandidates()

	local closest = nil

	for _, candidate in ipairs(candidates) do

		if not closest
			or candidate.Distance <
			closest.Distance then

			closest = candidate

		end
	end

	if closest then
		return closest.Object
	end

	return nil
end

local function GetTargetObjectDistance(target)

	local character =
		GetCharacterFromTarget(target)

	if not character then
		return math.huge
	end

	if not IsAlive(character) then
		return math.huge
	end

	return GetDistanceFromLocal(character)
end

local function IsValidTarget(target)

	if not target then
		return false
	end

	local character =
		GetCharacterFromTarget(target)

	if not character then
		return false
	end

	if not IsAlive(character) then
		return false
	end

	local distance =
		GetDistanceFromLocal(character)

	if distance >
		Settings.MaxTargetDistance then

		return false
	end

	return true
end

