--========================================================--
-- CIRCLE TOGGLE
--========================================================--

local function CreateCircleToggle(parent, y, title, description, default, callback)

	local row = CreateOptionRow(
		parent,
		y,
		title,
		description
	)

	-- Circular toggle
	local button = Instance.new("TextButton")
	button.Name = "CircleToggle"
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position = UDim2.new(1, -14, 0.5, 0)
	button.Size = UDim2.fromOffset(32, 32)
	button.BackgroundColor3 = Color3.fromRGB(27, 29, 37)
	button.BorderSizePixel = 0
	button.Text = ""
	button.AutoButtonColor = false
	button.Parent = row

	AddCorner(button, 100)
	AddStroke(button, COLORS.Border, 1)

	local inner = Instance.new("Frame")
	inner.Name = "Circle"
	inner.AnchorPoint = Vector2.new(0.5, 0.5)
	inner.Position = UDim2.fromScale(0.5, 0.5)
	inner.Size = UDim2.fromOffset(16, 16)
	inner.BackgroundColor3 = COLORS.Grey2
	inner.BorderSizePixel = 0
	inner.Parent = button

	AddCorner(inner, 100)

	local state = default

	local function Refresh(animated)

		if state then

			if animated then

				Tween(
					button,
					{
						BackgroundColor3 = Color3.fromRGB(24, 63, 108)
					},
					0.16
				)

				Tween(
					inner,
					{
						Size = UDim2.fromOffset(20, 20),
						BackgroundColor3 = COLORS.BlueBright
					},
					0.16,
					Enum.EasingStyle.Back
				)

			else

				button.BackgroundColor3 =
					Color3.fromRGB(24, 63, 108)

				inner.Size =
					UDim2.fromOffset(20, 20)

				inner.BackgroundColor3 =
					COLORS.BlueBright

			end

		else

			if animated then

				Tween(
					button,
					{
						BackgroundColor3 =
							Color3.fromRGB(27, 29, 37)
					},
					0.16
				)

				Tween(
					inner,
					{
						Size = UDim2.fromOffset(16, 16),
						BackgroundColor3 = COLORS.Grey2
					},
					0.16
				)

			else

				button.BackgroundColor3 =
					Color3.fromRGB(27, 29, 37)

				inner.Size =
					UDim2.fromOffset(16, 16)

				inner.BackgroundColor3 =
					COLORS.Grey2

			end
		end
	end

	Refresh(false)

	table.insert(
		GuiConnections,
		button.MouseButton1Click:Connect(function()

			state = not state

			Refresh(true)

			callback(state)

		end)
	)

	return {
		Set = function(value)

			state = value

			Refresh(true)

			callback(state)

		end,

		Get = function()
			return state
		end
	}
end

--========================================================--
-- NUMBER CONTROL
--========================================================--

local function CreateNumberControl(
	parent,
	y,
	title,
	description,
	getValue,
	setValue,
	minimum,
	maximum,
	step,
	displayFunction,
	valueColor
)

	local row = CreateOptionRow(
		parent,
		y,
		title,
		description
	)

	local minus = Instance.new("TextButton")
	minus.Name = "Minus"
	minus.AnchorPoint = Vector2.new(1, 0.5)
	minus.Position = UDim2.new(1, -76, 0.5, 0)
	minus.Size = UDim2.fromOffset(28, 28)
	minus.BackgroundColor3 = Color3.fromRGB(27, 29, 37)
	minus.BorderSizePixel = 0
	minus.Text = "−"
	minus.Font = Enum.Font.GothamBold
	minus.TextColor3 = COLORS.White
	minus.TextSize = 15
	minus.AutoButtonColor = false
	minus.Parent = row

	AddCorner(minus, 8)
	AddStroke(minus, COLORS.Border, 1)

	local value = Instance.new("TextLabel")
	value.Name = "Value"
	value.AnchorPoint = Vector2.new(0.5, 0.5)
	value.Position = UDim2.new(1, -53, 0.5, 0)
	value.Size = UDim2.fromOffset(40, 32)
	value.BackgroundTransparency = 1
	value.Font = Enum.Font.GothamBold
	value.TextColor3 = valueColor or COLORS.BlueBright
	value.TextSize = 10
	value.Parent = row

	local plus = minus:Clone()
	plus.Name = "Plus"
	plus.Position = UDim2.new(1, -14, 0.5, 0)
	plus.Text = "+"
	plus.Parent = row

	local function Refresh()

		local current = getValue()

		value.Text = displayFunction(current)

	end

	Refresh()

	table.insert(
		GuiConnections,
		minus.MouseButton1Click:Connect(function()

			local current = getValue()

			local newValue = math.clamp(
				current - step,
				minimum,
				maximum
			)

			setValue(newValue)

			Refresh()

		end)
	)

	table.insert(
		GuiConnections,
		plus.MouseButton1Click:Connect(function()

			local current = getValue()

			local newValue = math.clamp(
				current + step,
				minimum,
				maximum
			)

			setValue(newValue)

			Refresh()

		end)
	)

	return {
		Refresh = Refresh
	}
end

