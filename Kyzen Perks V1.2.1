--========================================================--
-- SMART TARGET UPDATE
--========================================================--

local function UpdateTarget()

	if not Settings.Enabled
		or not Settings.TargetLock then

		if CurrentTarget then
			CurrentTarget = nil
			ClearTargetVisual()
		end

		return
	end

	local currentValid =
		IsValidTarget(CurrentTarget)

	-- LOCK MODE
	if Settings.TargetMode == "LOCK" then

		if currentValid then
			return
		end

		CurrentTarget = FindNearest()

		if CurrentTarget then
			CreateTargetVisual(CurrentTarget)
		else
			ClearTargetVisual()
		end

		return
	end

	-- NEAREST MODE
	if Settings.TargetMode == "NEAREST" then

		local nearest = FindNearest()

		if nearest ~= CurrentTarget then

			CurrentTarget = nearest

			if CurrentTarget then
				CreateTargetVisual(CurrentTarget)
			else
				ClearTargetVisual()
			end
		end

		return
	end

	-- SMART MODE
	local nearest = FindNearest()

	if not currentValid then

		CurrentTarget = nearest
		TargetSwitchStarted = 0

		if CurrentTarget then
			CreateTargetVisual(CurrentTarget)
		else
			ClearTargetVisual()
		end

		return
	end

	if not nearest then
		return
	end

	if nearest == CurrentTarget then
		TargetSwitchStarted = 0
		return
	end

	local currentDistance =
		GetTargetObjectDistance(
			CurrentTarget
		)

	local nearestDistance =
		GetTargetObjectDistance(
			nearest
		)

	if nearestDistance <
		currentDistance * Settings.SwitchRatio then

		if TargetSwitchStarted == 0 then
			TargetSwitchStarted = os.clock()
		end

		if os.clock() -
			TargetSwitchStarted >=
			Settings.SwitchDelay then

			CurrentTarget = nearest
			TargetSwitchStarted = 0

			CreateTargetVisual(CurrentTarget)

		end

	else

		TargetSwitchStarted = 0

	end
end

--========================================================--
-- CAMERA FOLLOW
--========================================================--

local function CameraFollowTarget(deltaTime)

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	if not Settings.Enabled then
		return
	end

	if not Settings.TargetLock then
		return
	end

	if not Settings.CameraFollow then
		return
	end

	if not IsValidTarget(CurrentTarget) then
		return
	end

	local character =
		GetCharacterFromTarget(
			CurrentTarget
		)

	if not character then
		return
	end

	local aimPart =
		GetAimPart(character)

	if not aimPart then
		return
	end

	local cameraPosition =
		camera.CFrame.Position

	local targetPosition =
		aimPart.Position +
		Vector3.new(0, 0.35, 0)

	local direction =
		targetPosition -
		cameraPosition

	if direction.Magnitude < 0.05 then
		return
	end

	local desiredCFrame =
		CFrame.lookAt(
			cameraPosition,
			targetPosition
		)

	local fastAlpha =
		1 - math.exp(
			-Settings.CameraSpeed *
			deltaTime
		)

	local smoothAlpha =
		math.clamp(
			fastAlpha *
			Settings.CameraSmoothness,
			0.08,
			0.92
		)

	camera.CFrame =
		camera.CFrame:Lerp(
			desiredCFrame,
			smoothAlpha
		)

	LastCameraCFrame =
		camera.CFrame
end

