--========================================================--
-- RESPONSIVE SCALE
--========================================================--

local UIScale = Instance.new("UIScale")
UIScale.Parent = Main

local function UpdateScale()

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport = camera.ViewportSize
	local smallest = math.min(viewport.X, viewport.Y)

	local scale

	if smallest < 500 then
		scale = math.clamp(smallest / 510, 0.70, 0.88)
	else
		scale = math.clamp(smallest / 700, 0.88, 1.08)
	end

	UIScale.Scale = scale
end

task.defer(UpdateScale)

