local Pages = {}
local TabObjects = {}
local CurrentPage = nil

local function MakePage(name)
	local page = New("ScrollingFrame", {
		Name = name,

		Size = UDim2.fromScale(1, 1),

		BackgroundTransparency = 1,

		BorderSizePixel = 0,

		ScrollBarThickness = 2,

		ScrollBarImageColor3 = C.Blue,

		AutomaticCanvasSize = Enum.AutomaticSize.Y,

		CanvasSize = UDim2.new(0, 0, 0, 0),

		Visible = false,

		ZIndex = 12,
	}, Content)

	Pages[name] = page

	return page
end

local function PageHeader(page, title, subtitle)

	New("TextLabel", {
		Position = UDim2.new(0, 17, 0, 14),

		Size = UDim2.new(1, -34, 0, 25),

		BackgroundTransparency = 1,

		Text = title,

		TextColor3 = C.White,
		TextSize = 17,
		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 13,
	}, page)

	New("TextLabel", {
		Position = UDim2.new(0, 18, 0, 38),

		Size = UDim2.new(1, -36, 0, 20),

		BackgroundTransparency = 1,

		Text = subtitle,

		TextColor3 = C.Gray,
		TextSize = 9,
		Font = Enum.Font.GothamMedium,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 13,
	}, page)

	New("Frame", {
		Position = UDim2.new(0, 17, 0, 62),

		Size = UDim2.new(1, -34, 0, 1),

		BackgroundColor3 = C.Stroke,

		BorderSizePixel = 0,

		ZIndex = 13,
	}, page)
end

local AimPage = MakePage("AimTarget")
local SettingsPage = MakePage("Settings")
local InfoPage = MakePage("InfoCredit")
