--========================================================
-- TOGGLE
--========================================================

local function Toggle(page, title, desc, value, callback, order)

	local box = New("Frame", {
		Size = UDim2.new(1, -28, 0, 58),

		BackgroundColor3 = C.Panel2,

		LayoutOrder = order,

		ZIndex = 13,
	}, page)

	Corner(box, 9)
	Stroke(box, C.Stroke, 1, 0.2)

	New("TextLabel", {
		Position = UDim2.new(0, 12, 0, 8),

		Size = UDim2.new(1, -90, 0, 19),

		BackgroundTransparency = 1,

		Text = title,

		TextColor3 = C.White,
		TextSize = 11,
		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 14,
	}, box)

	New("TextLabel", {
		Position = UDim2.new(0, 12, 0, 29),

		Size = UDim2.new(1, -90, 0, 17),

		BackgroundTransparency = 1,

		Text = desc,

		TextColor3 = C.Gray,
		TextSize = 8,
		Font = Enum.Font.GothamMedium,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 14,
	}, box)

	local button = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),

		Position = UDim2.new(1, -12, 0.5, 0),

		Size = UDim2.fromOffset(47, 25),

		BackgroundColor3 = C.Dark,

		Text = "",

		AutoButtonColor = false,

		ZIndex = 15,
	}, box)

	Corner(button, 99)

	local dot = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),

		Position = UDim2.new(0, 3, 0.5, 0),

		Size = UDim2.fromOffset(19, 19),

		BackgroundColor3 = C.White,

		ZIndex = 16,
	}, button)

	Corner(dot, 99)

	local enabled = value

	local function Refresh()

		if enabled then
			Tween(button, 0.16, {
				BackgroundColor3 = C.Blue,
			}):Play()

			Tween(dot, 0.16, {
				Position = UDim2.new(1, -22, 0.5, 0),
			}):Play()
		else
			Tween(button, 0.16, {
				BackgroundColor3 = C.Dark,
			}):Play()

			Tween(dot, 0.16, {
				Position = UDim2.new(0, 3, 0.5, 0),
			}):Play()
		end
	end

	button.Activated:Connect(function()
		enabled = not enabled

		callback(enabled)

		Refresh()
	end)

	Refresh()

	return box
end

--========================================================
-- NUMBER
--========================================================

local function Number(page, title, desc, value, min, max, step, callback, order)

	local box = New("Frame", {
		Size = UDim2.new(1, -28, 0, 58),

		BackgroundColor3 = C.Panel2,

		LayoutOrder = order,

		ZIndex = 13,
	}, page)

	Corner(box, 9)
	Stroke(box, C.Stroke, 1, 0.2)

	New("TextLabel", {
		Position = UDim2.new(0, 12, 0, 8),

		Size = UDim2.new(1, -150, 0, 19),

		BackgroundTransparency = 1,

		Text = title,

		TextColor3 = C.White,
		TextSize = 11,
		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 14,
	}, box)

	New("TextLabel", {
		Position = UDim2.new(0, 12, 0, 29),

		Size = UDim2.new(1, -150, 0, 16),

		BackgroundTransparency = 1,

		Text = desc,

		TextColor3 = C.Gray,
		TextSize = 8,
		Font = Enum.Font.GothamMedium,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 14,
	}, box)

	local minus = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),

		Position = UDim2.new(1, -82, 0.5, 0),

		Size = UDim2.fromOffset(25, 25),

		BackgroundColor3 = C.Panel,

		Text = "−",

		TextColor3 = C.White,
		TextSize = 15,
		Font = Enum.Font.GothamBold,

		AutoButtonColor = false,

		ZIndex = 15,
	}, box)

	Corner(minus, 7)
	Stroke(minus, C.Stroke, 1, 0)

	local valueLabel = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),

		Position = UDim2.new(1, -43, 0.5, 0),

		Size = UDim2.fromOffset(36, 25),

		BackgroundColor3 = C.Blue,

		TextColor3 = C.White,
		TextSize = 8,
		Font = Enum.Font.GothamBold,

		ZIndex = 15,
	}, box)

	Corner(valueLabel, 7)

	local plus = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),

		Position = UDim2.new(1, -10, 0.5, 0),

		Size = UDim2.fromOffset(25, 25),

		BackgroundColor3 = C.Panel,

		Text = "+",

		TextColor3 = C.White,
		TextSize = 15,
		Font = Enum.Font.GothamBold,

		AutoButtonColor = false,

		ZIndex = 15,
	}, box)

	Corner(plus, 7)
	Stroke(plus, C.Stroke, 1, 0)

	local current = value

	local function Refresh()
		valueLabel.Text = tostring(current)
	end

	minus.Activated:Connect(function()
		current = math.clamp(current - step, min, max)
		callback(current)
		Refresh()
	end)

	plus.Activated:Connect(function()
		current = math.clamp(current + step, min, max)
		callback(current)
		Refresh()
	end)

	Refresh()

	return box
end

--========================================================
-- TARGET MODE
--========================================================

local function Modes(page, order)

	local box = New("Frame", {
		Size = UDim2.new(1, -28, 0, 76),

		BackgroundColor3 = C.Panel2,

		LayoutOrder = order,

		ZIndex = 13,
	}, page)

	Corner(box, 9)
	Stroke(box, C.Stroke, 1, 0.2)

	New("TextLabel", {
		Position = UDim2.new(0, 12, 0, 8),

		Size = UDim2.new(1, -24, 0, 18),

		BackgroundTransparency = 1,

		Text = "TARGET MODE",

		TextColor3 = C.White,
		TextSize = 10,
		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 14,
	}, box)

	local modes = {"SMART", "NEAREST", "LOCK"}

	for i, mode in ipairs(modes) do

		local button = New("TextButton", {
			Position = UDim2.new(
				0,
				10 + ((i - 1) * 88),
				0,
				37
			),

			Size = UDim2.fromOffset(80, 26),

			BackgroundColor3 =
				mode == Settings.TargetMode
				and C.Blue
				or C.Panel,

			Text = mode,

			TextColor3 = C.White,
			TextSize = 8,
			Font = Enum.Font.GothamBold,

			AutoButtonColor = false,

			ZIndex = 14,
		}, box)

		Corner(button, 7)
		Stroke(button, C.Stroke, 1, 0)

		button.Activated:Connect(function()

			Settings.TargetMode = mode

			-- Immediately allow new target selection
			if mode ~= "LOCK" then
				LockedTarget = nil
			end

			for _, child in ipairs(box:GetChildren()) do

				if child:IsA("TextButton") then

					local selected =
						child.Text == Settings.TargetMode

					Tween(child, 0.12, {
						BackgroundColor3 =
							selected
							and C.Blue
							or C.Panel,
					}):Play()

				end

			end

		end)

	end

	return box
end

