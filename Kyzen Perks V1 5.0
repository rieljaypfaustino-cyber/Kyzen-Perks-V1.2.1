--========================================================
-- TAB BUTTONS
--========================================================

local function CreateTab(name, text, order)

	local button = New("TextButton", {
		Name = name,

		Size = UDim2.new(1, 0, 0, 38),

		BackgroundColor3 = C.Panel,

		Text = "   " .. text,

		TextColor3 = C.Gray,

		TextSize = 8,
		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		AutoButtonColor = false,

		LayoutOrder = order,

		ZIndex = 13,
	}, TabHolder)

	Corner(button, 7)

	local line = New("Frame", {
		Position = UDim2.new(0, 0, 0.5, -8),

		Size = UDim2.fromOffset(3, 16),

		BackgroundColor3 = C.Blue,

		Visible = false,

		ZIndex = 14,
	}, button)

	Corner(line, 3)

	TabObjects[name] = {
		Button = button,
		Line = line,
	}

	button.Activated:Connect(function()

		for pageName, page in pairs(Pages) do
			page.Visible = pageName == name
		end

		for tabName, data in pairs(TabObjects) do

			local active = tabName == name

			Tween(data.Button, 0.12, {
				BackgroundColor3 =
					active
					and Color3.fromRGB(25, 38, 61)
					or C.Panel,

				TextColor3 =
					active
					and C.White
					or C.Gray,
			}):Play()

			data.Line.Visible = active

		end

		CurrentPage = name
	end)
end

CreateTab("AimTarget", "AIM & TARGET", 1)
CreateTab("Settings", "SETTINGS", 2)
CreateTab("InfoCredit", "INFO & CREDIT", 3)
CreateTab("Discord", "DISCORD", 4)

--========================================================
-- TARGET SYSTEM
--========================================================

local CurrentTarget = nil
local LockedTarget = nil

local HighlightObject = nil
local BillboardObject = nil

--========================================================
-- CLEAR VISUALS
--========================================================

local function ClearVisuals()

	if HighlightObject then
		HighlightObject:Destroy()
		HighlightObject = nil
	end

	if BillboardObject then
		BillboardObject:Destroy()
		BillboardObject = nil
	end

end

--========================================================
-- VALID PLAYER
--========================================================

local function ValidPlayer(player)

	if not player then
		return false
	end

	if player == LocalPlayer then
		return false
	end

	local character = player.Character

	if not character or not Alive(character) then
		return false
	end

	local root = Root(character)

	if not root then
		return false
	end

	local localRoot = Root(LocalPlayer.Character)

	if not localRoot then
		return false
	end

	local distance =
		(root.Position - localRoot.Position).Magnitude

	if distance > Settings.TargetRange then
		return false
	end

	return true
end

--========================================================
-- FOV CHECK
--========================================================

local function InsideFOV(player)

	if not Settings.ShowFOV then
		return true
	end

	local part = AimPart(player.Character)

	if not part then
		return false
	end

	local screen, visible =
		Camera:WorldToViewportPoint(part.Position)

	if not visible then
		return false
	end

	-- IMPORTANT:
	-- Use actual viewport center.
	-- No GUI offset.
	local center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	local point = Vector2.new(
		screen.X,
		screen.Y
	)

	return (point - center).Magnitude
		<= Settings.FOVRadius
end

--========================================================
-- GET PLAYERS
--========================================================

local function GetValidPlayers()

	local list = {}

	for _, player in ipairs(Players:GetPlayers()) do

		if ValidPlayer(player)
			and InsideFOV(player) then

			table.insert(list, player)

		end

	end

	return list
end

--========================================================
-- NEAREST
--========================================================

local function FindNearest()

	local localRoot = Root(LocalPlayer.Character)

	if not localRoot then
		return nil
	end

	local best = nil
	local bestDistance = math.huge

	for _, player in ipairs(GetValidPlayers()) do

		local root = Root(player.Character)

		if root then

			local distance =
				(root.Position - localRoot.Position).Magnitude

			if distance < bestDistance then

				bestDistance = distance
				best = player

			end

		end

	end

	return best
end

--========================================================
-- SMART
--========================================================

local function FindSmart()

	local best = nil
	local bestScore = math.huge

	local center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	for _, player in ipairs(GetValidPlayers()) do

		local part = AimPart(player.Character)

		local root = Root(player.Character)

		if part and root then

			local screen, visible =
				Camera:WorldToViewportPoint(
					part.Position
				)

			if visible then

				local screenPoint = Vector2.new(
					screen.X,
					screen.Y
				)

				local screenDistance =
					(screenPoint - center).Magnitude

				local localRoot =
					Root(LocalPlayer.Character)

				local worldDistance = 0

				if localRoot then
					worldDistance =
						(root.Position - localRoot.Position).Magnitude
				end

				-- Smart weighting:
				-- center position matters most,
				-- distance matters second.
				local score =
					screenDistance
					+ (worldDistance * 0.12)

				if score < bestScore then
					bestScore = score
					best = player
				end

			end

		end

	end

	return best
end

--========================================================
-- LOCK
--========================================================

local function FindLock()

	if LockedTarget
		and ValidPlayer(LockedTarget)
		and InsideFOV(LockedTarget) then

		return LockedTarget
	end

	local newTarget = FindSmart()

	LockedTarget = newTarget

	return newTarget
end

--========================================================
-- SELECT TARGET
--========================================================

local function SelectTarget()

	if Settings.TargetMode == "NEAREST" then

		return FindNearest()

	elseif Settings.TargetMode == "LOCK" then

		return FindLock()

	elseif Settings.TargetLock then

		if LockedTarget
			and ValidPlayer(LockedTarget) then

			return LockedTarget
		end

		local target = FindSmart()

		LockedTarget = target

		return target

	else

		return FindSmart()

	end
end

--========================================================
-- TARGET VISUALS
--========================================================

function UpdateVisuals()

	ClearVisuals()

	if not CurrentTarget then
		return
	end

	if not ValidPlayer(CurrentTarget) then
		return
	end

	local character = CurrentTarget.Character

	if not character then
		return
	end

	--====================================================
	-- RED ESP HIGHLIGHT
	--====================================================

	if Settings.ShowHighlight then

		local highlight = Instance.new("Highlight")

		highlight.Name = "KyzenTargetESP"

		highlight.Adornee = character

		highlight.FillColor = C.Red

		highlight.FillTransparency = 0.72

		highlight.OutlineColor = C.RedLight

		highlight.OutlineTransparency = 0

		highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop

		highlight.Parent = character

		HighlightObject = highlight

	end

	--====================================================
	-- TARGET TEXT
	--====================================================

	if Settings.ShowTargetText then

		local head =
			character:FindFirstChild("Head")

		if head then

			local billboard =
				Instance.new("BillboardGui")

			billboard.Name =
				"KyzenTargetText"

			billboard.Adornee = head

			billboard.Size =
				UDim2.fromOffset(180, 35)

			billboard.StudsOffset =
				Vector3.new(0, 3.1, 0)

			billboard.AlwaysOnTop = true

			billboard.MaxDistance = 1000

			billboard.Parent = head

			local label = New("TextLabel", {

				Size = UDim2.fromScale(1, 1),

				BackgroundTransparency = 1,

				Text =
					"TARGET  •  "
					.. CurrentTarget.DisplayName,

				TextColor3 = C.RedLight,

				TextStrokeColor3 =
					Color3.fromRGB(0, 0, 0),

				TextStrokeTransparency = 0.15,

				TextSize = 11,

				Font = Enum.Font.GothamBold,

				ZIndex = 20,

			}, billboard)

			BillboardObject = billboard

		end

	end
end

--========================================================
-- TARGET UPDATE
--========================================================

local LastTarget = nil

local function UpdateTarget()

	local newTarget = SelectTarget()

	-- LOCK MODE:
	-- don't switch unnecessarily.
	if Settings.TargetMode == "LOCK"
		or Settings.TargetLock then

		if LockedTarget
			and ValidPlayer(LockedTarget) then

			newTarget = LockedTarget

		end

	end

	-- FAST SMART SWITCHING
	-- Smart mode continuously evaluates nearby targets.
	if Settings.TargetMode == "SMART"
		and not Settings.TargetLock then

		local smart = FindSmart()

		if smart then
			newTarget = smart
		end

	end

	if newTarget ~= LastTarget then

		LastTarget = newTarget
		CurrentTarget = newTarget

		if CurrentTarget then
			LockedTarget = CurrentTarget
		end

		UpdateVisuals()

	end

	if CurrentTarget
		and not ValidPlayer(CurrentTarget) then

		CurrentTarget = nil
		LastTarget = nil
		LockedTarget = nil

		ClearVisuals()

	end
end

--========================================================
-- SMOOTH CAMERA
--========================================================

local function UpdateCamera()

	if not Settings.TargetLock
		and not Settings.AimAssist then

		return
	end

	local target = CurrentTarget

	if not target then
		return
	end

	if not ValidPlayer(target) then
		return
	end

	local part = AimPart(target.Character)

	if not part then
		return
	end

	-- Full 3D look-at.
	-- Works whether target is:
	-- front / back / left / right / above / below.
	local cameraPosition =
		Camera.CFrame.Position

	local desired =
		CFrame.lookAt(
			cameraPosition,
			part.Position
		)

	-- Faster while still smooth.
	local smooth =
		math.clamp(
			Settings.AimSmoothness
			* Settings.CameraSpeed
			* 1.35,
			0.02,
			0.92
		)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			desired,
			smooth
		)
end

--========================================================
-- ATTACK BUTTON
--========================================================

local function GetAttackButton()

	local mobileButtons =
		PlayerGui:FindFirstChild("MobileButtons")

	if not mobileButtons then
		return nil
	end

	local buttons =
		mobileButtons:FindFirstChild("Buttons")

	if not buttons then
		return nil
	end

	local attack =
		buttons:FindFirstChild("Attack")

	if attack
		and attack:IsA("ImageButton") then

		return attack
	end

	return nil
end

--========================================================
-- AUTO SHOOT
--========================================================

local LastShot = 0

local function AutoShoot()

	if not Settings.AutoShoot then
		return
	end

	if not CurrentTarget then
		return
	end

	if not ValidPlayer(CurrentTarget) then
		return
	end

	local attack =
		GetAttackButton()

	if not attack then
		return
	end

	if not attack.Visible then
		return
	end

	if not attack.Active then
		return
	end

	local now = os.clock()

	if now - LastShot
		< Settings.AutoShootCooldown then

		return
	end

	LastShot = now

	-- Native Roblox GUI activation.
	pcall(function()
		attack:Activate()
	end)
end

--========================================================
-- FOV CENTER UPDATE
--========================================================

task.spawn(function()

	while Gui.Parent do

		-- Keep it EXACTLY at viewport center.
		FOV.AnchorPoint =
			Vector2.new(0.5, 0.5)

		FOV.Position =
			UDim2.fromScale(0.5, 0.5)

		FOV.Size =
			UDim2.fromOffset(
				Settings.FOVRadius * 2,
				Settings.FOVRadius * 2
			)

		FOV.Visible = Settings.ShowFOV

		task.wait(0.05)
	end
end)

--========================================================
-- TARGET LOOP
--========================================================

task.spawn(function()

	while Gui.Parent do

		UpdateTarget()

		task.wait(0.035)

	end
end)

--========================================================
-- AUTO SHOOT LOOP
--========================================================

task.spawn(function()

	while Gui.Parent do

		AutoShoot()

		task.wait(0.02)

	end
end)

--========================================================
-- CAMERA LOOP
--========================================================

RunService:BindToRenderStep(
	"KyzenPerksSmoothCamera",
	Enum.RenderPriority.Camera.Value + 1,
	function()

		if not Gui.Parent then
			return
		end

		UpdateCamera()
	end
)

--========================================================
-- RESPAWN SAFETY
--========================================================

LocalPlayer.CharacterAdded:Connect(function()

	CurrentTarget = nil
	LockedTarget = nil
	LastTarget = nil

	ClearVisuals()

	task.wait(0.5)

	UpdateScale()
end)

--========================================================
-- PLAYER REMOVAL
--========================================================

Players.PlayerRemoving:Connect(function(player)

	if player == CurrentTarget
		or player == LockedTarget then

		CurrentTarget = nil
		LockedTarget = nil
		LastTarget = nil

		ClearVisuals()
	end
end)

--========================================================
-- VISUAL SAFETY
--========================================================

task.spawn(function()

	while Gui.Parent do

		if CurrentTarget
			and not ValidPlayer(CurrentTarget) then

			CurrentTarget = nil
			LockedTarget = nil
			LastTarget = nil

			ClearVisuals()

		end

		task.wait(0.15)
	end
end)

--========================================================
-- DRAGGING
--========================================================

local dragging = false
local dragStart
local startPos

Header.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = Main.Position
	end
end)

Header.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if not dragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then

		return
	end

	local delta =
		input.Position - dragStart

	Main.Position =
		UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,

			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
end)

--========================================================
-- OPEN / CLOSE
--========================================================

local function Open()

	if Main.Visible then
		return
	end

	Main.Visible = true

	Main.Size =
		UDim2.fromOffset(650, 420)

	Tween(Main, 0.25, {
		Size = UDim2.fromOffset(700, 450)
	}):Play()

	-- First page
	for name, page in pairs(Pages) do
		page.Visible = name == "AimTarget"
	end

	for name, data in pairs(TabObjects) do

		local active = name == "AimTarget"

		data.Line.Visible = active

		data.Button.BackgroundColor3 =
			active
			and Color3.fromRGB(25, 38, 61)
			or C.Panel

		data.Button.TextColor3 =
			active
			and C.White
			or C.Gray
	end

	CurrentPage = "AimTarget"
end

local function CloseWindow()

	Tween(Main, 0.18, {
		Size = UDim2.fromOffset(650, 420)
	}):Play()

	task.delay(0.18, function()

		if Main.Parent then
			Main.Visible = false
		end

	end)
end

DevButton.Activated:Connect(function()

	if Main.Visible then
		CloseWindow()
	else
		Open()
	end

end)

Close.Activated:Connect(CloseWindow)

--========================================================
-- BUTTON HOVER
--========================================================

Close.MouseEnter:Connect(function()

	Tween(Close, 0.12, {
		BackgroundColor3 = C.RedLight
	}):Play()

end)

Close.MouseLeave:Connect(function()

	Tween(Close, 0.12, {
		BackgroundColor3 = C.Red
	}):Play()

end)

--========================================================
-- INITIAL
--========================================================

FOV.Visible = false

task.delay(0.25, function()
	Open()
end)

