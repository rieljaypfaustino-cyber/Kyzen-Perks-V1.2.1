--==================================================
-- HELPERS
--==================================================

local function Tween(object, properties, duration)
    local info = TweenInfo.new(
        duration or 0.2,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out
    )

    TweenService:Create(object, info, properties):Play()
end

local function Corner(object, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = object
    return c
end

local function Stroke(object, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or BLUE
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = object
    return s
end

local function Gradient(object)
    local g = Instance.new("UIGradient")

    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(
            0,
            Color3.fromRGB(30, 90, 210)
        ),

        ColorSequenceKeypoint.new(
            0.5,
            Color3.fromRGB(13, 30, 70)
        ),

        ColorSequenceKeypoint.new(
            1,
            Color3.fromRGB(175, 30, 45)
        )
    })

    g.Rotation = 25
    g.Parent = object

    return g
end

local function MakeLabel(parent, text, size, position, fontSize)
    local label = Instance.new("TextLabel")

    label.BackgroundTransparency = 1
    label.Size = size
    label.Position = position
    label.Text = text
    label.TextColor3 = WHITE
    label.Font = Enum.Font.GothamBold
    label.TextSize = fontSize or 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = parent

    return label
end

