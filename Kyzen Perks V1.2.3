local function ClearTargetVisual()

    if TargetHighlight then
        TargetHighlight:Destroy()
        TargetHighlight = nil
    end

    if TargetBillboard then
        TargetBillboard:Destroy()
        TargetBillboard = nil
    end
end

local function ShowTargetVisual(target)

    ClearTargetVisual()

    if not target
        or not target.Character then

        return
    end

    TargetHighlight = Instance.new(
        "Highlight"
    )

    TargetHighlight.Name =
        "KyzenTargetHighlight"

    TargetHighlight.FillColor = RED
    TargetHighlight.OutlineColor = RED2

    TargetHighlight.FillTransparency = 0.75
    TargetHighlight.OutlineTransparency = 0

    TargetHighlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    TargetHighlight.Adornee =
        target.Character

    TargetHighlight.Parent =
        target.Character

    local head =
        target.Character:FindFirstChild(
            "Head"
        )

    if head then

        TargetBillboard =
            Instance.new("BillboardGui")

        TargetBillboard.Name =
            "KyzenTarget"

        TargetBillboard.Size =
            UDim2.fromOffset(150, 45)

        TargetBillboard.StudsOffset =
            Vector3.new(0, 2.8, 0)

        TargetBillboard.AlwaysOnTop = true

        TargetBillboard.Parent = head

        local label =
            Instance.new("TextLabel")

        label.Size =
            UDim2.fromScale(1, 1)

        label.BackgroundTransparency = 1

        label.TextColor3 = RED2
        label.TextStrokeTransparency = 0.4

        label.Font =
            Enum.Font.GothamBold

        label.TextSize = 12
        label.Text = "TARGET"

        label.Parent =
            TargetBillboard
    end
end

--==================================================
-- TARGET UPDATE
--==================================================

local TargetUpdateTimer = 0

local function UpdateTarget()

    local candidates =
        GetCandidates()

    local newTarget =
        SelectTarget(candidates)

    if newTarget then

        if CurrentTarget
            and CurrentTarget.Character
            and IsValidTarget(
                CurrentTarget.Character
            ) then

            local currentDistance =
                CurrentTarget.Distance

            if Settings.TargetMode ==
                "SMART" then

                if newTarget.Distance >
                    currentDistance - 20 then

                    newTarget =
                        CurrentTarget
                end
            end
        end

        if CurrentTarget ~=
            newTarget then

            CurrentTarget =
                newTarget

            if Settings.TargetMode ==
                "LOCK" then

                LockedTarget =
                    newTarget
            end

            ShowTargetVisual(
                CurrentTarget
            )
        end

    else

        if CurrentTarget then

            CurrentTarget = nil
            LockedTarget = nil

            ClearTargetVisual()
        end
    end
end

--==================================================
-- CAMERA FOLLOW
--==================================================

local function UpdateCamera(deltaTime)

    -- Existing TargetLock behavior preserved.
    if not Settings.TargetLock then
        return
    end

    if not CurrentTarget then
        return
    end

    local targetPart =
        GetTargetPart(
            CurrentTarget.Character
        )

    if not targetPart then
        return
    end

    local currentCamera =
        workspace.CurrentCamera

    if not currentCamera then
        return
    end

    local cameraPosition =
        currentCamera.CFrame.Position

    local targetPosition =
        targetPart.Position

    local direction =
        targetPosition -
        cameraPosition

    if direction.Magnitude < 0.01 then
        return
    end

    direction =
        direction.Unit

    local targetCFrame =
        CFrame.lookAt(
            cameraPosition,
            cameraPosition + direction
        )

    local smoothness =
        math.clamp(
            Settings.AimSmoothness,
            0.01,
            1
        )

    local alpha =
        1 -
        math.pow(
            1 - smoothness,
            deltaTime * 60
        )

    currentCamera.CFrame =
        currentCamera.CFrame:Lerp(
            targetCFrame,
            alpha
        )
end

--==================================================
-- RENDER LOOP
--==================================================

RunService:BindToRenderStep(
    "KyzenPerksCameraFollow",
    Enum.RenderPriority.Camera.Value + 1,
    function(deltaTime)

        TargetUpdateTimer +=
            deltaTime

        if TargetUpdateTimer >= 0.08 then

            TargetUpdateTimer = 0

            UpdateTarget()
        end

        UpdateCamera(deltaTime)

    end
)

