local UIScale = Instance.new("UIScale")
UIScale.Parent = Main

local function UpdateScale()

    local viewport = Camera.ViewportSize

    if viewport.X < 500 then

        UIScale.Scale =
            math.clamp(
                viewport.X / 760,
                0.65,
                0.82
            )

    elseif viewport.X < 800 then

        UIScale.Scale =
            math.clamp(
                viewport.X / 850,
                0.78,
                0.95
            )

    else

        UIScale.Scale =
            math.clamp(
                viewport.X / 1100,
                0.84,
                1
            )
    end
end

Camera:GetPropertyChangedSignal(
    "ViewportSize"
):Connect(UpdateScale)

UpdateScale()

