local TabButtons = {}

local function CreateTab(name, text)
    local button = Instance.new("TextButton")

    button.Name = name
    button.Size = UDim2.new(1, 0, 0, 50)
    button.BackgroundColor3 = DARK2
    button.Text = text
    button.TextColor3 = GREY
    button.Font = Enum.Font.GothamBold
    button.TextSize = 11
    button.AutoButtonColor = false
    button.Parent = Tabs

    Corner(button, 9)

    local stroke = Stroke(
        button,
        Color3.fromRGB(42, 48, 60),
        1
    )

    TabButtons[name] = {
        Button = button,
        Stroke = stroke
    }

    return button
end

local AimTab = CreateTab("Aim", "AIM & TARGET")
local SettingsTab = CreateTab("Settings", "SETTINGS")
local InfoTab = CreateTab("Info", "INFO & CREDIT")
local DiscordTab = CreateTab("Discord", "DISCORD")

--==================================================
-- PAGE SWITCH
--==================================================

local function OpenPage(name)
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for buttonName, data in pairs(TabButtons) do
        local active = false

        if name == "AimTarget" and buttonName == "Aim" then
            active = true
        elseif name == "Settings" and buttonName == "Settings" then
            active = true
        elseif name == "InfoCredit" and buttonName == "Info" then
            active = true
        elseif name == "Discord" and buttonName == "Discord" then
            active = true
        end

        if active then
            data.Button.BackgroundColor3 =
                Color3.fromRGB(25, 65, 125)

            data.Button.TextColor3 = WHITE
            data.Stroke.Color = BLUE
            data.Stroke.Thickness = 1.5
        else
            data.Button.BackgroundColor3 = DARK2
            data.Button.TextColor3 = GREY
            data.Stroke.Color =
                Color3.fromRGB(42, 48, 60)

            data.Stroke.Thickness = 1
        end
    end
end

AimTab.MouseButton1Click:Connect(function()
    OpenPage("AimTarget")
end)

SettingsTab.MouseButton1Click:Connect(function()
    OpenPage("Settings")
end)

InfoTab.MouseButton1Click:Connect(function()
    OpenPage("InfoCredit")
end)

DiscordTab.MouseButton1Click:Connect(function()
    OpenPage("Discord")
end)

--==================================================
-- CIRCLE TOGGLE
--==================================================

local function CreateCircleToggle(
    parent,
    title,
    description,
    defaultValue,
    callback
)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 70)
    holder.BackgroundColor3 = DARK2
    holder.BackgroundTransparency = 0
    holder.Parent = parent

    Corner(holder, 10)
    Stroke(
        holder,
        Color3.fromRGB(45, 52, 65),
        1
    )

    local label = MakeLabel(
        holder,
        title,
        UDim2.new(1, -100, 0, 25),
        UDim2.fromOffset(13, 8),
        13
    )

    local desc = MakeLabel(
        holder,
        description,
        UDim2.new(1, -100, 0, 22),
        UDim2.fromOffset(13, 35),
        9
    )

    desc.TextColor3 = GREY

    local outer = Instance.new("TextButton")
    outer.Name = "Toggle"
    outer.Size = UDim2.fromOffset(42, 42)
    outer.Position = UDim2.new(1, -55, 0.5, -21)
    outer.BackgroundColor3 =
        Color3.fromRGB(36, 38, 45)
    outer.Text = ""
    outer.AutoButtonColor = false
    outer.Parent = holder

    Corner(outer, 999)
    Stroke(outer, GREY2, 1)

    local inner = Instance.new("Frame")
    inner.Size = UDim2.fromOffset(20, 20)
    inner.AnchorPoint = Vector2.new(0.5, 0.5)
    inner.Position = UDim2.fromScale(0.5, 0.5)
    inner.BackgroundColor3 = GREY
    inner.Parent = outer

    Corner(inner, 999)

    local state = defaultValue

    local function Update()
        if state then
            Tween(
                outer,
                {
                    BackgroundColor3 =
                        Color3.fromRGB(25, 80, 165)
                },
                0.15
            )

            Tween(
                inner,
                {
                    BackgroundColor3 = BLUE2
                },
                0.15
            )
        else
            Tween(
                outer,
                {
                    BackgroundColor3 =
                        Color3.fromRGB(36, 38, 45)
                },
                0.15
            )

            Tween(
                inner,
                {
                    BackgroundColor3 = GREY
                },
                0.15
            )
        end

        callback(state)
    end

    outer.MouseButton1Click:Connect(function()
        state = not state
        Update()
    end)

    Update()

    return holder
end

--==================================================
-- NUMBER CONTROL
--==================================================

local function CreateNumberControl(
    parent,
    title,
    description,
    value,
    minValue,
    maxValue,
    step,
    callback
)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 78)
    holder.BackgroundColor3 = DARK2
    holder.BackgroundTransparency = 0
    holder.Parent = parent

    Corner(holder, 10)
    Stroke(
        holder,
        Color3.fromRGB(45, 52, 65),
        1
    )

    local label = MakeLabel(
        holder,
        title,
        UDim2.new(1, -185, 0, 25),
        UDim2.fromOffset(13, 8),
        13
    )

    local desc = MakeLabel(
        holder,
        description,
        UDim2.new(1, -185, 0, 22),
        UDim2.fromOffset(13, 38),
        9
    )

    desc.TextColor3 = GREY

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.fromOffset(34, 34)
    minus.Position = UDim2.new(1, -143, 0.5, -17)
    minus.BackgroundColor3 =
        Color3.fromRGB(31, 36, 45)
    minus.Text = "−"
    minus.TextColor3 = WHITE
    minus.TextSize = 19
    minus.Font = Enum.Font.GothamBold
    minus.AutoButtonColor = false
    minus.Parent = holder

    Corner(minus, 8)
    Stroke(minus, BLUE, 1)

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.fromOffset(70, 34)
    valueLabel.Position = UDim2.new(1, -103, 0.5, -17)
    valueLabel.BackgroundColor3 =
        Color3.fromRGB(25, 29, 36)
    valueLabel.TextColor3 = WHITE
    valueLabel.Text = tostring(value)
    valueLabel.TextSize = 12
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.Parent = holder

    Corner(valueLabel, 8)
    Stroke(
        valueLabel,
        Color3.fromRGB(58, 65, 78),
        1
    )

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.fromOffset(34, 34)
    plus.Position = UDim2.new(1, -44, 0.5, -17)
    plus.BackgroundColor3 =
        Color3.fromRGB(31, 36, 45)
    plus.Text = "+"
    plus.TextColor3 = WHITE
    plus.TextSize = 18
    plus.Font = Enum.Font.GothamBold
    plus.AutoButtonColor = false
    plus.Parent = holder

    Corner(plus, 8)
    Stroke(plus, RED, 1)

    local current = value

    local function Update()
        current = math.clamp(
            current,
            minValue,
            maxValue
        )

        valueLabel.Text = tostring(current)

        callback(current)
    end

    minus.MouseButton1Click:Connect(function()
        current -= step
        Update()
    end)

    plus.MouseButton1Click:Connect(function()
        current += step
        Update()
    end)

    return holder
end

