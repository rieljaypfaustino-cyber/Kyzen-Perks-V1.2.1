--==================================================
-- TARGET SYSTEM
--==================================================

local CurrentTarget = nil
local LockedTarget = nil

local TargetHighlight = nil
local TargetBillboard = nil

local function GetCharacterRoot(character)

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
        or character:FindFirstChild(
            "UpperTorso"
        )
        or character:FindFirstChild(
            "Torso"
        )
end

local function IsAlive(character)

    local humanoid =
        character
        and character:FindFirstChildOfClass(
            "Humanoid"
        )

    return humanoid
        and humanoid.Health > 0
end

local function GetTargetPart(character)

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
        or character:FindFirstChild(
            "UpperTorso"
        )
        or character:FindFirstChild(
            "Head"
        )
end

local function IsValidTarget(character)

    if not character then
        return false
    end

    if character ==
        LocalPlayer.Character then

        return false
    end

    if not IsAlive(character) then
        return false
    end

    local root =
        GetCharacterRoot(character)

    if not root then
        return false
    end

    local myCharacter =
        LocalPlayer.Character

    local myRoot =
        GetCharacterRoot(myCharacter)

    if not myRoot then
        return false
    end

    local distance =
        (
            root.Position -
            myRoot.Position
        ).Magnitude

    return distance <=
        Settings.TargetRange
end

local function GetCandidates()

    local candidates = {}

    local myCharacter =
        LocalPlayer.Character

    local myRoot =
        GetCharacterRoot(myCharacter)

    if not myRoot then
        return candidates
    end

    -- PLAYERS
    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local character =
                player.Character

            if IsValidTarget(character) then

                local root =
                    GetCharacterRoot(
                        character
                    )

                if root then

                    table.insert(
                        candidates,
                        {
                            Character = character,
                            Player = player,
                            Root = root,

                            Distance =
                                (
                                    root.Position -
                                    myRoot.Position
                                ).Magnitude
                        }
                    )
                end
            end
        end
    end

    -- NPC / DUMMIES
    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA("Model")
            and object ~= myCharacter
            and not Players:GetPlayerFromCharacter(
                object
            ) then

            local humanoid =
                object:FindFirstChildOfClass(
                    "Humanoid"
                )

            local root =
                GetCharacterRoot(object)

            if humanoid
                and root
                and humanoid.Health > 0 then

                local distance =
                    (
                        root.Position -
                        myRoot.Position
                    ).Magnitude

                if distance <=
                    Settings.TargetRange then

                    table.insert(
                        candidates,
                        {
                            Character = object,
                            Player = nil,
                            Root = root,
                            Distance = distance
                        }
                    )
                end
            end
        end
    end

    return candidates
end

local function FindNearest(candidates)

    local nearest = nil

    for _, target in ipairs(
        candidates
    ) do

        if not nearest
            or target.Distance <
                nearest.Distance then

            nearest = target
        end
    end

    return nearest
end

local function FindSmart(candidates)

    if #candidates == 0 then
        return nil
    end

    local nearest = nil
    local bestScore = math.huge

    for _, target in ipairs(
        candidates
    ) do

        local score =
            target.Distance

        if target == CurrentTarget then
            score -= 30
        end

        if score < bestScore then

            bestScore = score
            nearest = target
        end
    end

    return nearest
end

local function FindLock(candidates)

    if LockedTarget then

        for _, target in ipairs(
            candidates
        ) do

            if target.Character ==
                LockedTarget.Character then

                return target
            end
        end
    end

    return FindNearest(candidates)
end

local function SelectTarget(candidates)

    if #candidates == 0 then
        return nil
    end

    if Settings.TargetMode ==
        "NEAREST" then

        return FindNearest(candidates)

    elseif Settings.TargetMode ==
        "LOCK" then

        return FindLock(candidates)

    else

        return FindSmart(candidates)
    end
end

