--============================================================
-- KYZEN PERKS
-- PRIVATE DEVELOPER TEST SYSTEM
-- V3.0.0
-- OTHER PLAYERS ONLY
--============================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

--============================================================
-- SETTINGS
--============================================================

local Settings = {
	TargetLock = false,
	AimAssist = false,

	AimSmoothness = 0.78,

	FOVDetection = false,
	FOVRadius = 150,

	TargetRange = 500,

	CameraStrength = 1.65,

	-- How quickly Aim Assist can switch targets.
	SwitchSpeed = 0.08,
}

local VERSION = "V3.0.0"

--============================================================
-- TARGET STATE
--============================================================

local CurrentTarget = nil
local LockedTarget = nil

local CurrentHighlight = nil
local CurrentTargetText = nil

local LastSwitch = 0

--============================================================
-- COLORS
--============================================================

local BLACK = Color3.fromRGB(7, 7, 9)
local BG = Color3.fromRGB(11, 11, 14)
local PANEL = Color3.fromRGB(18, 18, 22)
local PANEL2 = Color3.fromRGB(24, 24, 29)

local WHITE = Color3.fromRGB(245, 245, 250)
local GRAY = Color3.fromRGB(160, 160, 170)
local DARK_GRAY = Color3.fromRGB(65, 65, 75)

local BLUE = Color3.fromRGB(70, 145, 255)
local BLUE_DARK = Color3.fromRGB(30, 70, 150)

local RED = Color3.fromRGB(255, 45, 55)

--============================================================
-- UTILITY
--============================================================

local function New(className, props, parent)
	local object = Instance.new(className)

	for property, value in pairs(props or {}) do
		object[property] = value
	end

	object.Parent = parent

	return object
end

local function AddCorner(object, radius)
	return New("UICorner", {
		CornerRadius = UDim.new(0, radius)
	}, object)
end

local function AddStroke(object, color, thickness)
	return New("UIStroke", {
		Color = color,
		Thickness = thickness or 1
	}, object)
end

local function AddGradient(object, c1, c2)
	return New("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, c1),
			ColorSequenceKeypoint.new(1, c2)
		}),
		Rotation = 90
	}, object)
end

local function PlayTween(object, duration, properties)
	return TweenService:Create(
		object,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		properties
	)
end

--============================================================
-- CHARACTER FUNCTIONS
--============================================================

local function GetCharacter(player)
	if not player then
		return nil
	end

	if player == LocalPlayer then
		return nil
	end

	return player.Character
end

local function GetHumanoid(character)
	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function GetRoot(character)
	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function GetHead(character)
	if not character then
		return nil
	end

	return character:FindFirstChild("Head")
end

local function IsAlive(character)
	local humanoid = GetHumanoid(character)
	local root = GetRoot(character)
	local head = GetHead(character)

	if not humanoid then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if not root then
		return false
	end

	if not head then
		return false
	end

	return true
end

--============================================================
-- TARGET VALIDATION
--============================================================

local function IsValidTarget(player)
	if not player then
		return false
	end

	-- NEVER TARGET SELF
	if player == LocalPlayer then
		return false
	end

	local character = player.Character

	if not character then
		return false
	end

	if not IsAlive(character) then
		return false
	end

	local myCharacter = LocalPlayer.Character

	if not myCharacter then
		return false
	end

	local myRoot = GetRoot(myCharacter)
	local targetRoot = GetRoot(character)

	if not myRoot or not targetRoot then
		return false
	end

	local distance =
		(targetRoot.Position - myRoot.Position).Magnitude

	if distance > Settings.TargetRange then
		return false
	end

	return true
end

--============================================================
-- GET ALL OTHER PLAYERS
--============================================================

local function GetTargets()
	local targets = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if IsValidTarget(player) then
				table.insert(targets, player)
			end
		end
	end

	return targets
end

--============================================================
-- 3D TARGET ANGLE
--============================================================

local function GetAngleFromCamera(player)
	local camera = workspace.CurrentCamera

	if not camera then
		return math.huge
	end

	local character = GetCharacter(player)
	local head = GetHead(character)

	if not head then
		return math.huge
	end

	local direction =
		(head.Position - camera.CFrame.Position).Unit

	local dot =
		math.clamp(
			camera.CFrame.LookVector:Dot(direction),
			-1,
			1
		)

	return math.acos(dot)
end

--============================================================
-- DISTANCE
--============================================================

local function GetDistance(player)
	local myCharacter = LocalPlayer.Character
	local targetCharacter = GetCharacter(player)

	local myRoot = GetRoot(myCharacter)
	local targetRoot = GetRoot(targetCharacter)

	if not myRoot or not targetRoot then
		return math.huge
	end

	return (
		targetRoot.Position
		- myRoot.Position
	).Magnitude
end

--============================================================
-- FOV DISTANCE
--============================================================

local function GetScreenDistance(player)
	local camera = workspace.CurrentCamera

	if not camera then
		return math.huge
	end

	local character = GetCharacter(player)
	local head = GetHead(character)

	if not head then
		return math.huge
	end

	local point =
		camera:WorldToViewportPoint(
			head.Position
		)

	local center =
		Vector2.new(
			camera.ViewportSize.X / 2,
			camera.ViewportSize.Y / 2
		)

	return (
		Vector2.new(
			point.X,
			point.Y
		) - center
	).Magnitude
end

--============================================================
-- FIND NEAREST PLAYER
--============================================================

local function FindNearest()
	local best = nil
	local bestDistance = math.huge

	for _, player in ipairs(GetTargets()) do
		local distance = GetDistance(player)

		if distance < bestDistance then
			bestDistance = distance
			best = player
		end
	end

	return best
end

--============================================================
-- FIND SMART TARGET
--============================================================

local function FindSmart()
	local candidates = GetTargets()

	if #candidates == 0 then
		return nil
	end

	local best = nil
	local bestScore = math.huge

	for _, player in ipairs(candidates) do
		local distance = GetDistance(player)
		local angle = GetAngleFromCamera(player)

		local score

		if Settings.FOVDetection then

			local screenDistance =
				GetScreenDistance(player)

			-- Players inside the FOV receive a
			-- strong priority, but players outside
			-- remain valid for 360-degree targeting.

			if screenDistance <= Settings.FOVRadius then
				score =
					screenDistance
					+ (distance * 0.02)
			else
				score =
					500
					+ screenDistance
					+ (distance * 0.02)
			end

		else

			-- TRUE 360° mode:
			-- camera direction is NOT required.
			-- nearest player is prioritized.

			score =
				distance
				+ (angle * 15)

		end

		if score < bestScore then
			bestScore = score
			best = player
		end
	end

	return best
end

--============================================================
-- REMOVE VISUALS
--============================================================

local function RemoveTargetVisuals()

	if CurrentHighlight then
		pcall(function()
			CurrentHighlight:Destroy()
		end)

		CurrentHighlight = nil
	end

	if CurrentTargetText then
		pcall(function()
			CurrentTargetText:Destroy()
		end)

		CurrentTargetText = nil
	end
end

--============================================================
-- RED CHARACTER HIGHLIGHT
--============================================================

local function CreateTargetHighlight(player)
	local character = GetCharacter(player)

	if not character then
		return
	end

	local highlight =
		Instance.new("Highlight")

	highlight.Name =
		"KyzenTargetHighlight"

	highlight.Adornee =
		character

	-- VISIBLE THROUGH WALLS
	highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	highlight.FillColor = RED

	highlight.OutlineColor = WHITE

	highlight.FillTransparency = 0.50

	highlight.OutlineTransparency = 0

	highlight.Parent =
		character

	CurrentHighlight = highlight
end

--============================================================
-- TARGET TEXT ABOVE HEAD
--============================================================

local function CreateTargetText(player)
	local character = GetCharacter(player)

	if not character then
		return
	end

	local head = GetHead(character)

	if not head then
		return
	end

	local billboard =
		Instance.new("BillboardGui")

	billboard.Name =
		"KyzenTargetText"

	billboard.Adornee =
		head

	billboard.Size =
		UDim2.fromOffset(240, 60)

	billboard.StudsOffset =
		Vector3.new(0, 3.5, 0)

	billboard.AlwaysOnTop = true

	billboard.MaxDistance = 10000

	billboard.Parent =
		head

	local targetLabel =
		Instance.new("TextLabel")

	targetLabel.BackgroundTransparency = 1

	targetLabel.Size =
		UDim2.new(1, 0, 0, 25)

	targetLabel.Text =
		"TARGET"

	targetLabel.TextColor3 =
		RED

	targetLabel.TextStrokeColor3 =
		Color3.new(0, 0, 0)

	targetLabel.TextStrokeTransparency = 0

	targetLabel.Font =
		Enum.Font.GothamBlack

	targetLabel.TextSize = 17

	targetLabel.Parent =
		billboard

	local nameLabel =
		Instance.new("TextLabel")

	nameLabel.BackgroundTransparency = 1

	nameLabel.Position =
		UDim2.fromOffset(0, 26)

	nameLabel.Size =
		UDim2.new(1, 0, 0, 25)

	nameLabel.Text =
		player.DisplayName
		.. "  @"
		.. player.Name

	nameLabel.TextColor3 =
		WHITE

	nameLabel.TextStrokeColor3 =
		Color3.new(0, 0, 0)

	nameLabel.TextStrokeTransparency = 0

	nameLabel.Font =
		Enum.Font.GothamBold

	nameLabel.TextSize = 13

	nameLabel.Parent =
		billboard

	CurrentTargetText =
		billboard
end

--============================================================
-- APPLY TARGET VISUALS
--============================================================

local function ApplyTargetVisuals()

	RemoveTargetVisuals()

	if not CurrentTarget then
		return
	end

	if CurrentTarget == LocalPlayer then
		return
	end

	if not IsValidTarget(CurrentTarget) then
		return
	end

	-- AUTOMATIC - NO ESP TOGGLES
	CreateTargetHighlight(CurrentTarget)
	CreateTargetText(CurrentTarget)
end

--============================================================
-- SET TARGET
--============================================================

local function SetTarget(player)

	if player == LocalPlayer then
		return
	end

	if player and not IsValidTarget(player) then
		return
	end

	if CurrentTarget == player then
		return
	end

	CurrentTarget = player

	ApplyTargetVisuals()
end

--============================================================
-- TARGET LOCK ACQUISITION
--============================================================

local function AcquireTarget()

	if LockedTarget
		and IsValidTarget(LockedTarget) then

		return LockedTarget
	end

	local target =
		FindSmart()

	if target
		and target ~= LocalPlayer then

		LockedTarget = target

		return target
	end

	return nil
end

--============================================================
-- AIM ASSIST TARGET
--============================================================

local function AcquireAimAssistTarget()

	local now = os.clock()

	if now - LastSwitch < Settings.SwitchSpeed then
		return CurrentTarget
	end

	local target =
		FindSmart()

	if not target then
		return nil
	end

	LastSwitch = now

	return target
end

--============================================================
-- UPDATE TARGET SYSTEM
--============================================================

local function UpdateTargetSystem()

	if not Settings.TargetLock
		and not Settings.AimAssist then

		if CurrentTarget then
			CurrentTarget = nil
			LockedTarget = nil
			RemoveTargetVisuals()
		end

		return
	end

	--========================================================
	-- TARGET LOCK
	--========================================================

	if Settings.TargetLock then

		local target =
			AcquireTarget()

		if target then
			SetTarget(target)
			return
		end
	end

	--========================================================
	-- AIM ASSIST
	--========================================================

	if Settings.AimAssist then

		local target =
			AcquireAimAssistTarget()

		if target then
			SetTarget(target)
			return
		end
	end

end

--============================================================
-- CAMERA LOCK
--============================================================

local function UpdateCamera(deltaTime)

	if not Settings.TargetLock
		and not Settings.AimAssist then

		return
	end

	local target =
		CurrentTarget

	if not target then
		return
	end

	if target == LocalPlayer then

		CurrentTarget = nil
		LockedTarget = nil
		RemoveTargetVisuals()

		return
	end

	if not IsValidTarget(target) then

		if LockedTarget == target then
			LockedTarget = nil
		end

		SetTarget(nil)

		return
	end

	local character =
		GetCharacter(target)

	local head =
		GetHead(character)

	if not head then
		return
	end

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	--========================================================
	-- CAMERA ALWAYS LOOKS AT TARGET HEAD
	--========================================================

	local cameraPosition =
		camera.CFrame.Position

	local targetPosition =
		head.Position

	local desired =
		CFrame.lookAt(
			cameraPosition,
			targetPosition
		)

	-- FAST + SMOOTH
	local strength =
		math.clamp(
			Settings.AimSmoothness
			* Settings.CameraStrength
			* 18,
			3,
			35
		)

	local alpha =
		1 - math.exp(
			-strength
			* math.max(
				deltaTime,
				1 / 240
			)
		)

	camera.CFrame =
		camera.CFrame:Lerp(
			desired,
			alpha
		)
end

--============================================================
-- GUI
--============================================================

local ScreenGui =
	New("ScreenGui", {
		Name = "KyzenPerks",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior =
			Enum.ZIndexBehavior.Sibling
	}, PlayerGui)

--============================================================
-- SCALE
--============================================================

local UIScale =
	New("UIScale", {
		Scale = 1
	}, ScreenGui)

local function UpdateScale()

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport =
		camera.ViewportSize

	local scaleX =
		viewport.X / 900

	local scaleY =
		viewport.Y / 650

	local scale =
		math.min(
			scaleX,
			scaleY
		)

	UIScale.Scale =
		math.clamp(
			scale,
			0.68,
			1.05
		)
end

UpdateScale()

workspace.CurrentCamera:
	GetPropertyChangedSignal("ViewportSize"):
	Connect(UpdateScale)

