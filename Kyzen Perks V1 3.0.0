--============================================================
-- OPEN / CLOSE
--============================================================

local MenuOpen = true

local function OpenMenu()

	MenuOpen = true

	Main.Visible = true

	Main.Size =
		UDim2.fromOffset(
			640,
			430
		)

	PlayTween(
		Main,
		0.18,
		{
			Size =
				UDim2.fromOffset(
					700,
					470
				)
		}
	):Play()
end

local function CloseMenu()

	MenuOpen = false

	PlayTween(
		Main,
		0.16,
		{
			Size =
				UDim2.fromOffset(
					640,
					430
				)
		}
	):Play()

	task.delay(
		0.16,
		function()

			if not MenuOpen then
				Main.Visible = false
			end

		end
	)
end

DevButton.MouseButton1Click:Connect(
	function()

		if MenuOpen then
			CloseMenu()
		else
			OpenMenu()
		end

	end
)

Close.MouseButton1Click:Connect(
	function()
		CloseMenu()
	end
)

--============================================================
-- PLAYER REMOVAL
--============================================================

Players.PlayerRemoving:Connect(
	function(player)

		if player == CurrentTarget
			or player == LockedTarget then

			CurrentTarget = nil
			LockedTarget = nil

			RemoveTargetVisuals()
		end
	end
)

--============================================================
-- LOCAL PLAYER RESPAWN
--============================================================

LocalPlayer.CharacterAdded:Connect(
	function()

		CurrentTarget = nil
		LockedTarget = nil

		RemoveTargetVisuals()
	end
)

--============================================================
-- TARGET LOOP
--============================================================

task.spawn(
	function()

		while ScreenGui.Parent do

			UpdateTargetSystem()

			task.wait(0.025)

		end
	end
)

--============================================================
-- CAMERA LOOP
--============================================================

RunService:BindToRenderStep(
	"KyzenPerksCamera",

	Enum.RenderPriority.Camera.Value + 100,

	function(deltaTime)

		if not ScreenGui.Parent then
			return
		end

		UpdateCamera(deltaTime)
	end
)

--============================================================
-- VISUAL SAFETY LOOP
--============================================================

task.spawn(
	function()

		while ScreenGui.Parent do

			if CurrentTarget then

				if CurrentTarget == LocalPlayer then

					CurrentTarget = nil
					LockedTarget = nil

					RemoveTargetVisuals()

				elseif not IsValidTarget(
					CurrentTarget
				) then

					if LockedTarget ==
						CurrentTarget then

						LockedTarget = nil
					end

					SetTarget(nil)

				else

					if not CurrentHighlight then
						ApplyTargetVisuals()
					end

					if not CurrentTargetText then
						ApplyTargetVisuals()
					end
				end
			end

			task.wait(0.10)
		end
	end
)

--============================================================
-- INITIALIZE
--============================================================

UpdateFOV()

ShowPage("Aim")

print(
	"[Kyzen Perks "
	.. VERSION
	.. "] Loaded | Other Players Only | Head Target"
)
