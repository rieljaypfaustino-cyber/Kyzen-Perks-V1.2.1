--============================================================
-- PAGES
--============================================================

local Pages = {}

local function CreatePage(name)

	local page =
		New("Frame", {

			Name = name,

			Size =
				UDim2.fromScale(
					1,
					1
				),

			BackgroundTransparency = 1,

			Visible = false,

			ZIndex = 12

		}, Content)

	Pages[name] = page

	return page
end

local AimPage =
	CreatePage("Aim")

local SettingsPage =
	CreatePage("Settings")

local InfoPage =
	CreatePage("Info")

--============================================================
-- PAGE SWITCHING
--============================================================

local function ShowPage(name)

	for pageName, page in pairs(Pages) do
		page.Visible =
			pageName == name
	end

	for _, object in ipairs(
		Sidebar:GetChildren()
	) do

		if object:IsA("TextButton") then

			if object:GetAttribute("Page")
				== name then

				object.BackgroundColor3 =
					Color3.fromRGB(
						35,
						75,
						125
					)

				object.TextColor3 =
					WHITE

			else

				object.BackgroundColor3 =
					Color3.fromRGB(
						25,
						25,
						30
					)

				object.TextColor3 =
					GRAY
			end
		end
	end
end

local function CreateTab(
	text,
	y,
	page
)

	local button =
		New("TextButton", {

			Position =
				UDim2.fromOffset(
					10,
					y
				),

			Size =
				UDim2.new(
					1,
					-20,
					0,
					48
				),

			BackgroundColor3 =
				Color3.fromRGB(
					25,
					25,
					30
				),

			Text = text,

			TextColor3 =
				GRAY,

			Font =
				Enum.Font.GothamBold,

			TextSize = 11,

			AutoButtonColor = false,

			ZIndex = 13

		}, Sidebar)

	button:SetAttribute(
		"Page",
		page
	)

	AddCorner(button, 9)

	button.MouseButton1Click:Connect(
		function()
			ShowPage(page)
		end
	)
end

CreateTab(
	"AIM & TARGET",
	12,
	"Aim"
)

