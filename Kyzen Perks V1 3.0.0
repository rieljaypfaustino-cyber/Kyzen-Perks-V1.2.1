--============================================================
-- TOGGLE CREATOR
--============================================================

local function CreateToggle(
	parent,
	text,
	y,
	getValue,
	setValue
)

	local holder =
		New("Frame", {

			Position =
				UDim2.fromOffset(
					20,
					y
				),

			Size =
				UDim2.new(
					1,
					-40,
					0,
					55
				),

			BackgroundColor3 =
				PANEL2,

			BorderSizePixel = 0,

			ZIndex = 13

		}, parent)

	AddCorner(holder, 10)

	AddStroke(
		holder,
		Color3.fromRGB(
			45,
			45,
			55
		),
		1
	)

	New("TextLabel", {

		Position =
			UDim2.fromOffset(
				14,
				0
			),

		Size =
			UDim2.new(
				1,
				-90,
				1,
				0
			),

		BackgroundTransparency = 1,

		Text = text,

		TextColor3 =
			WHITE,

		Font =
			Enum.Font.GothamBold,

		TextSize = 12,

		TextXAlignment =
			Enum.TextXAlignment.Left,

		ZIndex = 14

	}, holder)

	local button =
		New("TextButton", {

			Position =
				UDim2.new(
					1,
					-65,
					0.5,
					-14
				),

			Size =
				UDim2.fromOffset(
					50,
					28
				),

			BackgroundColor3 =
				DARK_GRAY,

			Text = "",

			AutoButtonColor = false,

			ZIndex = 15

		}, holder)

	AddCorner(
		button,
		999
	)

	local knob =
		New("Frame", {

			Position =
				UDim2.fromOffset(
					3,
					3
				),

			Size =
				UDim2.fromOffset(
					22,
					22
				),

			BackgroundColor3 =
				WHITE,

			BorderSizePixel = 0,

			ZIndex = 16

		}, button)

	AddCorner(
		knob,
		999
	)

	local function Refresh()

		if getValue() then

			PlayTween(
				button,
				0.12,
				{
					BackgroundColor3 =
						BLUE
				}
			):Play()

			PlayTween(
				knob,
				0.12,
				{
					Position =
						UDim2.new(
							1,
							-25,
							0,
							3
						)
				}
			):Play()

		else

			PlayTween(
				button,
				0.12,
				{
					BackgroundColor3 =
						DARK_GRAY
				}
			):Play()

			PlayTween(
				knob,
				0.12,
				{
					Position =
						UDim2.fromOffset(
							3,
							3
						)
				}
			):Play()

		end
	end

	button.MouseButton1Click:Connect(
		function()

			setValue(
				not getValue()
			)

			Refresh()

			UpdateTargetSystem()

		end
	)

	Refresh()
end

