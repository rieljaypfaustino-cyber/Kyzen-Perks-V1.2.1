	New("TextButton", {

		Position =
			UDim2.fromOffset(
				0,
				-10
			),

		Size =
			UDim2.new(
				1,
				0,
				1,
				20
			),

		BackgroundTransparency = 1,

		Text = "",

		AutoButtonColor = false,

		ZIndex = 20

	}, FOVBar)

local fovDragging = false

local function UpdateFOVFromInput(x)

	local relative =
		math.clamp(
			(
				x
				- FOVBar.AbsolutePosition.X
			)
			/ FOVBar.AbsoluteSize.X,
			0,
			1
		)

	local value =
		math.floor(
			50
			+ (
				relative
				* 350
			)
		)

	Settings.FOVRadius =
		value

	FOVValue.Text =
		tostring(value)

	FOVFill.Size =
		UDim2.fromScale(
			relative,
			1
		)

	UpdateFOV()
end

FOVButton.InputBegan:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			fovDragging = true

			UpdateFOVFromInput(
				input.Position.X
			)
		end
	end
)

UserInputService.InputChanged:Connect(
	function(input)

		if not fovDragging then
			return
		end

		if input.UserInputType ==
			Enum.UserInputType.MouseMovement
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			UpdateFOVFromInput(
				input.Position.X
			)
		end
	end
)

UserInputService.InputEnded:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			fovDragging = false
		end
	end
)

