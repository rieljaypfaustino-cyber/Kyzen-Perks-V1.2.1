-- AIM PAGE
--============================================================

CreateToggle(
	AimPage,
	"TARGET LOCK",
	82,

	function()
		return Settings.TargetLock
	end,

	function(value)

		Settings.TargetLock =
			value

		if value then

			Settings.AimAssist = false

			LockedTarget =
				FindSmart()

			if LockedTarget then
				SetTarget(
					LockedTarget
				)
			end

		else

			LockedTarget = nil

			if not Settings.AimAssist then
				SetTarget(nil)
			end
		end
	end
)

CreateToggle(
	AimPage,
	"AIM ASSIST",
	145,

	function()
		return Settings.AimAssist
	end,

	function(value)

		Settings.AimAssist =
			value

		if value then

			Settings.TargetLock = false
			LockedTarget = nil

			local target =
				FindSmart()

			if target then
				SetTarget(target)
			end

		elseif not Settings.TargetLock then

			SetTarget(nil)

		end
	end
)

