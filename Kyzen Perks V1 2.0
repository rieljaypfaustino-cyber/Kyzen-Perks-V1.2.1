--============================================================
-- OPEN / CLOSE
--============================================================

local Open = true

local function OpenMenu()

	Open = true

	Main.Visible = true

	Main.Size =
		UDim2.fromOffset(
			650,
			430
		)

	Tween(
		Main,
		0.18,
		{
			Size =
				UDim2.fromOffset(
					700,
					470
				)
		}
	):Play()

end

local function CloseMenu()

	Open = false

	Tween(
		Main,
		0.16,
		{
			Size =
				UDim2.fromOffset(
					650,
					430
				)
		}
	):Play()

	task.delay(
		0.16,
		function()

			if not Open then
				Main.Visible = false
			end

		end
	)

end

DevButton.MouseButton1Click:Connect(
	function()

		if Open then
			CloseMenu()
		else
			OpenMenu()
		end

	end
)

Close.MouseButton1Click:Connect(
	function()
		CloseMenu()
	end
)

--============================================================
-- PLAYER REMOVAL
--============================================================

Players.PlayerRemoving:Connect(
	function(player)

		if player == CurrentTarget
			or player == LockedTarget then

			CurrentTarget = nil
			LockedTarget = nil

			RemoveTargetVisuals()

		end

	end
)

--============================================================
-- LOCALPLAYER RESPAWN
--============================================================

LocalPlayer.CharacterAdded:Connect(
	function()

		CurrentTarget = nil
		LockedTarget = nil

		RemoveTargetVisuals()

	end
)

--============================================================
-- TARGET LOOP
--============================================================

task.spawn(
	function()

		while ScreenGui.Parent do

			UpdateTarget()

			task.wait(0.02)

		end

	end
)

--============================================================
-- CAMERA LOOP
--============================================================

RunService:BindToRenderStep(
	"KyzenPerks_TargetCamera",

	Enum.RenderPriority.Camera.Value + 100,

	function(deltaTime)

		if not ScreenGui.Parent then
			return
		end

		UpdateCamera(deltaTime)

	end
)

--============================================================
-- VISUAL SAFETY
--============================================================

task.spawn(
	function()

		while ScreenGui.Parent do

			if CurrentTarget then

				if CurrentTarget == LocalPlayer then

					CurrentTarget = nil
					LockedTarget = nil

					RemoveTargetVisuals()

				elseif not IsValidTarget(
					CurrentTarget
				) then

					if LockedTarget ==
						CurrentTarget then

						LockedTarget = nil

					end

					SetTarget(nil)

				else

					-- Rebuild highlight if it disappeared.
					if not CurrentHighlight then
						UpdateTargetVisuals()
					end

					-- Rebuild text if it disappeared.
					if not CurrentBillboard then
						UpdateTargetVisuals()
					end

				end

			end

			task.wait(0.10)

		end

	end
)

--============================================================
-- INITIALIZE
--============================================================

UpdateFOV()

ShowPage("AimTarget")

print(
	"[Kyzen Perks] "
	.. VERSION
	.. " loaded - OTHER PLAYERS ONLY"
)
