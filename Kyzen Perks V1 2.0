--============================================================
-- PAGES
--============================================================

local Pages = {}

local function CreatePage(name)

	local page = New("Frame", {

		Name = name,

		Size =
			UDim2.fromScale(1, 1),

		BackgroundTransparency = 1,

		Visible = false,

		ZIndex = 12

	}, Content)

	Pages[name] = page

	return page
end

local AimPage =
	CreatePage("AimTarget")

local SettingsPage =
	CreatePage("Settings")

local InfoPage =
	CreatePage("Info")

--============================================================
-- TABS
--============================================================

local function ShowPage(name)

	for pageName, page in pairs(Pages) do

		page.Visible =
			pageName == name

	end

	for _, button in ipairs(
		Sidebar:GetChildren()
	) do

		if button:IsA("TextButton") then

			if button:GetAttribute(
				"Page"
			) == name then

				button.BackgroundColor3 =
					Color3.fromRGB(
						35,
						75,
						125
					)

				button.TextColor3 =
					C.White

			else

				button.BackgroundColor3 =
					Color3.fromRGB(
						25,
						25,
						30
					)

				button.TextColor3 =
					C.Gray
			end
		end
	end
end

local function Tab(text, y, page)

	local button = New("TextButton", {

		Position =
			UDim2.fromOffset(
				10,
				y
			),

		Size =
			UDim2.new(
				1,
				-20,
				0,
				48
			),

		BackgroundColor3 =
			Color3.fromRGB(
				25,
				25,
				30
			),

		Text = text,

		TextColor3 =
			C.Gray,

		Font =
			Enum.Font.GothamBold,

		TextSize = 11,

		AutoButtonColor = false,

		ZIndex = 12

	}, Sidebar)

	button:SetAttribute(
		"Page",
		page
	)

	Corner(button, 9)

	button.MouseButton1Click:Connect(
		function()

			ShowPage(page)

		end
	)

end

Tab(
	"AIM & TARGET",
	12,
	"AimTarget"
)

Tab(
	"SETTINGS",
	68,
	"Settings"
)

Tab(
	"INFO & CREDIT",
	124,
	"Info"
)

