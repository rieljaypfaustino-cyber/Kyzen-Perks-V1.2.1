-- KYZEN PERKS
-- PRIVATE DEVELOPER TEST SYSTEM
-- V2.2.0
-- OTHER PLAYERS ONLY
-- NO AUTO SHOOT
--============================================================

--============================================================
-- SERVICES
--============================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

--============================================================
-- SETTINGS
--============================================================

local Settings = {
	TargetLock = false,
	AimAssist = false,

	AimSmoothness = 0.72,

	FOVDetection = false,
	FOVRadius = 145,

	TargetRange = 500,

	TargetMode = "SMART",

	CameraStrength = 1.35,
}

local VERSION = "V2.2.0"

--============================================================
-- TARGET STATE
--============================================================

local CurrentTarget = nil
local LockedTarget = nil

local CurrentHighlight = nil
local CurrentBillboard = nil

--============================================================
-- COLORS
--============================================================

local C = {
	Black = Color3.fromRGB(7, 7, 9),
	Background = Color3.fromRGB(11, 11, 14),

	Panel = Color3.fromRGB(17, 17, 21),
	Panel2 = Color3.fromRGB(22, 22, 27),

	White = Color3.fromRGB(245, 245, 250),
	Gray = Color3.fromRGB(160, 160, 170),
	DarkGray = Color3.fromRGB(65, 65, 75),

	Blue = Color3.fromRGB(70, 145, 255),
	Blue2 = Color3.fromRGB(30, 75, 160),

	Red = Color3.fromRGB(255, 55, 65),
	Red2 = Color3.fromRGB(155, 25, 35),

	Green = Color3.fromRGB(70, 220, 125)
}

--============================================================
-- UTILITY
--============================================================

local function New(className, properties, parent)

	local object = Instance.new(className)

	for property, value in pairs(properties or {}) do
		object[property] = value
	end

	if parent then
		object.Parent = parent
	end

	return object
end

local function Corner(object, radius)

	return New("UICorner", {
		CornerRadius = UDim.new(0, radius)
	}, object)
end

local function Stroke(object, color, thickness, transparency)

	return New("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0
	}, object)
end

local function Gradient(object, color1, color2, rotation)

	return New("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, color1),
			ColorSequenceKeypoint.new(1, color2)
		}),
		Rotation = rotation or 0
	}, object)
end

local function Tween(object, duration, properties)

	return TweenService:Create(
		object,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		properties
	)

end

--============================================================
-- CHARACTER
--============================================================

local function GetCharacter(player)

	if not player then
		return nil
	end

	if player == LocalPlayer then
		return nil
	end

	return player.Character
end

local function GetHumanoid(character)

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function GetRoot(character)

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
end

local function GetHead(character)

	if not character then
		return nil
	end

	return character:FindFirstChild("Head")
end

local function IsAlive(character)

	if not character then
		return false
	end

	local humanoid = GetHumanoid(character)
	local root = GetRoot(character)
	local head = GetHead(character)

	if not humanoid then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if not root then
		return false
	end

	if not head then
		return false
	end

	return true
end

--============================================================
-- DISTANCE VALIDATION
--============================================================

local function IsValidTarget(player)

	-- NEVER TARGET LOCAL PLAYER
	if not player or player == LocalPlayer then
		return false
	end

	local character = GetCharacter(player)

	if not character then
		return false
	end

	if not IsAlive(character) then
		return false
	end

	local myCharacter = LocalPlayer.Character

	if not myCharacter then
		return false
	end

	local myRoot = GetRoot(myCharacter)
	local targetRoot = GetRoot(character)

	if not myRoot or not targetRoot then
		return false
	end

	local distance =
		(targetRoot.Position - myRoot.Position).Magnitude

	if distance > Settings.TargetRange then
		return false
	end

	return true
end

--============================================================
-- FOV CALCULATION
--============================================================

local function GetScreenDistance(player)

	local character = GetCharacter(player)
	local head = GetHead(character)

	if not head then
		return math.huge, false
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return math.huge, false
	end

	local point, visible =
		camera:WorldToViewportPoint(head.Position)

	local viewport = camera.ViewportSize

	local center = Vector2.new(
		viewport.X * 0.5,
		viewport.Y * 0.5
	)

	local screenPoint = Vector2.new(
		point.X,
		point.Y
	)

	return (screenPoint - center).Magnitude, visible
end

--============================================================
-- CANDIDATES
--============================================================

local function GetOtherPlayers()

	local list = {}

	for _, player in ipairs(Players:GetPlayers()) do

		-- VERY IMPORTANT:
		-- LOCAL PLAYER IS NEVER INSERTED
		if player ~= LocalPlayer then

			if IsValidTarget(player) then
				table.insert(list, player)
			end

		end
	end

	return list
end

--============================================================
-- NEAREST
--============================================================

local function FindNearest()

	local myCharacter = LocalPlayer.Character
	local myRoot = GetRoot(myCharacter)

	if not myRoot then
		return nil
	end

	local best = nil
	local bestDistance = math.huge

	for _, player in ipairs(GetOtherPlayers()) do

		local character = GetCharacter(player)
		local root = GetRoot(character)

		if root then

			local distance =
				(root.Position - myRoot.Position).Magnitude

			if distance < bestDistance then

				bestDistance = distance
				best = player

			end
		end
	end

	return best
end

--============================================================
-- SMART 360 TARGET
--============================================================

local function FindSmart()

	local camera = workspace.CurrentCamera

	if not camera then
		return FindNearest()
	end

	local myCharacter = LocalPlayer.Character
	local myRoot = GetRoot(myCharacter)

	if not myRoot then
		return nil
	end

	local bestPlayer = nil
	local bestScore = math.huge

	for _, player in ipairs(GetOtherPlayers()) do

		local character = GetCharacter(player)
		local head = GetHead(character)
		local root = GetRoot(character)

		if head and root then

			local worldDistance =
				(root.Position - myRoot.Position).Magnitude

			local screenDistance, onScreen =
				GetScreenDistance(player)

			--================================================
			-- FOV ON:
			-- Screen center gets priority,
			-- BUT 360 DEGREE CANDIDATES STILL EXIST.
			--================================================

			if Settings.FOVDetection then

				local fovScore

				if onScreen then

					fovScore =
						screenDistance
						+ (worldDistance * 0.04)

				else

					-- Outside camera still remains selectable.
					fovScore =
						Settings.FOVRadius
						+ 250
						+ (worldDistance * 0.04)

				end

				-- If the player is inside FOV,
				-- strongly prioritize them.

				if screenDistance <= Settings.FOVRadius then

					fovScore =
						fovScore * 0.20

				end

				if fovScore < bestScore then

					bestScore = fovScore
					bestPlayer = player

				end

			else

				--================================================
				-- FOV OFF = PURE 360 DEGREE TARGETING
				--================================================

				local score =
					worldDistance

				if score < bestScore then

					bestScore = score
					bestPlayer = player

				end

			end
		end
	end

	return bestPlayer
end

--============================================================
-- TARGET MODE
--============================================================

local function ChooseTarget()

	if Settings.TargetMode == "NEAREST" then
		return FindNearest()
	end

	if Settings.TargetMode == "LOCK" then

		if LockedTarget
			and IsValidTarget(LockedTarget) then

			return LockedTarget

		end

		return FindSmart()
	end

	return FindSmart()
end

--============================================================
-- REMOVE VISUALS
--============================================================

local function RemoveTargetVisuals()

	if CurrentHighlight then

		pcall(function()
			CurrentHighlight:Destroy()
		end)

		CurrentHighlight = nil

	end

	if CurrentBillboard then

		pcall(function()
			CurrentBillboard:Destroy()
		end)

		CurrentBillboard = nil

	end
end

--============================================================
-- HIGHLIGHT
--============================================================

local function CreateHighlight(player)

	if not player then
		return
	end

	local character = GetCharacter(player)

	if not character then
		return
	end

	local highlight = Instance.new("Highlight")

	highlight.Name = "KyzenTargetHighlight"

	highlight.Adornee = character

	-- ALWAYS VISIBLE THROUGH WALLS
	highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	highlight.FillColor = C.Red
	highlight.OutlineColor = C.White

	highlight.FillTransparency = 0.58
	highlight.OutlineTransparency = 0

	highlight.Parent = character

	CurrentHighlight = highlight
end

--============================================================
-- TARGET TEXT
--============================================================

local function CreateTargetText(player)

	if not player then
		return
	end

	local character = GetCharacter(player)

	if not character then
		return
	end

	local head = GetHead(character)

	if not head then
		return
	end

	local billboard = Instance.new("BillboardGui")

	billboard.Name = "KyzenTargetText"

	billboard.Adornee = head

	billboard.Size =
		UDim2.fromOffset(250, 65)

	billboard.StudsOffset =
		Vector3.new(0, 3.4, 0)

	billboard.AlwaysOnTop = true

	billboard.MaxDistance = 10000

	billboard.Parent = head

	local holder = Instance.new("Frame")

	holder.Size = UDim2.fromScale(1, 1)

	holder.BackgroundTransparency = 1

	holder.Parent = billboard

	local targetText = Instance.new("TextLabel")

	targetText.Size =
		UDim2.new(1, 0, 0, 25)

	targetText.Position =
		UDim2.fromOffset(0, 0)

	targetText.BackgroundTransparency = 1

	targetText.Text = "TARGET"

	targetText.TextColor3 = C.Red

	targetText.TextStrokeColor3 =
		Color3.new(0, 0, 0)

	targetText.TextStrokeTransparency = 0

	targetText.Font =
		Enum.Font.GothamBlack

	targetText.TextSize = 16

	targetText.Parent = holder

	local nameText = Instance.new("TextLabel")

	nameText.Size =
		UDim2.new(1, 0, 0, 30)

	nameText.Position =
		UDim2.fromOffset(0, 27)

	nameText.BackgroundTransparency = 1

	nameText.Text =
		player.DisplayName
		.. "  @"
		.. player.Name

	nameText.TextColor3 = C.White

	nameText.TextStrokeColor3 =
		Color3.new(0, 0, 0)

	nameText.TextStrokeTransparency = 0

	nameText.Font =
		Enum.Font.GothamBold

	nameText.TextSize = 13

	nameText.Parent = holder

	CurrentBillboard = billboard
end

--============================================================
-- UPDATE VISUALS
--============================================================

local function UpdateTargetVisuals()

	RemoveTargetVisuals()

	if not CurrentTarget then
		return
	end

	if CurrentTarget == LocalPlayer then
		return
	end

	if not IsValidTarget(CurrentTarget) then
		return
	end

	-- ALWAYS CREATE
	CreateHighlight(CurrentTarget)
	CreateTargetText(CurrentTarget)
end

--============================================================
-- SET TARGET
--============================================================

local function SetTarget(player)

	-- NEVER ACCEPT SELF
	if player == LocalPlayer then
		player = nil
	end

	if player and not IsValidTarget(player) then
		player = nil
	end

	if CurrentTarget == player then
		return
	end

	CurrentTarget = player

	UpdateTargetVisuals()
end

--============================================================
-- TARGET UPDATE
--============================================================

local function UpdateTarget()

	local active =
		Settings.TargetLock
		or Settings.AimAssist

	if not active then

		SetTarget(nil)

		return
	end

	--========================================================
	-- TARGET LOCK
	--========================================================

	if Settings.TargetLock then

		if LockedTarget
			and IsValidTarget(LockedTarget) then

			SetTarget(LockedTarget)

			return
		end

		local newTarget = ChooseTarget()

		if newTarget
			and newTarget ~= LocalPlayer then

			LockedTarget = newTarget

			SetTarget(newTarget)

			return
		end
	end

	--========================================================
	-- AIM ASSIST
	--========================================================

	if Settings.AimAssist then

		local newTarget = ChooseTarget()

		if newTarget
			and newTarget ~= LocalPlayer then

			SetTarget(newTarget)

			return
		end
	end

	SetTarget(nil)
end

--============================================================
-- CAMERA TRACKING
--============================================================

local function UpdateCamera(deltaTime)

	if not Settings.TargetLock
		and not Settings.AimAssist then

		return
	end

	local target = CurrentTarget

	if not target then
		return
	end

	-- NEVER AIM AT SELF
	if target == LocalPlayer then

		CurrentTarget = nil
		LockedTarget = nil

		return
	end

	if not IsValidTarget(target) then

		if Settings.TargetLock then
			LockedTarget = nil
		end

		SetTarget(nil)

		return
	end

	local character = GetCharacter(target)
	local head = GetHead(character)

	if not head then
		return
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	--========================================================
	-- HEAD LOCK
	--========================================================

	local cameraPosition =
		camera.CFrame.Position

	local targetCFrame =
		CFrame.lookAt(
			cameraPosition,
			head.Position
		)

	-- FAST + SMOOTH
	local strength =
		math.clamp(
			Settings.AimSmoothness
			* Settings.CameraStrength
			* 14,
			2,
			25
		)

	local alpha =
		1 - math.exp(
			-strength
			* math.max(
				deltaTime,
				1 / 240
			)
		)

	camera.CFrame =
		camera.CFrame:Lerp(
			targetCFrame,
			alpha
		)
end

--============================================================
-- SCREEN GUI
--============================================================

local ScreenGui = New("ScreenGui", {
	Name = "KyzenPerks",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling
}, PlayerGui)

--============================================================
-- SCALE
--============================================================

local UIScale = New("UIScale", {
	Scale = 1
}, ScreenGui)

local function UpdateScale()

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport = camera.ViewportSize

	local scaleX =
		viewport.X / 900

	local scaleY =
		viewport.Y / 650

	local scale =
		math.min(scaleX, scaleY)

	UIScale.Scale =
		math.clamp(
			scale,
			0.68,
			1.05
		)
end

UpdateScale()

if workspace.CurrentCamera then

	workspace.CurrentCamera
		:GetPropertyChangedSignal("ViewportSize")
		:Connect(UpdateScale)

end

