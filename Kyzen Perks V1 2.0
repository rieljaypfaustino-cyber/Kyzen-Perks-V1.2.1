		UDim2.fromScale(
			(Settings.FOVRadius - 50)
			/ 350,
			1
		),

	BackgroundColor3 =
		C.Blue,

	BorderSizePixel = 0,

	ZIndex = 15

}, FOVBar)

Corner(FOVFill, 999)

local FOVDrag = New("TextButton", {

	Size =
		UDim2.new(
			1,
			0,
			1,
			20
		),

	Position =
		UDim2.fromOffset(
			0,
			-10
		),

	BackgroundTransparency = 1,

	Text = "",

	AutoButtonColor = false,

	ZIndex = 20

}, FOVBar)

local function SetFOVFromX(x)

	local relative =
		math.clamp(
			(x - FOVBar.AbsolutePosition.X)
			/ FOVBar.AbsoluteSize.X,
			0,
			1
		)

	local value =
		math.floor(
			50
			+ (
				relative * 350
			)
		)

	Settings.FOVRadius =
		value

	FOVValue.Text =
		tostring(value)

	FOVFill.Size =
		UDim2.fromScale(
			relative,
			1
		)

	UpdateFOV()

end

FOVDrag.MouseButton1Down:Connect(
	function()

		local connection

		connection =
			UserInputService.InputChanged:Connect(
				function(input)

					if input.UserInputType ==
						Enum.UserInputType.MouseMovement
						or input.UserInputType ==
						Enum.UserInputType.Touch then

						SetFOVFromX(
							input.Position.X
						)

					end

				end
			)

		local ended

		ended =
			UserInputService.InputEnded:Connect(
				function(input)

					if input.UserInputType ==
						Enum.UserInputType.MouseButton1
						or input.UserInputType ==
						Enum.UserInputType.Touch then

						if connection then
							connection:Disconnect()
						end

						if ended then
							ended:Disconnect()
						end

					end

				end
			)

	end
)

