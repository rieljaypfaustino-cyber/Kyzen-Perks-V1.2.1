--============================================================
-- TOGGLE
--============================================================

local function MakeToggle(
	parent,
	text,
	y,
	getValue,
	setValue
)

	local holder = New("Frame", {

		Position =
			UDim2.fromOffset(
				20,
				y
			),

		Size =
			UDim2.new(
				1,
				-40,
				0,
				55
			),

		BackgroundColor3 =
			C.Panel2,

		BorderSizePixel = 0,

		ZIndex = 13

	}, parent)

	Corner(holder, 10)

	Stroke(
		holder,
		Color3.fromRGB(
			45,
			45,
			55
		),
		1
	)

	local label = New("TextLabel", {

		Position =
			UDim2.fromOffset(
				14,
				0
			),

		Size =
			UDim2.new(
				1,
				-90,
				1,
				0
			),

		BackgroundTransparency = 1,

		Text = text,

		TextColor3 =
			C.White,

		Font =
			Enum.Font.GothamBold,

		TextSize = 12,

		TextXAlignment =
			Enum.TextXAlignment.Left,

		ZIndex = 14

	}, holder)

	local button = New("TextButton", {

		Position =
			UDim2.new(
				1,
				-65,
				0.5,
				-14
			),

		Size =
			UDim2.fromOffset(
				50,
				28
			),

		BackgroundColor3 =
			C.DarkGray,

		Text = "",

		AutoButtonColor = false,

		ZIndex = 15

	}, holder)

	Corner(button, 999)

	local knob = New("Frame", {

		Position =
			UDim2.fromOffset(
				3,
				3
			),

		Size =
			UDim2.fromOffset(
				22,
				22
			),

		BackgroundColor3 =
			C.White,

		BorderSizePixel = 0,

		ZIndex = 16

	}, button)

	Corner(knob, 999)

	local function Refresh()

		local enabled =
			getValue()

		if enabled then

			Tween(
				button,
				0.12,
				{
					BackgroundColor3 =
						C.Blue
				}
			):Play()

			Tween(
				knob,
				0.12,
				{
					Position =
						UDim2.new(
							1,
							-25,
							0,
							3
						)
				}
			):Play()

		else

			Tween(
				button,
				0.12,
				{
					BackgroundColor3 =
						C.DarkGray
				}
			):Play()

			Tween(
				knob,
				0.12,
				{
					Position =
						UDim2.fromOffset(
							3,
							3
						)
				}
			):Play()

		end
	end

	button.MouseButton1Click:Connect(
		function()

			setValue(
				not getValue()
			)

			Refresh()

		end
	)

	Refresh()

end

--============================================================
-- AIM PAGE
--============================================================

MakeToggle(
	AimPage,
	"TARGET LOCK",
	82,

	function()
		return Settings.TargetLock
	end,

	function(value)

		Settings.TargetLock = value

		if value then

			local target =
				ChooseTarget()

			if target
				and target ~= LocalPlayer then

				LockedTarget =
					target

				SetTarget(target)

			end

		else

			LockedTarget = nil

			if not Settings.AimAssist then
				SetTarget(nil)
			end

		end

	end
)

MakeToggle(
	AimPage,
	"AIM ASSIST",
	145,

	function()
		return Settings.AimAssist
	end,

	function(value)

		Settings.AimAssist =
			value

		if value then

			local target =
				ChooseTarget()

			if target
				and target ~= LocalPlayer then

				SetTarget(target)

			end

		elseif not Settings.TargetLock then

			SetTarget(nil)

		end

	end
)

