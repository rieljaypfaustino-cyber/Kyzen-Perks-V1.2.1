--========================================================
-- RESPONSIVE SCALE
--========================================================

local UIScale = New(
	"UIScale",
	{
		Scale = 1,
	},
	ScreenGui
)

local function UpdateScale()

	local viewport = Camera.ViewportSize

	local scale = math.clamp(
		math.min(viewport.X / 900, viewport.Y / 620),
		0.72,
		1.12
	)

	UIScale.Scale = scale
end

Camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale)

UpdateScale()

