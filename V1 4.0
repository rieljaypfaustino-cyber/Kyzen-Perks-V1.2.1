--========================================================
-- PAGE SYSTEM
--========================================================

local Pages = {}
local TabButtons = {}

local CurrentPage = nil

local function CreatePage(name)

	local page = New(
		"ScrollingFrame",
		{
			Name = name,

			Size = UDim2.fromScale(1, 1),

			BackgroundTransparency = 1,

			BorderSizePixel = 0,

			CanvasSize = UDim2.new(0, 0, 0, 0),

			AutomaticCanvasSize = Enum.AutomaticSize.Y,

			ScrollBarThickness = 3,

			ScrollBarImageColor3 = COLORS.Blue,

			Visible = false,

			ZIndex = 12,
		},
		Content
	)

	Pages[name] = page

	return page
end

local function CreatePageHeader(parent, title, subtitle)

	local heading = New(
		"TextLabel",
		{
			Position = UDim2.new(0, 20, 0, 18),

			Size = UDim2.new(1, -40, 0, 30),

			BackgroundTransparency = 1,

			Text = title,

			TextColor3 = COLORS.White,

			TextSize = 20,

			Font = Enum.Font.GothamBold,

			TextXAlignment = Enum.TextXAlignment.Left,

			ZIndex = 13,
		},
		parent
	)

	local sub = New(
		"TextLabel",
		{
			Position = UDim2.new(0, 20, 0, 48),

			Size = UDim2.new(1, -40, 0, 25),

			BackgroundTransparency = 1,

			Text = subtitle,

			TextColor3 = COLORS.Gray,

			TextSize = 11,

			Font = Enum.Font.GothamMedium,

			TextXAlignment = Enum.TextXAlignment.Left,

			ZIndex = 13,
		},
		parent
	)

	return heading, sub
end

--========================================================
-- TOGGLE HELPER
--========================================================

local function CreateToggle(parent, text, description, default, callback)

	local container = New(
		"Frame",
		{
			Position = UDim2.new(0, 18, 0, 0),

			Size = UDim2.new(1, -36, 0, 70),

			BackgroundColor3 = COLORS.Panel2,

			ZIndex = 13,
		},
		parent
	)

	AddCorner(container, 10)

	AddStroke(
		container,
		COLORS.Stroke,
		1,
		0.25
	)

	local title = New(
		"TextLabel",
		{
			Position = UDim2.new(0, 14, 0, 10),

			Size = UDim2.new(1, -100, 0, 22),

			BackgroundTransparency = 1,

			Text = text,

			TextColor3 = COLORS.White,

			TextSize = 13,

			Font = Enum.Font.GothamBold,

			TextXAlignment = Enum.TextXAlignment.Left,

			ZIndex = 14,
		},
		container
	)

	local desc = New(
		"TextLabel",
		{
			Position = UDim2.new(0, 14, 0, 34),

			Size = UDim2.new(1, -100, 0, 20),

			BackgroundTransparency = 1,

			Text = description,

			TextColor3 = COLORS.Gray,

			TextSize = 9,

			Font = Enum.Font.GothamMedium,

			TextXAlignment = Enum.TextXAlignment.Left,

			ZIndex = 14,
		},
		container
	)

	local button = New(
		"TextButton",
		{
			AnchorPoint = Vector2.new(1, 0.5),

			Position = UDim2.new(1, -14, 0.5, 0),

			Size = UDim2.fromOffset(54, 28),

			BackgroundColor3 = COLORS.DarkGray,

			Text = "",

			AutoButtonColor = false,

			ZIndex = 15,
		},
		container
	)

	AddCorner(button, 14)

	local circle = New(
		"Frame",
		{
			AnchorPoint = Vector2.new(0, 0.5),

			Position = UDim2.new(0, 3, 0.5, 0),

			Size = UDim2.fromOffset(22, 22),

			BackgroundColor3 = COLORS.White,

			ZIndex = 16,
		},
		button
	)

	AddCorner(circle, 999)

	local enabled = default == true

	local function Refresh()

		if enabled then

			Tween(
				button,
				0.18,
				{
					BackgroundColor3 = COLORS.Blue,
				}
			)

			Tween(
				circle,
				0.18,
				{
					Position = UDim2.new(1, -25, 0.5, 0),
				}
			)

		else

			Tween(
				button,
				0.18,
				{
					BackgroundColor3 = COLORS.DarkGray,
				}
			)

			Tween(
				circle,
				0.18,
				{
					Position = UDim2.new(0, 3, 0.5, 0),
				}
			)

		end

	end

	button.Activated:Connect(function()

		enabled = not enabled

		callback(enabled)

		Refresh()

	end)

	Refresh()

	return container
end

--========================================================
-- NUMBER CONTROL
--========================================================

local function CreateNumberControl(parent, text, description, value, minimum, maximum, step, callback)

	local container = New(
		"Frame",
		{
			Position = UDim2.new(0, 18, 0, 0),

			Size = UDim2.new(1, -36, 0, 72),

			BackgroundColor3 = COLORS.Panel2,

			ZIndex = 13,
		},
		parent
	)

	AddCorner(container, 10)

	AddStroke(
		container,
		COLORS.Stroke,
		1,
		0.25
	)

	local title = New(
		"TextLabel",
		{
			Position = UDim2.new(0, 14, 0, 10),

			Size = UDim2.new(1, -170, 0, 22),

			BackgroundTransparency = 1,

			Text = text,

			TextColor3 = COLORS.White,

			TextSize = 13,

			Font = Enum.Font.GothamBold,

			TextXAlignment = Enum.TextXAlignment.Left,

			ZIndex = 14,
		},
		container
	)

	local desc = New(
		"TextLabel",
		{
			Position = UDim2.new(0, 14, 0, 34),

			Size = UDim2.new(1, -170, 0, 18),

			BackgroundTransparency = 1,

			Text = description,

			TextColor3 = COLORS.Gray,

			TextSize = 9,

			Font = Enum.Font.GothamMedium,

			TextXAlignment = Enum.TextXAlignment.Left,

			ZIndex = 14,
		},
		container
	)

	local minus = New(
		"TextButton",
		{
			AnchorPoint = Vector2.new(1, 0.5),

			Position = UDim2.new(1, -95, 0.5, 0),

			Size = UDim2.fromOffset(28, 28),

			BackgroundColor3 = COLORS.Panel,

			Text = "−",

			TextColor3 = COLORS.White,

			TextSize = 18,

			Font = Enum.Font.GothamBold,

			AutoButtonColor = false,

			ZIndex = 14,
		},
		container
	)

	AddCorner(minus, 8)
	AddStroke(minus, COLORS.Stroke, 1, 0)

	local display = New(
		"TextLabel",
		{
			AnchorPoint = Vector2.new(1, 0.5),

			Position = UDim2.new(1, -48, 0.5, 0),

			Size = UDim2.fromOffset(45, 28),

			BackgroundColor3 = COLORS.Blue,

			TextColor3 = COLORS.White,

			TextSize = 11,

			Font = Enum.Font.GothamBold,

			ZIndex = 14,
		},
		container
	)

	AddCorner(display, 8)

	local plus = New(
		"TextButton",
		{
			AnchorPoint = Vector2.new(1, 0.5),

			Position = UDim2.new(1, -12, 0.5, 0),

			Size = UDim2.fromOffset(28, 28),

			BackgroundColor3 = COLORS.Panel,

			Text = "+",

			TextColor3 = COLORS.White,

			TextSize = 18,

			Font = Enum.Font.GothamBold,

			AutoButtonColor = false,

			ZIndex = 14,
		},
		container
	)

	AddCorner(plus, 8)
	AddStroke(plus, COLORS.Stroke, 1, 0)

	local current = value

	local function Refresh()

		display.Text = tostring(current)

	end

	local function Change(amount)

		current = math.clamp(
			current + amount,
			minimum,
			maximum
		)

		callback(current)

		Refresh()

	end

	minus.Activated:Connect(function()
		Change(-step)
	end)

	plus.Activated:Connect(function()
		Change(step)
	end)

	Refresh()

	return container
end

--========================================================
-- MODE SELECTOR
--========================================================

local function CreateModeSelector(parent, callback)

	local container = New(
		"Frame",
		{
			Position = UDim2.new(0, 18, 0, 0),

			Size = UDim2.new(1, -36, 0, 82),

			BackgroundColor3 = COLORS.Panel2,

			ZIndex = 13,
		},
		parent
	)

	AddCorner(container, 10)

	AddStroke(
		container,
		COLORS.Stroke,
		1,
		0.25
	)

	local title = New(
		"TextLabel",
		{
			Position = UDim2.new(0, 14, 0, 10),

			Size = UDim2.new(1, -28, 0, 20),

			BackgroundTransparency = 1,

			Text = "TARGET MODE",

			TextColor3 = COLORS.White,

			TextSize = 12,

			Font = Enum.Font.GothamBold,

			TextXAlignment = Enum.TextXAlignment.Left,

			ZIndex = 14,
		},
		container
	)

	local modes = {
		"SMART",
		"NEAREST",
		"LOCK",
	}

	for index, mode in ipairs(modes) do

		local button = New(
			"TextButton",
			{
				Position = UDim2.new(
					0,
					12 + ((index - 1) * 92),
					0,
					40
				),

				Size = UDim2.fromOffset(84, 28),

				BackgroundColor3 =
					mode == Settings.TargetMode
					and COLORS.Blue
					or COLORS.Panel,

				Text = mode,

				TextColor3 = COLORS.White,

				TextSize = 9,

				Font = Enum.Font.GothamBold,

				AutoButtonColor = false,

				ZIndex = 14,
			},
			container
		)

		AddCorner(button, 7)

		AddStroke(
			button,
			mode == Settings.TargetMode
				and COLORS.BlueLight
				or COLORS.Stroke,
			1,
			0
		)

		button.Activated:Connect(function()

			Settings.TargetMode = mode

			callback(mode)

			for _, other in ipairs(container:GetChildren()) do

				if other:IsA("TextButton") then

					local selected =
						other.Text == Settings.TargetMode

					Tween(
						other,
						0.15,
						{
							BackgroundColor3 =
								selected
								and COLORS.Blue
								or COLORS.Panel
						}
					)

					local stroke =
						other:FindFirstChildOfClass("UIStroke")

					if stroke then

						stroke.Color =
							selected
							and COLORS.BlueLight
							or COLORS.Stroke

					end

				end

			end

		end)

	end

	return container
end

