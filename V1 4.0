--========================================================
-- TAB CREATION
--========================================================

local function CreateTab(name, text, order)

	local button = New(
		"TextButton",
		{
			Name = name,

			Size = UDim2.new(1, 0, 0, 42),

			BackgroundColor3 = COLORS.Panel,

			Text = text,

			TextColor3 = COLORS.Gray,

			TextSize = 10,

			Font = Enum.Font.GothamBold,

			TextXAlignment = Enum.TextXAlignment.Left,

			AutoButtonColor = false,

			LayoutOrder = order,

			ZIndex = 13,
		},
		TabsContainer
	)

	AddCorner(button, 8)

	local padding = New(
		"UIPadding",
		{
			PaddingLeft = UDim.new(0, 14),
		},
		button
	)

	local line = New(
		"Frame",
		{
			Position = UDim2.new(0, 0, 0.5, -10),

			Size = UDim2.fromOffset(3, 20),

			BackgroundColor3 = COLORS.Blue,

			Visible = false,

			ZIndex = 14,
		},
		button
	)

	AddCorner(line, 3)

	TabButtons[name] = {
		Button = button,
		Line = line,
	}

	button.Activated:Connect(function()

		if CurrentPage == name then
			return
		end

		for pageName, page in pairs(Pages) do

			page.Visible = pageName == name

		end

		for tabName, data in pairs(TabButtons) do

			local active = tabName == name

			Tween(
				data.Button,
				0.15,
				{
					BackgroundColor3 =
						active
						and Color3.fromRGB(24, 34, 52)
						or COLORS.Panel,

					TextColor3 =
						active
						and COLORS.White
						or COLORS.Gray,
				}
			)

			data.Line.Visible = active

		end

		CurrentPage = name

	end)

	return button
end

CreateTab("AimTarget", "AIM & TARGET", 1)
CreateTab("Settings", "SETTINGS", 2)
CreateTab("InfoCredit", "INFO & CREDIT", 3)
CreateTab("Discord", "DISCORD", 4)

--========================================================
-- OPEN PAGE
--========================================================

local function OpenPage()

	if MainFrame.Visible then
		return
	end

	MainFrame.Visible = true

	MainFrame.Size = UDim2.fromOffset(760, 490)

	Tween(
		MainFrame,
		0.3,
		{
			Size = UDim2.fromOffset(820, 530),
		}
	)

	local first = TabButtons["AimTarget"]

	if first then

		for pageName, page in pairs(Pages) do
			page.Visible = pageName == "AimTarget"
		end

		for tabName, data in pairs(TabButtons) do

			local active = tabName == "AimTarget"

			data.Button.BackgroundColor3 =
				active
				and Color3.fromRGB(24, 34, 52)
				or COLORS.Panel

			data.Button.TextColor3 =
				active
				and COLORS.White
				or COLORS.Gray

			data.Line.Visible = active

		end

		CurrentPage = "AimTarget"

	end

end

local function ClosePage()

	Tween(
		MainFrame,
		0.2,
		{
			Size = UDim2.fromOffset(760, 490),
		}
	)

	task.delay(0.2, function()

		if not MainFrame.Parent then
			return
		end

		MainFrame.Visible = false

	end)

end

DevButton.Activated:Connect(function()

	if MainFrame.Visible then
		ClosePage()
	else
		OpenPage()
	end

end)

CloseButton.Activated:Connect(function()

	ClosePage()

end)

--========================================================
-- DRAGGING
--========================================================

local dragging = false
local dragStart
local startPosition

Header.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true

		dragStart = input.Position

		startPosition = MainFrame.Position

	end

end)

Header.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = false

	end

end)

UserInputService.InputChanged:Connect(function(input)

	if not dragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local delta = input.Position - dragStart

	MainFrame.Position =
		UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)

end)

--========================================================
-- TARGET SYSTEM
--========================================================

local CurrentTarget = nil
local LockedTarget = nil

local TargetHighlightObject = nil
local TargetBillboardObject = nil

local function IsValidTarget(player)

	if not player then
		return false
	end

	if player == LocalPlayer then
		return false
	end

	local character = player.Character

	if not character then
		return false
	end

	if not IsAlive(character) then
		return false
	end

	local root = GetCharacterRoot(character)

	if not root then
		return false
	end

	local localCharacter = LocalPlayer.Character

	local localRoot = GetCharacterRoot(localCharacter)

	if not localRoot then
		return false
	end

	local distance =
		(localRoot.Position - root.Position).Magnitude

	if distance > Settings.TargetRange then
		return false
	end

	return true
end

local function IsInsideFOV(part)

	if not part then
		return false
	end

	if not Settings.ShowFOV then
		return true
	end

	local screenPosition, onScreen =
		Camera:WorldToViewportPoint(part.Position)

	if not onScreen then
		return false
	end

	local center =
		Vector2.new(
			Camera.ViewportSize.X / 2,
			Camera.ViewportSize.Y / 2
		)

	local position =
		Vector2.new(
			screenPosition.X,
			screenPosition.Y
		)

	return (position - center).Magnitude <= Settings.FOVRadius
end

local function GetCandidates()

	local candidates = {}

	for _, player in ipairs(Players:GetPlayers()) do

		if IsValidTarget(player) then

			local character = player.Character
			local part = GetTargetPart(character)

			if part and IsInsideFOV(part) then

				table.insert(candidates, player)

			end

		end

	end

	return candidates
end

local function FindNearest()

	local candidates = GetCandidates()

	local localCharacter = LocalPlayer.Character
	local localRoot = GetCharacterRoot(localCharacter)

	if not localRoot then
		return nil
	end

	local nearest = nil
	local nearestDistance = math.huge

	for _, player in ipairs(candidates) do

		local root =
			GetCharacterRoot(player.Character)

		if root then

			local distance =
				(localRoot.Position - root.Position).Magnitude

			if distance < nearestDistance then

				nearestDistance = distance
				nearest = player

			end

		end

	end

	return nearest
end

local function FindSmart()

	local candidates = GetCandidates()

	local center =
		Vector2.new(
			Camera.ViewportSize.X / 2,
			Camera.ViewportSize.Y / 2
		)

	local bestTarget = nil
	local bestScore = math.huge

	for _, player in ipairs(candidates) do

		local part =
			GetTargetPart(player.Character)

		if part then

			local screenPosition, onScreen =
				Camera:WorldToViewportPoint(
					part.Position
				)

			if onScreen then

				local screenPoint =
					Vector2.new(
						screenPosition.X,
						screenPosition.Y
					)

				local screenDistance =
					(screenPoint - center).Magnitude

				if screenDistance < bestScore then

					bestScore = screenDistance
					bestTarget = player

				end

			end

		end

	end

	return bestTarget
end

local function FindLock()

	if LockedTarget and IsValidTarget(LockedTarget) then

		return LockedTarget

	end

	local target = FindSmart()

	LockedTarget = target

	return target
end

local function FindTarget()

	if Settings.TargetMode == "NEAREST" then

		return FindNearest()

	elseif Settings.TargetMode == "LOCK" then

		return FindLock()

	else

		return FindSmart()

	end

end

--========================================================
-- TARGET VISUALS
--========================================================

local function ClearTargetVisuals()

	if TargetHighlightObject then

		TargetHighlightObject:Destroy()
		TargetHighlightObject = nil

	end

	if TargetBillboardObject then

		TargetBillboardObject:Destroy()
		TargetBillboardObject = nil

	end

end

local function UpdateTargetVisuals()

	ClearTargetVisuals()

	if not CurrentTarget then
		return
	end

	if not IsValidTarget(CurrentTarget) then
		return
	end

	local character = CurrentTarget.Character

	if not character then
		return
	end

	if Settings.TargetHighlight then

		local highlight = Instance.new("Highlight")

		highlight.Name = "KyzenTargetHighlight"

		highlight.Adornee = character

		highlight.FillColor = COLORS.Red

		highlight.FillTransparency = 0.78

		highlight.OutlineColor = COLORS.RedLight

		highlight.OutlineTransparency = 0

		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

		highlight.Parent = character

		TargetHighlightObject = highlight

	end

	if Settings.TargetBillboard then

		local head =
			character:FindFirstChild("Head")

		if head then

			local billboard = Instance.new("BillboardGui")

			billboard.Name = "KyzenTargetBillboard"

			billboard.Adornee = head

			billboard.Size =
				UDim2.fromOffset(170, 35)

			billboard.StudsOffset =
				Vector3.new(0, 2.8, 0)

			billboard.AlwaysOnTop = true

			billboard.Parent = head

			local label = New(
				"TextLabel",
				{
					Size = UDim2.fromScale(1, 1),

					BackgroundTransparency = 1,

					Text =
						"TARGET  •  "
						.. CurrentTarget.DisplayName,

					TextColor3 = COLORS.RedLight,

					TextStrokeTransparency = 0.25,

					TextStrokeColor3 =
						Color3.new(0, 0, 0),

					TextSize = 11,

					Font = Enum.Font.GothamBold,

					ZIndex = 20,
				},
				billboard
			)

			TargetBillboardObject = billboard

		end

	end

end

--========================================================
-- TARGET UPDATE
--========================================================

local LastTarget = nil

local function UpdateTarget()

	local newTarget = FindTarget()

	if newTarget ~= LastTarget then

		LastTarget = newTarget

		CurrentTarget = newTarget

		UpdateTargetVisuals()

	end

	if CurrentTarget then

		if not IsValidTarget(CurrentTarget) then

			CurrentTarget = nil
			LastTarget = nil
			LockedTarget = nil

			ClearTargetVisuals()

		end

	end

end

--========================================================
-- CAMERA AIM
--========================================================

local function UpdateCamera()

	if not Settings.TargetLock
		and not Settings.AimAssist then
		return
	end

	if not CurrentTarget then
		return
	end

	if not IsValidTarget(CurrentTarget) then
		return
	end

	local part =
		GetTargetPart(CurrentTarget.Character)

	if not part then
		return
	end

	local cameraPosition =
		Camera.CFrame.Position

	local desired =
		CFrame.lookAt(
			cameraPosition,
			part.Position
		)

	local alpha =
		math.clamp(
			Settings.AimSmoothness
			* Settings.CameraSpeed,
			0.01,
			1
		)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			desired,
			alpha
		)

end

--========================================================
-- ATTACK BUTTON
--========================================================

local function FindAttackButton()

	local mobileButtons =
		PlayerGui:FindFirstChild("MobileButtons")

	if not mobileButtons then
		return nil
	end

	local buttons =
		mobileButtons:FindFirstChild("Buttons")

	if not buttons then
		return nil
	end

	local attack =
		buttons:FindFirstChild("Attack")

	if attack and attack:IsA("ImageButton") then

		return attack

	end

	return nil
end

--========================================================
-- AUTO SHOOT
--========================================================

local LastAutoShot = 0

local function CanAutoShoot()

	if not Settings.AutoShoot then
		return false
	end

	if not CurrentTarget then
		return false
	end

	if not IsValidTarget(CurrentTarget) then
		return false
	end

	local attackButton =
		FindAttackButton()

	if not attackButton then
		return false
	end

	if not attackButton.Visible then
		return false
	end

	if not attackButton.Active then
		return false
	end

	local now = os.clock()

	if now - LastAutoShot
		< Settings.AutoShootCooldown then

		return false

	end

	return true
end

local function AutoShoot()

	if not CanAutoShoot() then
		return
	end

	local attackButton =
		FindAttackButton()

	if not attackButton then
		return
	end

	LastAutoShot = os.clock()

	-- Native Roblox GUI activation.
	-- This triggers the button's normal Activated behavior.
	pcall(function()

		attackButton:Activate()

	end)

end

--========================================================
-- AUTO SHOOT LOOP
--========================================================

task.spawn(function()

	while ScreenGui.Parent do

		AutoShoot()

		task.wait(0.025)

	end

end)

--========================================================
-- TARGET LOOP
--========================================================

task.spawn(function()

	while ScreenGui.Parent do

		UpdateTarget()

		task.wait(0.05)

	end

end)

--========================================================
-- CAMERA LOOP
--========================================================

RunService:BindToRenderStep(
	"KyzenPerksCamera",
	Enum.RenderPriority.Camera.Value + 1,
	function()

		if not ScreenGui.Parent then
			return
		end

		UpdateCamera()

	end
)

--========================================================
-- FOV LOOP
--========================================================

task.spawn(function()

	while ScreenGui.Parent do

		if Settings.ShowFOV then

			FOVCircle.Visible = true

			FOVCircle.Position =
				UDim2.fromOffset(
					Camera.ViewportSize.X / 2,
					Camera.ViewportSize.Y / 2
				)

			FOVCircle.Size =
				UDim2.fromOffset(
					Settings.FOVRadius * 2,
					Settings.FOVRadius * 2
				)

		else

			FOVCircle.Visible = false

		end

		task.wait(0.05)

	end

end)

--========================================================
-- CHARACTER RESPAWN SAFETY
--========================================================

LocalPlayer.CharacterAdded:Connect(function()

	CurrentTarget = nil
	LockedTarget = nil
	LastTarget = nil

	ClearTargetVisuals()

	task.wait(1)

	UpdateScale()

end)

--========================================================
-- PLAYER LEAVE SAFETY
--========================================================

Players.PlayerRemoving:Connect(function(player)

	if player == CurrentTarget then

		CurrentTarget = nil
		LastTarget = nil
		LockedTarget = nil

		ClearTargetVisuals()

	end

end)

--========================================================
-- VISUAL SAFETY
--========================================================

task.spawn(function()

	while ScreenGui.Parent do

		if CurrentTarget then

			if not IsValidTarget(CurrentTarget) then

				CurrentTarget = nil
				LastTarget = nil
				LockedTarget = nil

				ClearTargetVisuals()

			end

		end

		task.wait(0.2)

	end

end)

--========================================================
-- INITIAL STATE
--========================================================

FOVCircle.Visible = Settings.ShowFOV

FOVCircle.Size =
	UDim2.fromOffset(
		Settings.FOVRadius * 2,
		Settings.FOVRadius * 2
	)

--========================================================
-- OPEN ANIMATION
--========================================================

task.delay(0.25, function()

	OpenPage()

end)

--========================================================
-- END
--========================================================
