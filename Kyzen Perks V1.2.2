local SettingsTab = CreateTab("Settings", "SETTINGS")
local InfoTab = CreateTab("Info", "INFO & CREDIT")
local DiscordTab = CreateTab("Discord", "DISCORD")

--==================================================
-- PAGE SWITCHER
--==================================================

local function OpenPage(name)
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for buttonName, data in pairs(TabButtons) do
        if buttonName == name or
            (name == "AimTarget" and buttonName == "Aim") or
            (name == "InfoCredit" and buttonName == "Info") then

            data.Button.BackgroundColor3 = Color3.fromRGB(25, 65, 125)
            data.Button.TextColor3 = WHITE
            data.Stroke.Color = BLUE
        else
            data.Button.BackgroundColor3 = DARK2
            data.Button.TextColor3 = GREY
            data.Stroke.Color = Color3.fromRGB(35, 40, 50)
        end
    end
end

AimTab.MouseButton1Click:Connect(function()
    OpenPage("AimTarget")
end)

SettingsTab.MouseButton1Click:Connect(function()
    OpenPage("Settings")
end)

InfoTab.MouseButton1Click:Connect(function()
    OpenPage("InfoCredit")
end)

DiscordTab.MouseButton1Click:Connect(function()
    OpenPage("Discord")
end)

--==================================================
-- CIRCLE TOGGLE
--==================================================

local function CreateCircleToggle(parent, title, description, defaultValue, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 62)
    holder.BackgroundColor3 = DARK2
    holder.Parent = parent

    Corner(holder, 10)
    Stroke(holder, Color3.fromRGB(35, 40, 50), 1)

    local label = MakeLabel(
        holder,
        title,
        UDim2.new(1, -85, 0, 24),
        UDim2.fromOffset(13, 8),
        13
    )

    local desc = MakeLabel(
        holder,
        description,
        UDim2.new(1, -85, 0, 20),
        UDim2.fromOffset(13, 32),
        9
    )

    desc.TextColor3 = GREY

    local outer = Instance.new("TextButton")
    outer.Name = "Toggle"
    outer.Size = UDim2.fromOffset(40, 40)
    outer.Position = UDim2.new(1, -52, 0.5, -20)
    outer.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    outer.Text = ""
    outer.AutoButtonColor = false
    outer.Parent = holder

    Corner(outer, 20)
    Stroke(outer, GREY2, 1)

    local inner = Instance.new("Frame")
    inner.Size = UDim2.fromOffset(20, 20)
    inner.AnchorPoint = Vector2.new(0.5, 0.5)
    inner.Position = UDim2.fromScale(0.5, 0.5)
    inner.BackgroundColor3 = GREY
    inner.Parent = outer

    Corner(inner, 20)

    local state = defaultValue

    local function Update()
        if state then
            Tween(outer, {
                BackgroundColor3 = Color3.fromRGB(25, 75, 150)
            })

            Tween(inner, {
                BackgroundColor3 = BLUE2
            })

            callback(true)
        else
            Tween(outer, {
                BackgroundColor3 = Color3.fromRGB(35, 35, 40)
            })

            Tween(inner, {
                BackgroundColor3 = GREY
            })

            callback(false)
        end
    end

    outer.MouseButton1Click:Connect(function()
        state = not state
        Update()
    end)

    Update()

    return holder
end

--==================================================
-- NUMBER CONTROL
--==================================================

local function CreateNumberControl(parent, title, description, value, minValue, maxValue, step, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 70)
    holder.BackgroundColor3 = DARK2
    holder.Parent = parent

    Corner(holder, 10)
    Stroke(holder, Color3.fromRGB(35, 40, 50), 1)

    local label = MakeLabel(
        holder,
        title,
        UDim2.new(1, -150, 0, 24),
        UDim2.fromOffset(13, 8),
        13
    )

    local desc = MakeLabel(
        holder,
        description,
        UDim2.new(1, -150, 0, 20),
        UDim2.fromOffset(13, 34),
        9
    )

    desc.TextColor3 = GREY

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.fromOffset(32, 32)
    minus.Position = UDim2.new(1, -130, 0.5, -16)
    minus.BackgroundColor3 = Color3.fromRGB(30, 35, 42)
    minus.Text = "−"
    minus.TextColor3 = WHITE
    minus.TextSize = 18
    minus.Font = Enum.Font.GothamBold
    minus.Parent = holder

    Corner(minus, 8)
    Stroke(minus, BLUE, 1)

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.fromOffset(65, 32)
    valueLabel.Position = UDim2.new(1, -94, 0.5, -16)
    valueLabel.BackgroundColor3 = Color3.fromRGB(25, 28, 34)
    valueLabel.TextColor3 = WHITE
    valueLabel.Text = tostring(value)
    valueLabel.TextSize = 12
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.Parent = holder

    Corner(valueLabel, 8)
    Stroke(valueLabel, Color3.fromRGB(55, 60, 70), 1)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.fromOffset(32, 32)
    plus.Position = UDim2.new(1, -42, 0.5, -16)
    plus.BackgroundColor3 = Color3.fromRGB(30, 35, 42)
    plus.Text = "+"
    plus.TextColor3 = WHITE
    plus.TextSize = 18
    plus.Font = Enum.Font.GothamBold
    plus.Parent = holder

    Corner(plus, 8)
    Stroke(plus, RED, 1)

    local current = value

    local function Update()
        current = math.clamp(current, minValue, maxValue)
        valueLabel.Text = tostring(current)
        callback(current)
    end

    minus.MouseButton1Click:Connect(function()
        current -= step
        Update()
    end)

    plus.MouseButton1Click:Connect(function()
        current += step
        Update()
    end)

    return holder
end

