--------------------------------------------------------
-- RESPONSIVE SCALE
--------------------------------------------------------

local UIScale = New("UIScale", {
	Scale = 1,
}, ScreenGui)

local function UpdateScale()
	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport = camera.ViewportSize

	local widthScale = viewport.X / 900
	local heightScale = viewport.Y / 600

	local scale = math.min(widthScale, heightScale)

	scale = math.clamp(scale, 0.68, 1)

	UIScale.Scale = scale
end

UpdateScale()

if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(
		UpdateScale
	)
end

