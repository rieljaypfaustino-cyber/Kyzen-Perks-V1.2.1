local TabButtons = {}

local function CreateTab(text, pageName, layoutOrder)

	local button = New("TextButton", {
		Size = UDim2.new(1, 0, 0, 43),

		BackgroundColor3 =
			Color3.fromRGB(18, 22, 29),

		BorderSizePixel = 0,

		Text = text,

		TextColor3 = COLORS.Muted,

		TextSize = 10,

		Font = Enum.Font.GothamBold,

		AutoButtonColor = false,

		LayoutOrder = layoutOrder,

		ZIndex = 24,
	}, TabsPanel)

	AddCorner(button, 7)

	local accent = New("Frame", {
		Position = UDim2.new(0, 0, 0.2, 0),

		Size = UDim2.new(0, 3, 0.6, 0),

		BackgroundColor3 = COLORS.Blue,

		BorderSizePixel = 0,

		Visible = false,

		ZIndex = 25,
	}, button)

	AddCorner(accent, 5)

	TabButtons[pageName] = {
		Button = button,
		Accent = accent,
	}

	return button
end

