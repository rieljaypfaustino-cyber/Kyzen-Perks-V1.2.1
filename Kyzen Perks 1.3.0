-- MODE SELECTOR
--------------------------------------------------------

local function CreateModeSelector(parent)

	local holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 82),

		BackgroundColor3 = COLORS.Panel2,

		BorderSizePixel = 0,

		LayoutOrder = 5,

		ZIndex = 23,
	}, parent)

	AddCorner(holder, 8)

	AddStroke(
		holder,
		Color3.fromRGB(38, 45, 57),
		1,
		0
	)

	New("TextLabel", {
		Position = UDim2.new(0, 13, 0, 8),

		Size = UDim2.new(1, -26, 0, 20),

		BackgroundTransparency = 1,

		Text = "TARGET MODE",

		TextColor3 = COLORS.White,

		TextSize = 12,

		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 24,
	}, holder)

	New("TextLabel", {
		Position = UDim2.new(0, 13, 0, 28),

		Size = UDim2.new(1, -26, 0, 16),

		BackgroundTransparency = 1,

		Text = "Choose how the target is selected.",

		TextColor3 = COLORS.Muted,

		TextSize = 9,

		Font = Enum.Font.GothamMedium,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 24,
	}, holder)

	local modes = {
		"SMART",
		"NEAREST",
		"LOCK",
	}

	local buttons = {}

	for index, mode in ipairs(modes) do

		local button = New("TextButton", {
			Position = UDim2.new(
				0,
				13 + ((index - 1) * 92),
				0,
				52
			),

			Size = UDim2.fromOffset(84, 22),

			BackgroundColor3 =
				Color3.fromRGB(27, 32, 41),

			BorderSizePixel = 0,

			Text = mode,

			TextColor3 = COLORS.Light,

			TextSize = 9,

			Font = Enum.Font.GothamBold,

			AutoButtonColor = false,

			ZIndex = 25,
		}, holder)

		AddCorner(button, 6)

		buttons[mode] = button

		button.MouseButton1Click:Connect(function()

			Settings.TargetMode = mode

			for name, otherButton in pairs(buttons) do

				if name == mode then

					Tween(otherButton, {
						BackgroundColor3 =
							COLORS.Blue
					}, 0.12)

					otherButton.TextColor3 =
						COLORS.White

				else

					Tween(otherButton, {
						BackgroundColor3 =
							Color3.fromRGB(27, 32, 41)
					}, 0.12)

					otherButton.TextColor3 =
						COLORS.Light

				end
			end

			-- Changing mode should immediately
			-- allow a new selection.
			CurrentTarget = nil
			LockedTarget = nil
		end)
	end

	Tween(buttons[Settings.TargetMode], {
		BackgroundColor3 = COLORS.Blue
	}, 0.1)

	buttons[Settings.TargetMode].TextColor3 =
		COLORS.White

	return holder
end

