local function OpenMain()

	Main.Visible = true

	Main.Size = UDim2.fromOffset(
		630,
		395
	)

	Tween(
		Main,
		{
			Size = UDim2.fromOffset(
				680,
				430
			)
		},
		0.22,
		Enum.EasingStyle.Quint
	)

end

local function CloseMain()

	Tween(
		Main,
		{
			Size = UDim2.fromOffset(
				630,
				395
			)
		},
		0.18
	)

	task.delay(
		0.18,
		function()

			if Main then
				Main.Visible = false
			end

		end
	)

end

DevButton.MouseButton1Click:Connect(function()

	if Main.Visible then
		CloseMain()
	else
		OpenMain()
	end

end)

CloseButton.MouseButton1Click:Connect(
	CloseMain
)

--------------------------------------------------------
-- DRAGGING
--------------------------------------------------------

local function MakeDraggable(object)

	local dragging = false
	local dragStart
	local startPosition

	object.InputBegan:Connect(function(input)

		if
			input.UserInputType ==
				Enum.UserInputType.MouseButton1
			or
			input.UserInputType ==
				Enum.UserInputType.Touch
		then

			dragging = true

			dragStart = input.Position

			startPosition =
				object.Position

			input.Changed:Connect(
				function()

					if
						input.UserInputState ==
							Enum.UserInputState.End
					then

						dragging = false

					end

				end
			)

		end

	end)

	UserInputService.InputChanged:Connect(
		function(input)

			if not dragging then
				return
			end

			if
				input.UserInputType ~=
					Enum.UserInputType.MouseMovement
				and
				input.UserInputType ~=
					Enum.UserInputType.Touch
			then
				return
			end

			local delta =
				input.Position - dragStart

			object.Position =
				UDim2.new(
					startPosition.X.Scale,
					startPosition.X.Offset
						+ delta.X,

					startPosition.Y.Scale,
					startPosition.Y.Offset
						+ delta.Y
				)

		end
	)

end

MakeDraggable(Main)
MakeDraggable(DevButton)

--------------------------------------------------------
-- TARGET SYSTEM
--------------------------------------------------------

local function IsValidModel(model)

	if not model then
		return false
	end

	if not model:IsA("Model") then
		return false
	end

	-- NEVER target ourselves
	if model == LocalPlayer.Character then
		return false
	end

	local humanoid =
		GetHumanoid(model)

	if not humanoid then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	local root =
		GetRoot(model)

	if not root then
		return false
	end

	local myCharacter =
		LocalPlayer.Character

	if not myCharacter then
		return false
	end

	local myRoot =
		GetRoot(myCharacter)

	if not myRoot then
		return false
	end

	local distance =
		(root.Position - myRoot.Position).Magnitude

	if distance >
		Settings.TargetRange
	then
		return false
	end

	return true
end

--------------------------------------------------------
-- CANDIDATE
--------------------------------------------------------

local function MakeCandidate(model, player)

	local root =
		GetRoot(model)

	if not root then
		return nil
	end

	local myRoot =
		GetRoot(LocalPlayer.Character)

	if not myRoot then
		return nil
	end

	return {
		Model = model,

		Player = player,

		Root = root,

		Distance =
			(root.Position - myRoot.Position).Magnitude,
	}
end

--------------------------------------------------------
-- PLAYER TARGETS
--------------------------------------------------------

local function GetPlayerCandidates()

	local candidates = {}

	if not Settings.TargetPlayers then
		return candidates
	end

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer then

			local character =
				player.Character

			if
				character
				and
				IsValidModel(character)
			then

				local candidate =
					MakeCandidate(
						character,
						player
					)

				if candidate then
					table.insert(
						candidates,
						candidate
					)
				end

			end

		end

	end

	return candidates
end

--------------------------------------------------------
-- NPC TARGETS
--------------------------------------------------------

local function GetNPCCandidates()

	local candidates = {}

	if not Settings.TargetNPCs then
		return candidates
	end

	-- Only scan workspace models containing Humanoids.
	-- This is deliberately separate from the camera loop.
	for _, object in ipairs(
		workspace:GetChildren()
	) do

		if object:IsA("Model")
			and object ~= LocalPlayer.Character
		then

			local humanoid =
				GetHumanoid(object)

			if
				humanoid
				and
				IsValidModel(object)
			then

				local candidate =
					MakeCandidate(
						object,
						nil
					)

				if candidate then

					table.insert(
						candidates,
						candidate
					)

				end

			end

		end

	end

	return candidates
end

--------------------------------------------------------
-- ALL CANDIDATES
--------------------------------------------------------

local function GetCandidates()

	local candidates =
		GetPlayerCandidates()

	local npcCandidates =
		GetNPCCandidates()

	for _, candidate in ipairs(
		npcCandidates
	) do

		table.insert(
			candidates,
			candidate
		)

	end

	return candidates
end

--------------------------------------------------------
-- NEAREST
--------------------------------------------------------

local function FindNearest(candidates)

	local best = nil

	for _, candidate in ipairs(
		candidates
	) do

		if
			not best
			or
			candidate.Distance <
				best.Distance
		then

			best = candidate

		end

	end

	return best
end

--------------------------------------------------------
-- CURRENT TARGET
--------------------------------------------------------

local function FindCurrent(candidates)

	if not CurrentTarget then
		return nil
	end

	for _, candidate in ipairs(
		candidates
	) do

		if
			candidate.Model ==
				CurrentTarget.Model
		then

			return candidate

		end

	end

	return nil
end

--------------------------------------------------------
-- SMART
--------------------------------------------------------

local function FindSmart(candidates)

	if #candidates == 0 then
		return nil
	end

	local current =
		FindCurrent(candidates)

	if current then

		local nearest =
			FindNearest(candidates)

		if
			nearest
			and
			nearest.Model ~=
				current.Model
		then

			-- Prevent rapid target switching.
			if
				nearest.Distance <
					current.Distance * 0.70
			then

				return nearest

			end

		end

		return current

	end

	return FindNearest(candidates)
end

--------------------------------------------------------
-- LOCK
--------------------------------------------------------

local function FindLocked(candidates)

	if not LockedTarget then
		return nil
	end

	for _, candidate in ipairs(
		candidates
	) do

		if
			candidate.Model ==
				LockedTarget
		then

			return candidate

		end

	end

	return nil
end

--------------------------------------------------------
-- CLEAR VISUAL
--------------------------------------------------------

local function ClearTargetVisual()

	if TargetHighlight then

		TargetHighlight:Destroy()

		TargetHighlight = nil

	end

	if TargetBillboard then

		TargetBillboard:Destroy()

		TargetBillboard = nil

	end
end

--------------------------------------------------------
-- APPLY VISUAL
--------------------------------------------------------

local function ApplyTargetVisual(model)

	ClearTargetVisual()

	if not model then
		return
	end

	local head =
		GetHead(model)

	local root =
		GetRoot(model)

	if not head then
		return
	end

	----------------------------------------------------
	-- HIGHLIGHT
	----------------------------------------------------

	TargetHighlight = New(
		"Highlight",
		{
			Name =
				"DeveloperTargetHighlight",

			Adornee =
				model,

			FillColor =
				COLORS.Red,

			FillTransparency =
				0.78,

			OutlineColor =
				COLORS.Red,

			OutlineTransparency =
				0,

			DepthMode =
				Enum.HighlightDepthMode.AlwaysOnTop,
		},
		ScreenGui
	)

	----------------------------------------------------
	-- BILLBOARD
	----------------------------------------------------

	TargetBillboard = New(
		"BillboardGui",
		{
			Name =
				"TargetBillboard",

			Adornee =
				head,

			Size =
				UDim2.fromOffset(
					160,
					42
				),

			StudsOffset =
				Vector3.new(
					0,
					3.5,
					0
				),

			AlwaysOnTop =
				true,

			LightInfluence =
				0,

			MaxDistance =
				1000,

			ZIndexBehavior =
				Enum.ZIndexBehavior.Sibling,
		},
		ScreenGui
	)

	local targetText =
		New(
			"TextLabel",
			{
				Size =
					UDim2.fromScale(
						1,
						1
					),

				BackgroundTransparency =
					1,

				Text =
					"TARGET",

				TextColor3 =
					COLORS.Red,

				TextSize =
					13,

				Font =
					Enum.Font.GothamBold,

				TextStrokeColor3 =
					COLORS.Black,

				TextStrokeTransparency =
					0,

				ZIndex = 5,
			},
			TargetBillboard
		)

	-- Optional player name
	if model then

		local player =
			Players:GetPlayerFromCharacter(
				model
			)

		if player then

			targetText.Text =
				"TARGET\n"
				.. player.DisplayName

		end

	end
end

--------------------------------------------------------
-- SELECT
--------------------------------------------------------

local function SelectTarget(candidate)

	if not candidate then

		CurrentTarget = nil

		ClearTargetVisual()

		return

	end

	if
		CurrentTarget
		and
		CurrentTarget.Model ==
			candidate.Model
	then

		-- Keep existing visual.
		-- Don't recreate it every frame.
		return

	end

	CurrentTarget =
		candidate

	ApplyTargetVisual(
		candidate.Model
	)
end

--------------------------------------------------------
-- TARGET UPDATE
--------------------------------------------------------

local function UpdateTarget()

	if not (
		Settings.TargetLock
		or
		Settings.AimAssist
	)
	then

		CurrentTarget = nil
		LockedTarget = nil

		ClearTargetVisual()

		return
	end

	local candidates =
		GetCandidates()

	if #candidates == 0 then

		CurrentTarget = nil
		LockedTarget = nil

		ClearTargetVisual()

		return
	end

	local selected

	----------------------------------------------------
	-- LOCK
	----------------------------------------------------

	if
		Settings.TargetMode ==
			"LOCK"
	then

		selected =
			FindLocked(candidates)

		if not selected then
			selected =
				FindNearest(candidates)
		end

	----------------------------------------------------
	-- NEAREST
	----------------------------------------------------

	elseif
		Settings.TargetMode ==
			"NEAREST"
	then

		selected =
			FindNearest(candidates)

	----------------------------------------------------
	-- SMART
	----------------------------------------------------

	else

		selected =
			FindSmart(candidates)

	end

	if selected then

		SelectTarget(
			selected
		)

		LockedTarget =
			selected.Model

	else

		CurrentTarget = nil

		ClearTargetVisual()

	end
end

--------------------------------------------------------
-- CAMERA CONTROL
--
-- IMPORTANT:
-- This NEVER anchors the player's character.
-- It only controls CurrentCamera.
--------------------------------------------------------

local function StartCameraControl()

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	if not CameraWasScriptable then

		CameraWasScriptable = true

		PreviousCameraType =
			camera.CameraType

		PreviousCameraSubject =
			camera.CameraSubject

	end

	-- Scriptable camera prevents Roblox's default
	-- camera controller from fighting our target camera.
	camera.CameraType =
		Enum.CameraType.Scriptable

end

local function StopCameraControl()

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	if not CameraWasScriptable then
		return
	end

	CameraWasScriptable = false

	-- Restore normal Roblox camera.
	camera.CameraType =
		Enum.CameraType.Custom

	local humanoid =
		GetHumanoid(
			LocalPlayer.Character
		)

	if humanoid then

		camera.CameraSubject =
			humanoid

	else

		camera.CameraSubject =
			PreviousCameraSubject

	end

	PreviousCameraType = nil
	PreviousCameraSubject = nil

end

--------------------------------------------------------
-- CAMERA UPDATE
--------------------------------------------------------

local function UpdateCamera(deltaTime)

	local active =
		Settings.TargetLock
		or
		Settings.AimAssist

	if not active then

		StopCameraControl()

		return
	end

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	local target =
		CurrentTarget

	if not target then

		StartCameraControl()

		return
	end

	local model =
		target.Model

	if not model
		or not model.Parent
	then

		CurrentTarget = nil

		ClearTargetVisual()

		return
	end

	if not IsValidModel(model) then

		CurrentTarget = nil

		ClearTargetVisual()

		return
	end

	local head =
		GetHead(model)

	if not head then
		return
	end

	----------------------------------------------------
	-- DO NOT TOUCH CHARACTER
	----------------------------------------------------

	-- No Anchored
	-- No HumanoidRootPart CFrame
	-- No WalkSpeed
	-- No PlatformStand
	-- No AutoRotate changes
	--
	-- ONLY CAMERA.CFrame IS CHANGED.

	StartCameraControl()

	----------------------------------------------------
	-- TARGET POSITION
	----------------------------------------------------

	local cameraPosition =
		camera.CFrame.Position

	local desired =
		CFrame.lookAt(
			cameraPosition,
			head.Position
		)

	----------------------------------------------------
	-- SMOOTHNESS
	----------------------------------------------------

	local smooth =
		math.clamp(
			Settings.AimSmoothness,
			1,
			100
		)

	-- 1 = slow/smooth
	-- 100 = very fast
	local response =
		2.5
		+
		(smooth / 100) * 35

	local alpha =
		1
		-
		math.exp(
			-response
				*
				math.max(
					deltaTime,
					1 / 240
				)
		)

	alpha =
		math.clamp(
			alpha,
			0.02,
			1
		)

	camera.CFrame =
		camera.CFrame:Lerp(
			desired,
			alpha
		)

end

--------------------------------------------------------
-- CAMERA RENDER STEP
--------------------------------------------------------

pcall(function()

	RunService:UnbindFromRenderStep(
		"KyzenPerksCamera"
	)

end)

RunService:BindToRenderStep(
	"KyzenPerksCamera",
	Enum.RenderPriority.Camera.Value + 100,
	function(deltaTime)

		UpdateCamera(
			deltaTime
		)

	end
)

--------------------------------------------------------
-- TARGET LOOP
--------------------------------------------------------

task.spawn(function()

	while ScreenGui.Parent do

		if
			Settings.TargetLock
			or
			Settings.AimAssist
		then

			UpdateTarget()

		else

			if CurrentTarget then

				CurrentTarget = nil
				LockedTarget = nil

				ClearTargetVisual()

			end

		end

		-- Fast target refresh without running
		-- workspace scans every RenderStep.
		task.wait(0.05)

	end

end)

--------------------------------------------------------
-- VISUAL SAFETY
--------------------------------------------------------

task.spawn(function()

	while ScreenGui.Parent do

		if CurrentTarget then

			local model =
				CurrentTarget.Model

			if
				not model
				or
				not model.Parent
				or
				not IsValidModel(model)
			then

				CurrentTarget = nil
				LockedTarget = nil

				ClearTargetVisual()

			end

		end

		task.wait(0.15)

	end

end)

--------------------------------------------------------
-- FOV POSITION
--------------------------------------------------------

RunService.RenderStepped:Connect(function()

	if FOVCircle then

		FOVCircle.Position =
			UDim2.fromScale(
				0.5,
				0.5
			)

	end

	if FOVLabel then

		FOVLabel.Position =
			UDim2.new(
				0.5,
				0,
				0.5,
				-(Settings.FOVRadius + 8)
			)

	end

end)

--------------------------------------------------------
-- RESPAWN SAFETY
--------------------------------------------------------

LocalPlayer.CharacterAdded:Connect(
	function(character)

		CurrentTarget = nil
		LockedTarget = nil

		ClearTargetVisual()

		-- Make absolutely sure the player's
		-- new character is not anchored.
		task.defer(function()

			for _, part in ipairs(
				character:GetDescendants()
			) do

				if part:IsA("BasePart") then
					part.Anchored = false
				end

			end

		end)

		task.wait(0.5)

		-- Restore camera subject after respawn.
		local camera =
			workspace.CurrentCamera

		local humanoid =
			character:FindFirstChildOfClass(
				"Humanoid"
			)

		if camera and humanoid then

			if not (
				Settings.TargetLock
				or
				Settings.AimAssist
			)
			then

				camera.CameraType =
					Enum.CameraType.Custom

				camera.CameraSubject =
					humanoid

			end

		end

	end
)

--------------------------------------------------------
-- LOADING
--------------------------------------------------------

task.spawn(function()

	local steps = {

		{
			Progress = 0.18,
			Status = "Loading interface..."
		},

		{
			Progress = 0.38,
			Status = "Loading target system..."
		},

		{
			Progress = 0.58,
			Status = "Loading camera controller..."
		},

		{
			Progress = 0.78,
			Status = "Loading developer controls..."
		},

		{
			Progress = 1,
			Status = "System ready."
		},

	}

	for _, step in ipairs(steps) do

		LoadingStatus.Text =
			step.Status

		Tween(
			LoadingFill,
			{
				Size = UDim2.new(
					step.Progress,
					0,
					1,
					0
				)
			},
			0.28,
			Enum.EasingStyle.Quad
		)

		task.wait(0.32)

	end

	task.wait(0.35)

	Tween(
		LoadingOverlay,
		{
			BackgroundTransparency = 1
		},
		0.25
	)

	for _, child in ipairs(
		LoadingOverlay:GetDescendants()
	) do

		if child:IsA("TextLabel") then

			Tween(
				child,
				{
					TextTransparency = 1
				},
				0.2
			)

		elseif child:IsA("Frame") then

			Tween(
				child,
				{
					BackgroundTransparency = 1
				},
				0.2
			)

		end

	end

	task.wait(0.3)

	LoadingOverlay.Visible =
		false

	OpenMain()

end)

--------------------------------------------------------
-- INITIAL
--------------------------------------------------------

Main.Visible = false

SetFOVRadius(
	Settings.FOVRadius
)

SetFOVVisible(
	false
)

--------------------------------------------------------
-- FINAL SAFETY
--------------------------------------------------------

-- Make sure this script NEVER anchors the player.
task.spawn(function()

	while ScreenGui.Parent do

		local character =
			LocalPlayer.Character

		if character then

			for _, part in ipairs(
				character:GetDescendants()
			) do

				if part:IsA("BasePart")
					and part.Anchored
				then

					-- Only unanchor parts that belong
					-- to the local character.
					part.Anchored = false

				end

			end

		end

		task.wait(0.5)

	end

end)

