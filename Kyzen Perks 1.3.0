end

--------------------------------------------------------
-- TOGGLE
--------------------------------------------------------

local function CreateToggle(
	parent,
	title,
	description,
	initialValue,
	callback
)

	local holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 62),

		BackgroundColor3 = COLORS.Panel2,

		BorderSizePixel = 0,

		LayoutOrder = 3,

		ZIndex = 23,
	}, parent)

	AddCorner(holder, 8)

	AddStroke(
		holder,
		Color3.fromRGB(38, 45, 57),
		1,
		0
	)

	New("TextLabel", {
		Position = UDim2.new(0, 13, 0, 9),

		Size = UDim2.new(1, -80, 0, 22),

		BackgroundTransparency = 1,

		Text = title,

		TextColor3 = COLORS.White,

		TextSize = 12,

		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 24,
	}, holder)

	New("TextLabel", {
		Position = UDim2.new(0, 13, 0, 31),

		Size = UDim2.new(1, -80, 0, 18),

		BackgroundTransparency = 1,

		Text = description,

		TextColor3 = COLORS.Muted,

		TextSize = 9,

		Font = Enum.Font.GothamMedium,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 24,
	}, holder)

	local button = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),

		Position = UDim2.new(1, -13, 0.5, 0),

		Size = UDim2.fromOffset(42, 23),

		BackgroundColor3 = Color3.fromRGB(35, 40, 49),

		BorderSizePixel = 0,

		Text = "",

		AutoButtonColor = false,

		ZIndex = 25,
	}, holder)

	AddCorner(button, 20)

	local dot = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),

		Position = UDim2.new(0, 3, 0.5, 0),

		Size = UDim2.fromOffset(17, 17),

		BackgroundColor3 = COLORS.Light,

		BorderSizePixel = 0,

		ZIndex = 26,
	}, button)

	AddCorner(dot, 20)

	local state = initialValue

	local function Refresh()
		if state then

			Tween(button, {
				BackgroundColor3 = COLORS.Blue
			}, 0.15)

			Tween(dot, {
				Position = UDim2.new(
					1,
					-20,
					0.5,
					0
				),

				BackgroundColor3 = COLORS.White
			}, 0.15)

		else

			Tween(button, {
				BackgroundColor3 =
					Color3.fromRGB(35, 40, 49)
			}, 0.15)

			Tween(dot, {
				Position = UDim2.new(
					0,
					3,
					0.5,
					0
				),

				BackgroundColor3 = COLORS.Light
			}, 0.15)

		end
	end

	button.MouseButton1Click:Connect(function()

		state = not state

		Refresh()

		if callback then
			callback(state)
		end
	end)

	Refresh()

	return holder
end

--------------------------------------------------------
-- NUMBER CONTROL
--------------------------------------------------------

local function CreateNumberControl(
	parent,
	title,
	description,
	defaultValue,
	minimum,
	maximum,
	step,
	callback
)

	local holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 72),

		BackgroundColor3 = COLORS.Panel2,

		BorderSizePixel = 0,

		LayoutOrder = 4,

		ZIndex = 23,
	}, parent)

	AddCorner(holder, 8)

	AddStroke(
		holder,
		Color3.fromRGB(38, 45, 57),
		1,
		0
	)

	New("TextLabel", {
		Position = UDim2.new(0, 13, 0, 8),

		Size = UDim2.new(1, -190, 0, 20),

		BackgroundTransparency = 1,

		Text = title,

		TextColor3 = COLORS.White,

		TextSize = 12,

		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 24,
	}, holder)

	New("TextLabel", {
		Position = UDim2.new(0, 13, 0, 29),

		Size = UDim2.new(1, -190, 0, 27),

		BackgroundTransparency = 1,

		Text = description,

		TextColor3 = COLORS.Muted,

		TextSize = 9,

		Font = Enum.Font.GothamMedium,

		TextWrapped = true,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 24,
	}, holder)

	local minus = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),

		Position = UDim2.new(1, -95, 0.5, 5),

		Size = UDim2.fromOffset(30, 30),

		BackgroundColor3 = Color3.fromRGB(28, 33, 42),

		BorderSizePixel = 0,

		Text = "−",

		TextColor3 = COLORS.White,

		TextSize = 18,

		Font = Enum.Font.GothamBold,

		AutoButtonColor = false,

		ZIndex = 25,
	}, holder)

	AddCorner(minus, 7)

	AddStroke(
		minus,
		Color3.fromRGB(55, 63, 77),
		1,
		0
	)

	local valueLabel = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),

		Position = UDim2.new(1, -48, 0.5, 5),

		Size = UDim2.fromOffset(45, 30),

		BackgroundColor3 = Color3.fromRGB(10, 13, 18),

		BorderSizePixel = 0,

		Text = tostring(defaultValue),

		TextColor3 = COLORS.Blue,

		TextSize = 11,

		Font = Enum.Font.GothamBold,

		ZIndex = 25,
	}, holder)

	AddCorner(valueLabel, 7)

	AddStroke(
		valueLabel,
		COLORS.Blue,
		1,
		0.25
	)

	local plus = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),

		Position = UDim2.new(1, -10, 0.5, 5),

		Size = UDim2.fromOffset(30, 30),

		BackgroundColor3 = Color3.fromRGB(28, 33, 42),

		BorderSizePixel = 0,

		Text = "+",

		TextColor3 = COLORS.White,

		TextSize = 18,

		Font = Enum.Font.GothamBold,

		AutoButtonColor = false,

		ZIndex = 25,
	}, holder)

	AddCorner(plus, 7)

	AddStroke(
		plus,
		Color3.fromRGB(55, 63, 77),
		1,
		0
	)

	local value = defaultValue

	local function SetValue(newValue)

		value = math.clamp(
			newValue,
			minimum,
			maximum
		)

		value = math.floor(
			value + 0.5
		)

		valueLabel.Text = tostring(value)

		if callback then
			callback(value)
		end
	end

	minus.MouseButton1Click:Connect(function()
		SetValue(value - step)
	end)

	plus.MouseButton1Click:Connect(function()
		SetValue(value + step)
	end)

	return holder
end

