	FOVCircle,
	COLORS.Blue,
	2,
	0
)

FOVLabel = New("TextLabel", {
	Name = "FOVLabel",

	AnchorPoint = Vector2.new(0.5, 1),

	Position = UDim2.new(
		0.5,
		0,
		0.5,
		-(Settings.FOVRadius + 8)
	),

	Size = UDim2.fromOffset(130, 24),

	BackgroundTransparency = 1,

	Text = "FOV DETECTION",

	TextColor3 = COLORS.Blue,
	TextSize = 11,

	Font = Enum.Font.GothamBold,

	TextTransparency = 0.15,

	Visible = false,

	ZIndex = 4,
}, ScreenGui)

local function SetFOVRadius(value)
	value = math.clamp(math.floor(value), 50, 500)

	Settings.FOVRadius = value

	FOVCircle.Size = UDim2.fromOffset(
		value * 2,
		value * 2
	)

	FOVLabel.Position = UDim2.new(
		0.5,
		0,
		0.5,
		-(value + 8)
	)
end

local function SetFOVVisible(state)
	Settings.ShowFOV = state

	FOVCircle.Visible = state
	FOVLabel.Visible = state
end

