	"Settings",
	2
)

CreateTab(
	"INFO & CREDIT",
	"InfoCredit",
	3
)

CreateTab(
	"DISCORD",
	"Discord",
	4
)

local function ShowPage(pageName)

	for name, page in pairs(Pages) do
		page.Visible = (
			name == pageName
		)
	end

	for name, info in pairs(TabButtons) do

		local active = (
			name == pageName
		)

		if active then

			Tween(info.Button, {
				BackgroundColor3 =
					Color3.fromRGB(25, 37, 54)
			}, 0.15)

			info.Button.TextColor3 =
				COLORS.White

			info.Accent.Visible = true

		else

			Tween(info.Button, {
				BackgroundColor3 =
					Color3.fromRGB(18, 22, 29)
			}, 0.15)

			info.Button.TextColor3 =
				COLORS.Muted

			info.Accent.Visible = false

		end

	end
end

for pageName, info in pairs(TabButtons) do

	info.Button.MouseButton1Click:Connect(function()

		ShowPage(pageName)

	end)

end

ShowPage("AimTarget")

