--// =========================================================
--// DRAG SYSTEM
--// =========================================================

local Dragging = false
local DragStart
local StartPosition

Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		Dragging = true
		DragStart = input.Position
		StartPosition = Main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				Dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not Dragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local Delta = input.Position - DragStart

	Main.Position = UDim2.new(
		StartPosition.X.Scale,
		StartPosition.X.Offset + Delta.X,
		StartPosition.Y.Scale,
		StartPosition.Y.Offset + Delta.Y
	)
end)

--// =========================================================
--// OPEN / CLOSE
--// =========================================================

local MainOriginalSize = Main.Size

local function OpenMenu()
	DevButton.Visible = false
	Main.Visible = true

	Main.Size = UDim2.fromOffset(620, 395)

	Tween(
		Main,
		TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{
			Size = MainOriginalSize
		}
	)
end

local function CloseMenu()
	Tween(
		Main,
		TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
		{
			Size = UDim2.fromOffset(620, 395)
		}
	)

	task.delay(0.18, function()
		Main.Visible = false
		DevButton.Visible = true
	end)
end

Close.MouseButton1Click:Connect(CloseMenu)
DevButton.MouseButton1Click:Connect(OpenMenu)

--// =========================================================
--// TARGET SYSTEM
--// =========================================================

local CurrentTarget = nil
local LockedTarget = nil
local TargetHighlight = nil
local TargetBillboard = nil

local function GetCharacterRoot(character)
	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
end

local function IsAlive(character)
	if not character then
		return false
	end

	local Humanoid = character:FindFirstChildOfClass("Humanoid")

	return Humanoid
		and Humanoid.Health > 0
end

local function GetTargetPart(character)
	if not character then
		return nil
	end

	return character:FindFirstChild("Head")
		or GetCharacterRoot(character)
end

local function IsValidTarget(model)
	if not model then
		return false
	end

	if model == LocalPlayer.Character then
		return false
	end

	if not model.Parent then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")

	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	local root = GetCharacterRoot(model)

	if not root then
		return false
	end

	local myCharacter = LocalPlayer.Character
	local myRoot = GetCharacterRoot(myCharacter)

	if not myRoot then
		return false
	end

	local distance = (root.Position - myRoot.Position).Magnitude

	if distance > Settings.TargetRange then
		return false
	end

	return true
end

local function GetCandidates()
	local candidates = {}

	-- PLAYERS
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character

			if character and IsValidTarget(character) then
				table.insert(candidates, character)
			end
		end
	end

	-- NPC / DUMMIES
	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("Model")
			and object ~= LocalPlayer.Character
			and object:FindFirstChildOfClass("Humanoid")
			and not Players:GetPlayerFromCharacter(object) then

			if IsValidTarget(object) then
				table.insert(candidates, object)
			end
		end
	end

	return candidates
end

local function FindNearest(candidates)
	local myCharacter = LocalPlayer.Character
	local myRoot = GetCharacterRoot(myCharacter)

	if not myRoot then
		return nil
	end

	local nearest = nil
	local nearestDistance = math.huge

	for _, character in ipairs(candidates) do
		local root = GetCharacterRoot(character)

		if root then
			local distance = (root.Position - myRoot.Position).Magnitude

			if distance < nearestDistance then
				nearestDistance = distance
				nearest = character
			end
		end
	end

	return nearest
end

local function FindSmart(candidates)
	local camera = workspace.CurrentCamera

	if not camera then
		return FindNearest(candidates)
	end

	local center = Vector2.new(
		camera.ViewportSize.X / 2,
		camera.ViewportSize.Y / 2
	)

	local best = nil
	local bestScore = math.huge

	for _, character in ipairs(candidates) do
		local targetPart = GetTargetPart(character)

		if targetPart then
			local screenPosition, visible = camera:WorldToViewportPoint(targetPart.Position)

			if visible and screenPosition.Z > 0 then
				local distanceFromCenter =
					(Vector2.new(screenPosition.X, screenPosition.Y) - center).Magnitude

				local distanceFromPlayer = 0

				local myRoot = GetCharacterRoot(LocalPlayer.Character)
				local targetRoot = GetCharacterRoot(character)

				if myRoot and targetRoot then
					distanceFromPlayer =
						(targetRoot.Position - myRoot.Position).Magnitude
				end

				local score = distanceFromCenter + (distanceFromPlayer * 0.05)

				if score < bestScore then
					bestScore = score
					best = character
				end
			end
		end
	end

	return best or FindNearest(candidates)
end

local function FindLock(candidates)
	if LockedTarget and IsValidTarget(LockedTarget) then
		return LockedTarget
	end

	return FindNearest(candidates)
end

local function RemoveTargetVisuals()
	if TargetHighlight then
		TargetHighlight:Destroy()
		TargetHighlight = nil
	end

	if TargetBillboard then
		TargetBillboard:Destroy()
		TargetBillboard = nil
	end
end

local function AddTargetVisuals(character)
	RemoveTargetVisuals()

	if not character then
		return
	end

	TargetHighlight = Instance.new("Highlight")
	TargetHighlight.Name = "KyzenTargetHighlight"
	TargetHighlight.FillColor = COLORS.Blue
	TargetHighlight.OutlineColor = COLORS.White
	TargetHighlight.FillTransparency = 0.75
	TargetHighlight.OutlineTransparency = 0
	TargetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	TargetHighlight.Adornee = character
	TargetHighlight.Parent = ScreenGui

	local root = GetCharacterRoot(character)

	if root then
		TargetBillboard = Instance.new("BillboardGui")
		TargetBillboard.Name = "KyzenTargetBillboard"
		TargetBillboard.Adornee = root
		TargetBillboard.Size = UDim2.fromOffset(180, 35)
		TargetBillboard.StudsOffset = Vector3.new(0, 3.5, 0)
		TargetBillboard.AlwaysOnTop = true
		TargetBillboard.Parent = ScreenGui

		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.fromScale(1, 1)
		Label.BackgroundTransparency = 1
		Label.Text = "TARGET"
		Label.TextColor3 = COLORS.Blue
		Label.TextStrokeColor3 = COLORS.BlackStroke
		Label.TextStrokeTransparency = 0
		Label.TextSize = 12
		Label.Font = Enum.Font.GothamBold
		Label.Parent = TargetBillboard
	end
end

local function SelectTarget(character)
	if character and IsValidTarget(character) then
		CurrentTarget = character
		AddTargetVisuals(character)
	else
		CurrentTarget = nil
		RemoveTargetVisuals()
	end
end

local function UpdateTarget()
	local candidates = GetCandidates()

	if #candidates == 0 then
		CurrentTarget = nil
		RemoveTargetVisuals()
		return
	end

	local target

	if Settings.TargetMode == "NEAREST" then
		target = FindNearest(candidates)

	elseif Settings.TargetMode == "LOCK" then
		target = FindLock(candidates)

	else
		target = FindSmart(candidates)
	end

	if target ~= CurrentTarget then
		SelectTarget(target)
	end

	if Settings.TargetMode == "LOCK" and target then
		LockedTarget = target
	end
end

--// =========================================================
--// CAMERA
--// =========================================================

local function UpdateCamera()
	if not CurrentTarget then
		return
	end

	if not IsValidTarget(CurrentTarget) then
		CurrentTarget = nil
		RemoveTargetVisuals()
		return
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local targetPart = GetTargetPart(CurrentTarget)

	if not targetPart then
		return
	end

	if Settings.TargetLock or Settings.AimAssist then
		local cameraPosition = camera.CFrame.Position
		local targetPosition = targetPart.Position

		local desiredCFrame = CFrame.lookAt(
			cameraPosition,
			targetPosition
		)

		local smoothness = math.clamp(
			Settings.AimSmoothness * Settings.CameraSpeed,
			0.01,
			1
		)

		camera.CFrame = camera.CFrame:Lerp(
			desiredCFrame,
			smoothness
		)
	end
end

--// =========================================================
--// AUTO SHOOT
--// =========================================================

local LastAutoShot = 0

local function FindAttackButton()
	local MobileButtons = PlayerGui:FindFirstChild("MobileButtons")

	if not MobileButtons then
		return nil
	end

	local Buttons = MobileButtons:FindFirstChild("Buttons")

	if not Buttons then
		return nil
	end

	local Attack = Buttons:FindFirstChild("Attack")

	if Attack and Attack:IsA("ImageButton") then
		return Attack
	end

	return nil
end

local function UpdateAutoShoot()
	if not Settings.AutoShoot then
		return
	end

	if not CurrentTarget then
		return
	end

	if not IsValidTarget(CurrentTarget) then
		return
	end

	local AttackButton = FindAttackButton()

	if not AttackButton then
		return
	end

	if not AttackButton.Visible then
		return
	end

	local now = os.clock()

	if now - LastAutoShot < Settings.AutoShootCooldown then
		return
	end

	LastAutoShot = now

	pcall(function()
		AttackButton:Activate()
	end)
end

--// =========================================================
--// RENDER LOOP
--// =========================================================

RunService:BindToRenderStep(
	"KyzenPerksCamera",
	Enum.RenderPriority.Camera.Value + 1,
	function()
		UpdateCamera()
	end
)

