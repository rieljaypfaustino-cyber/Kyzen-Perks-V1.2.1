local Pages = {
	["AIM & TARGET"] = AimPage,
	["SETTINGS"] = SettingsPage,
	["INFO & CREDIT"] = InfoPage,
	["DISCORD"] = DiscordPage,
}

local TabButtons = {}
local CurrentPage = "AIM & TARGET"

local function CreateTab(name)
	local Button = New("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = COLORS.Background,
		Text = name,
		TextColor3 = COLORS.Muted,
		TextSize = 10,
		Font = Enum.Font.GothamBold,
		AutoButtonColor = false,
	}, TabsPanel)

	AddCorner(Button, 7)
	AddStroke(Button, COLORS.Stroke, 1)

	TabButtons[name] = Button

	Button.MouseButton1Click:Connect(function()
		CurrentPage = name

		for tabName, tabButton in pairs(TabButtons) do
			local active = tabName == CurrentPage

			if active then
				tabButton.BackgroundColor3 = COLORS.Blue
				tabButton.TextColor3 = COLORS.White
			else
				tabButton.BackgroundColor3 = COLORS.Background
				tabButton.TextColor3 = COLORS.Muted
			end
		end

		for pageName, page in pairs(Pages) do
			page.Visible = pageName == CurrentPage
		end
	end)

	return Button
end

CreateTab("AIM & TARGET")
CreateTab("SETTINGS")
CreateTab("INFO & CREDIT")
CreateTab("DISCORD")

TabButtons["AIM & TARGET"].BackgroundColor3 = COLORS.Blue
TabButtons["AIM & TARGET"].TextColor3 = COLORS.White

