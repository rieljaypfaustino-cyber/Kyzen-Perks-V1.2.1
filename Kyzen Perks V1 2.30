--// =========================================================
--// TOGGLE
--// =========================================================

local function CreateToggle(parent, title, description, defaultValue, callback)
	local Holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = COLORS.Panel2,
		BorderSizePixel = 0,
	}, parent)

	AddCorner(Holder, 8)
	AddStroke(Holder, COLORS.Stroke, 1)

	local TitleLabel = New("TextLabel", {
		Position = UDim2.fromOffset(13, 9),
		Size = UDim2.new(1, -90, 0, 20),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = COLORS.White,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Holder)

	local DescLabel = New("TextLabel", {
		Position = UDim2.fromOffset(13, 31),
		Size = UDim2.new(1, -90, 0, 22),
		BackgroundTransparency = 1,
		Text = description,
		TextColor3 = COLORS.Muted,
		TextSize = 9,
		Font = Enum.Font.GothamMedium,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Holder)

	local Button = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(54, 28),
		BackgroundColor3 = COLORS.RedDark,
		Text = "",
		AutoButtonColor = false,
	}, Holder)

	AddCorner(Button, 14)

	local Circle = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 4, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = COLORS.White,
		BorderSizePixel = 0,
	}, Button)

	AddCorner(Circle, 99)

	local enabled = defaultValue

	local function Refresh()
		if enabled then
			Tween(Button, TweenInfo.new(0.18), {
				BackgroundColor3 = COLORS.Blue,
			})

			Tween(Circle, TweenInfo.new(0.18), {
				Position = UDim2.new(1, -24, 0.5, 0),
			})
		else
			Tween(Button, TweenInfo.new(0.18), {
				BackgroundColor3 = COLORS.RedDark,
			})

			Tween(Circle, TweenInfo.new(0.18), {
				Position = UDim2.new(0, 4, 0.5, 0),
			})
		end
	end

	Button.MouseButton1Click:Connect(function()
		enabled = not enabled
		Refresh()

		if callback then
			callback(enabled)
		end
	end)

	Refresh()

	return Holder
end

--// =========================================================
--// NUMBER CONTROL
--// =========================================================

local function CreateNumberControl(parent, title, description, defaultValue, minimum, maximum, step, callback)
	local Holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 72),
		BackgroundColor3 = COLORS.Panel2,
		BorderSizePixel = 0,
	}, parent)

	AddCorner(Holder, 8)
	AddStroke(Holder, COLORS.Stroke, 1)

	New("TextLabel", {
		Position = UDim2.fromOffset(13, 9),
		Size = UDim2.new(1, -130, 0, 20),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = COLORS.White,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Holder)

	New("TextLabel", {
		Position = UDim2.fromOffset(13, 32),
		Size = UDim2.new(1, -130, 0, 25),
		BackgroundTransparency = 1,
		Text = description,
		TextColor3 = COLORS.Muted,
		TextSize = 9,
		Font = Enum.Font.GothamMedium,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Holder)

	local Minus = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -68, 0.5, 0),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = COLORS.Background,
		Text = "−",
		TextColor3 = COLORS.White,
		TextSize = 16,
		Font = Enum.Font.GothamBold,
		AutoButtonColor = false,
	}, Holder)

	AddCorner(Minus, 7)
	AddStroke(Minus, COLORS.Stroke, 1)

	local Value = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -38, 0.5, 0),
		Size = UDim2.fromOffset(45, 28),
		BackgroundTransparency = 1,
		TextColor3 = COLORS.Blue,
		TextSize = 11,
		Font = Enum.Font.GothamBold,
		Text = tostring(defaultValue),
		TextXAlignment = Enum.TextXAlignment.Center,
	}, Holder)

	local Plus = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = COLORS.Background,
		Text = "+",
		TextColor3 = COLORS.White,
		TextSize = 16,
		Font = Enum.Font.GothamBold,
		AutoButtonColor = false,
	}, Holder)

	AddCorner(Plus, 7)
	AddStroke(Plus, COLORS.Stroke, 1)

	local value = defaultValue

	local function Refresh()
		Value.Text = tostring(value)

		if callback then
			callback(value)
		end
	end

	Minus.MouseButton1Click:Connect(function()
		value = math.clamp(value - step, minimum, maximum)
		Refresh()
	end)

	Plus.MouseButton1Click:Connect(function()
		value = math.clamp(value + step, minimum, maximum)
		Refresh()
	end)

	Refresh()

	return Holder
end

--// =========================================================
--// MODE SELECTOR
--// =========================================================

local function CreateModeSelector(parent, title, description, modes, defaultMode, callback)
	local Holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 88),
		BackgroundColor3 = COLORS.Panel2,
		BorderSizePixel = 0,
	}, parent)

	AddCorner(Holder, 8)
	AddStroke(Holder, COLORS.Stroke, 1)

	New("TextLabel", {
		Position = UDim2.fromOffset(13, 8),
		Size = UDim2.new(1, -26, 0, 20),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = COLORS.White,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Holder)

	New("TextLabel", {
		Position = UDim2.fromOffset(13, 30),
		Size = UDim2.new(1, -26, 0, 18),
		BackgroundTransparency = 1,
		Text = description,
		TextColor3 = COLORS.Muted,
		TextSize = 9,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Holder)

	local Buttons = New("Frame", {
		Position = UDim2.fromOffset(10, 54),
		Size = UDim2.new(1, -20, 0, 27),
		BackgroundTransparency = 1,
	}, Holder)

	New("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 5),
	}, Buttons)

	local current = defaultMode

	for _, mode in ipairs(modes) do
		local Button = New("TextButton", {
			Size = UDim2.fromOffset(75, 27),
			BackgroundColor3 = COLORS.Background,
			Text = mode,
			TextColor3 = COLORS.Muted,
			TextSize = 9,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
		}, Buttons)

		AddCorner(Button, 6)
		AddStroke(Button, COLORS.Stroke, 1)

		local function Refresh()
			if current == mode then
				Button.BackgroundColor3 = COLORS.Blue
				Button.TextColor3 = COLORS.White
			else
				Button.BackgroundColor3 = COLORS.Background
				Button.TextColor3 = COLORS.Muted
			end
		end

		Button.MouseButton1Click:Connect(function()
			current = mode

			for _, child in ipairs(Buttons:GetChildren()) do
				if child:IsA("TextButton") then
					if child.Text == current then
						child.BackgroundColor3 = COLORS.Blue
						child.TextColor3 = COLORS.White
					else
						child.BackgroundColor3 = COLORS.Background
						child.TextColor3 = COLORS.Muted
					end
				end
			end

			if callback then
				callback(current)
			end
		end)

		Refresh()
	end

	return Holder
end

