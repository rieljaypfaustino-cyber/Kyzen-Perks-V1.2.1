		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 24,
	}, holder)

	local description = New("TextLabel", {
		Position = UDim2.new(0, 13, 0, 28),
		Size = UDim2.new(1, -26, 0, 16),

		BackgroundTransparency = 1,

		Text = "Choose how the target is selected.",

		TextColor3 = COLORS.Muted,
		TextSize = 9,

		Font = Enum.Font.GothamMedium,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 24,
	}, holder)

	local modes = {
		"SMART",
		"NEAREST",
		"LOCK",
	}

	local buttons = {}

	local function Refresh()
		for _, info in ipairs(buttons) do
			if info.mode == Settings.TargetMode then
				Tween(info.button, {
					BackgroundColor3 = COLORS.Blue,
				}, 0.12)

				info.button.TextColor3 = COLORS.White
			else
				Tween(info.button, {
					BackgroundColor3 = Color3.fromRGB(27, 32, 41),
				}, 0.12)

				info.button.TextColor3 = COLORS.Light
			end
		end
	end

	for index, mode in ipairs(modes) do
		local button = New("TextButton", {
			Position = UDim2.new(
				0,
				13 + ((index - 1) * 92),
				0,
				52
			),

			Size = UDim2.fromOffset(84, 22),

			BackgroundColor3 = Color3.fromRGB(27, 32, 41),

			BorderSizePixel = 0,

			Text = mode,

			TextColor3 = COLORS.Light,
			TextSize = 9,

			Font = Enum.Font.GothamBold,

			AutoButtonColor = false,

			ZIndex = 25,
		}, holder)

		AddCorner(button, 6)

		button.MouseButton1Click:Connect(function()
			Settings.TargetMode = mode

			Refresh()

			if callback then
				callback(mode)
			end
		end)

		table.insert(buttons, {
			mode = mode,
			button = button,
		})
	end

	Refresh()

	return holder
end

