--------------------------------------------------------
-- DRAGGING
--------------------------------------------------------

local function MakeDraggable(object)
	local dragging = false
	local dragStart
	local startPosition

	object.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true

			dragStart = input.Position
			startPosition = object.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - dragStart

		object.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)
end

MakeDraggable(Main)
MakeDraggable(DevButton)

--------------------------------------------------------
-- TARGET SYSTEM
--------------------------------------------------------

local CurrentTarget = nil
local LockedTarget = nil

local TargetHighlight = nil
local TargetBillboard = nil

--------------------------------------------------------
-- CHARACTER ROOT
--------------------------------------------------------

local function GetCharacterRoot(model)
	if not model then
		return nil
	end

	if not model:IsA("Model") then
		return nil
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return nil
	end

	local root =
		model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("Torso")
		or model.PrimaryPart

	return root
end

--------------------------------------------------------
-- ALIVE CHECK
--------------------------------------------------------

local function IsAlive(model)
	if not model then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	return humanoid.Health > 0
end

--------------------------------------------------------
-- TARGET PART
--------------------------------------------------------

local function GetTargetPart(model)
	if not model then
		return nil
	end

	return model:FindFirstChild("Head")
		or model:FindFirstChild("HumanoidRootPart")
		or GetCharacterRoot(model)
end

--------------------------------------------------------
-- VALID TARGET
--------------------------------------------------------

local function IsValidTarget(model)
	if not model then
		return false
	end

	if not model:IsA("Model") then
		return false
	end

	if model == LocalPlayer.Character then
		return false
	end

	if not IsAlive(model) then
		return false
	end

	local root = GetCharacterRoot(model)

	if not root then
		return false
	end

	local localCharacter = LocalPlayer.Character

	if not localCharacter then
		return false
	end

	local localRoot = GetCharacterRoot(localCharacter)

	if not localRoot then
		return false
	end

	local distance = (root.Position - localRoot.Position).Magnitude

	if distance > Settings.TargetRange then
		return false
	end

	return true
end

--------------------------------------------------------
-- GET CANDIDATES
--------------------------------------------------------

local function GetCandidates()
	local candidates = {}
	local seen = {}

	----------------------------------------------------
	-- PLAYERS
	----------------------------------------------------

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character

			if character and not seen[character] then
				seen[character] = true

				if IsValidTarget(character) then
					local root = GetCharacterRoot(character)

					if root then
						table.insert(candidates, {
							Model = character,
							Player = player,
							Root = root,
							Distance = (
								root.Position
								- GetCharacterRoot(LocalPlayer.Character).Position
							).Magnitude,
						})
					end
				end
			end
		end
	end

	----------------------------------------------------
	-- NPC / DUMMIES
	----------------------------------------------------

	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Humanoid") then
			local model = descendant.Parent

			if model
				and model:IsA("Model")
				and not seen[model]
				and model ~= LocalPlayer.Character then

				seen[model] = true

				if IsValidTarget(model) then
					local root = GetCharacterRoot(model)

					if root then
						table.insert(candidates, {
							Model = model,
							Player = nil,
							Root = root,
							Distance = (
								root.Position
								- GetCharacterRoot(LocalPlayer.Character).Position
							).Magnitude,
						})
					end
				end
			end
		end
	end

	return candidates
end

--------------------------------------------------------
-- FIND NEAREST
--------------------------------------------------------

local function FindNearest(candidates)
	local best = nil

	for _, candidate in ipairs(candidates) do
		if not best or candidate.Distance < best.Distance then
			best = candidate
		end
	end

	return best
end

--------------------------------------------------------
-- FIND SMART
--------------------------------------------------------

local function FindSmart(candidates)
	if #candidates == 0 then
		return nil
	end

	----------------------------------------------------
	-- CURRENT TARGET STICKINESS
	----------------------------------------------------

	if CurrentTarget then
		local currentModel = CurrentTarget.Model

		for _, candidate in ipairs(candidates) do
			if candidate.Model == currentModel then
				local nearest = FindNearest(candidates)

				if nearest and nearest.Model ~= currentModel then
					-- Only switch if the new target is meaningfully closer.
					if nearest.Distance < candidate.Distance * 0.78 then
						return nearest
					end
				end

				return candidate
			end
		end
	end

	return FindNearest(candidates)
end

--------------------------------------------------------
-- FIND LOCK
--------------------------------------------------------

local function FindLock(candidates)
	if not LockedTarget then
		return nil
	end

	for _, candidate in ipairs(candidates) do
		if candidate.Model == LockedTarget then
			return candidate
		end
	end

	return nil
end

--------------------------------------------------------
-- TARGET VISUAL
--------------------------------------------------------

local function ClearTargetVisual()
	if TargetHighlight then
		TargetHighlight:Destroy()
		TargetHighlight = nil
	end

	if TargetBillboard then
		TargetBillboard:Destroy()
		TargetBillboard = nil
	end
end

local function ApplyTargetVisual(model)
	ClearTargetVisual()

	if not model then
		return
	end

	local root = GetCharacterRoot(model)

	if not root then
		return
	end

	----------------------------------------------------
	-- HIGHLIGHT
	----------------------------------------------------

	TargetHighlight = New("Highlight", {
		Name = "DeveloperTargetHighlight",

		Adornee = model,

		FillColor = COLORS.Red,
		FillTransparency = 0.78,

		OutlineColor = COLORS.Red,
		OutlineTransparency = 0,

		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
	}, ScreenGui)

	----------------------------------------------------
	-- BILLBOARD
	----------------------------------------------------

	TargetBillboard = New("BillboardGui", {
		Name = "TargetBillboard",

		Adornee = root,

		Size = UDim2.fromOffset(100, 32),

		StudsOffset = Vector3.new(0, 3.3, 0),

		AlwaysOnTop = true,

		LightInfluence = 0,

		MaxDistance = 1000,

		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, ScreenGui)

	local targetText = New("TextLabel", {
		Size = UDim2.fromScale(1, 1),

		BackgroundTransparency = 1,

		Text = "TARGET",

		TextColor3 = COLORS.Red,
		TextSize = 13,

		Font = Enum.Font.GothamBold,

		TextStrokeColor3 = COLORS.Black,
		TextStrokeTransparency = 0,

		ZIndex = 5,
	}, TargetBillboard)

	AddStroke(targetText, COLORS.Red, 1, 0.8)
end

--------------------------------------------------------
-- SELECT TARGET
--------------------------------------------------------

local function SelectTarget(candidate)
	if not candidate then
		CurrentTarget = nil
		ClearTargetVisual()
		return
	end

	if CurrentTarget and CurrentTarget.Model == candidate.Model then
		return
	end

	CurrentTarget = candidate

	ApplyTargetVisual(candidate.Model)
end

--------------------------------------------------------
-- TARGET UPDATE
--------------------------------------------------------

local function UpdateTarget()
	if not (Settings.TargetLock or Settings.AimAssist) then
		if CurrentTarget then
			CurrentTarget = nil
			LockedTarget = nil
			ClearTargetVisual()
		end

		return
	end

	local candidates = GetCandidates()

	if #candidates == 0 then
		CurrentTarget = nil
		LockedTarget = nil
		ClearTargetVisual()
		return
	end

	local selected = nil

	----------------------------------------------------
	-- LOCK MODE
	----------------------------------------------------

	if Settings.TargetMode == "LOCK" then
		selected = FindLock(candidates)

		if not selected then
			selected = FindNearest(candidates)
		end

	----------------------------------------------------
	-- NEAREST MODE
	----------------------------------------------------

	elseif Settings.TargetMode == "NEAREST" then
		selected = FindNearest(candidates)

	----------------------------------------------------
	-- SMART MODE
	----------------------------------------------------

	else
		selected = FindSmart(candidates)
	end

	if selected then
		SelectTarget(selected)

		LockedTarget = selected.Model
	else
		CurrentTarget = nil
		ClearTargetVisual()
	end
end

--------------------------------------------------------
-- CAMERA UPDATE
--------------------------------------------------------

local function UpdateCamera()
	if not (Settings.TargetLock or Settings.AimAssist) then
		return
	end

	if not CurrentTarget then
		return
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local model = CurrentTarget.Model

	if not model or not model.Parent then
		return
	end

	if not IsValidTarget(model) then
		return
	end

	local targetPart = GetTargetPart(model)

	if not targetPart then
		return
	end

	----------------------------------------------------
	-- SMOOTHNESS
	----------------------------------------------------

	local smoothness = math.clamp(
		Settings.AimSmoothness,
		0.01,
		1
	)

	local cameraPosition = camera.CFrame.Position

	local desiredCFrame = CFrame.lookAt(
		cameraPosition,
		targetPart.Position
	)

	----------------------------------------------------
	-- CAMERA SPEED
	----------------------------------------------------

	local alpha = math.clamp(
		smoothness * Settings.CameraSpeed,
		0.01,
		1
	)

	camera.CFrame = camera.CFrame:Lerp(
		desiredCFrame,
		alpha
	)
end

--------------------------------------------------------
-- RENDER STEP
--------------------------------------------------------

pcall(function()
	RunService:UnbindFromRenderStep("KyzenPerksCamera")
end)

RunService:BindToRenderStep(
	"KyzenPerksCamera",
	Enum.RenderPriority.Camera.Value + 1,
	function()
		UpdateCamera()
	end
)

--------------------------------------------------------
-- TARGET LOOP
--------------------------------------------------------

task.spawn(function()
	while ScreenGui.Parent do
		if Settings.TargetLock or Settings.AimAssist then
			UpdateTarget()
		end

		task.wait(0.08)
	end
end)

--------------------------------------------------------
-- TARGET VISUAL SAFETY
--------------------------------------------------------

task.spawn(function()
	while ScreenGui.Parent do
		if CurrentTarget then
			local model = CurrentTarget.Model

			if not model
				or not model.Parent
				or not IsValidTarget(model) then

				CurrentTarget = nil
				LockedTarget = nil

				ClearTargetVisual()
			end
		end

		task.wait(0.15)
	end
end)

--------------------------------------------------------
-- FOV CIRCLE POSITION SAFETY
--------------------------------------------------------

RunService.RenderStepped:Connect(function()
	if FOVCircle then
		FOVCircle.Position = UDim2.fromScale(0.5, 0.5)
	end

	if FOVLabel then
		FOVLabel.Position = UDim2.new(
			0.5,
			0,
			0.5,
			-(Settings.FOVRadius + 8)
		)
	end
end)

--------------------------------------------------------
-- RESPAWN SAFETY
--------------------------------------------------------

LocalPlayer.CharacterAdded:Connect(function()
	CurrentTarget = nil
	LockedTarget = nil

	ClearTargetVisual()

	task.wait(0.5)

	if Settings.ShowFOV then
		SetFOVVisible(true)
	end
end)

--------------------------------------------------------
-- LOADING ANIMATION
--------------------------------------------------------

task.spawn(function()

	local steps = {
		{
			Progress = 0.18,
			Status = "Loading interface..."
		},

		{
			Progress = 0.38,
			Status = "Loading target system..."
		},

		{
			Progress = 0.58,
			Status = "Loading FOV detection..."
		},

		{
			Progress = 0.78,
			Status = "Loading developer controls..."
		},

		{
			Progress = 1,
			Status = "System ready."
		},
	}

	for _, step in ipairs(steps) do

		LoadingStatus.Text = step.Status

		Tween(
			LoadingFill,
			{
				Size = UDim2.new(
					step.Progress,
					0,
					1,
					0
				)
			},
			0.28,
			Enum.EasingStyle.Quad
		)

		task.wait(0.32)
	end

	task.wait(0.35)

	Tween(
		LoadingOverlay,
		{
			BackgroundTransparency = 1,
		},
		0.25
	)

	for _, child in ipairs(LoadingOverlay:GetDescendants()) do
		if child:IsA("TextLabel") then
			Tween(
				child,
				{
					TextTransparency = 1,
				},
				0.2
			)
		elseif child:IsA("Frame") then
			if child ~= LoadingOverlay then
				Tween(
					child,
					{
						BackgroundTransparency = 1,
					},
					0.2
				)
			end
		end
	end

	task.wait(0.3)

	LoadingOverlay.Visible = false

	OpenMain()
end)

