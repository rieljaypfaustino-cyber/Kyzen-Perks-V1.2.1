		Font = Enum.Font.GothamBold,

		AutoButtonColor = false,

		ZIndex = 25,
	}, holder)

	AddCorner(minus, 7)
	AddStroke(minus, Color3.fromRGB(55, 63, 77), 1, 0)

	local valueLabel = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),

		Position = UDim2.new(1, -48, 0.5, 5),

		Size = UDim2.fromOffset(45, 30),

		BackgroundColor3 = Color3.fromRGB(10, 13, 18),

		BorderSizePixel = 0,

		Text = tostring(defaultValue),

		TextColor3 = COLORS.Blue,
		TextSize = 11,

		Font = Enum.Font.GothamBold,

		ZIndex = 25,
	}, holder)

	AddCorner(valueLabel, 7)
	AddStroke(valueLabel, COLORS.Blue, 1, 0.25)

	local plus = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),

		Position = UDim2.new(1, -10, 0.5, 5),

		Size = UDim2.fromOffset(30, 30),

		BackgroundColor3 = Color3.fromRGB(28, 33, 42),

		BorderSizePixel = 0,

		Text = "+",

		TextColor3 = COLORS.White,
		TextSize = 18,

		Font = Enum.Font.GothamBold,

		AutoButtonColor = false,

		ZIndex = 25,
	}, holder)

	AddCorner(plus, 7)
	AddStroke(plus, Color3.fromRGB(55, 63, 77), 1, 0)

	local value = defaultValue

	local function Display()
		valueLabel.Text = tostring(value)
	end

	local function SetValue(newValue)
		value = math.clamp(newValue, minimum, maximum)

		if math.floor(value) == value then
			value = math.floor(value)
		else
			value = math.floor(value * 100 + 0.5) / 100
		end

		Display()

		if callback then
			callback(value)
		end
	end

	minus.MouseButton1Click:Connect(function()
		SetValue(value - step)
	end)

	plus.MouseButton1Click:Connect(function()
		SetValue(value + step)
	end)

	Display()

	return holder, SetValue
end

