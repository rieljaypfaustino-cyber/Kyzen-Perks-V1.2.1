	while ScreenGui.Parent do

		if CurrentTarget then

			if not IsValidTarget(CurrentTarget) then

				LockedTarget = nil

				SetTarget(nil)

			else

				-- Rebuild visuals if Roblox removed them.
				if Settings.ShowHighlight
					and not CurrentHighlight then

					UpdateTargetVisuals()

				end

				if Settings.ShowTargetText
					and not CurrentBillboard then

					UpdateTargetVisuals()

				end
			end
		end

		task.wait(0.15)
	end
end)

