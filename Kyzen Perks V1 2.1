	AddCorner(toggle, 999)

	local knob = New("Frame", {
		Position = UDim2.fromOffset(3, 3),

		Size = UDim2.fromOffset(22, 22),

		BackgroundColor3 = Colors.White,

		BorderSizePixel = 0,

		ZIndex = 16
	}, toggle)

	AddCorner(knob, 999)

	local function Refresh()

		local enabled = getValue()

		if enabled then

			Tween(toggle, 0.18, {
				BackgroundColor3 = Colors.Blue
			}):Play()

			Tween(knob, 0.18, {
				Position = UDim2.new(
					1,
					-25,
					0,
					3
				)
			}):Play()

		else

			Tween(toggle, 0.18, {
				BackgroundColor3 =
					Colors.DarkGray
			}):Play()

			Tween(knob, 0.18, {
				Position = UDim2.fromOffset(3, 3)
			}):Play()
		end
	end

	toggle.MouseButton1Click:Connect(function()

		setValue(not getValue())

		Refresh()
	end)

	Refresh()

	return holder
end

