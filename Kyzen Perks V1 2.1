local MainOpen = true

local function OpenMain()

	MainOpen = true

	Main.Visible = true

	Main.Size = UDim2.fromOffset(660, 440)

	Tween(
		Main,
		0.22,
		{
			Size = UDim2.fromOffset(700, 470)
		}
	):Play()
end

local function CloseMain()

	MainOpen = false

	Tween(
		Main,
		0.18,
		{
			Size = UDim2.fromOffset(640, 410)
		}
	):Play()

	task.delay(0.18, function()

		if not MainOpen then
			Main.Visible = false
		end

	end)
end

OpenButton.MouseButton1Click:Connect(function()

	if MainOpen then
		CloseMain()
	else
		OpenMain()
	end
end)

Close.MouseButton1Click:Connect(function()
	CloseMain()
end)

--//========================================================
--// PLAYER SAFETY
--//========================================================

local function ClearIfInvalid()

	if CurrentTarget then

		if CurrentTarget == LocalPlayer then

			CurrentTarget = nil
			LockedTarget = nil

			UpdateTargetVisuals()

			return
		end

		if not IsValidTarget(CurrentTarget) then

			if LockedTarget == CurrentTarget then
				LockedTarget = nil
			end

			SetTarget(nil)
		end
	end
end

Players.PlayerRemoving:Connect(function(player)

	if player == CurrentTarget then

		CurrentTarget = nil
		LockedTarget = nil

		RemoveTargetVisuals()
	end
end)

