--//========================================================
--// SELECT TARGET
--//========================================================

local function SetTarget(player)
	if player == LocalPlayer then
		player = nil
	end

	if player and not IsValidTarget(player) then
		player = nil
	end

	if CurrentTarget == player then
		return
	end

	CurrentTarget = player
	LastTarget = player

	UpdateTargetVisuals()
end

--//========================================================
--// UPDATE TARGET
--//========================================================

local function UpdateTarget()

	-- If both systems are OFF,
	-- clear target.
	if not Settings.TargetLock
		and not Settings.AimAssist then

		if CurrentTarget then
			SetTarget(nil)
		end

		return
	end

	-- TARGET LOCK
	if Settings.TargetLock then

		local locked = FindLocked()

		if locked then
			SetTarget(locked)
			return
		end

		-- If no locked target exists,
		-- automatically choose one.
		local chosen = ChooseTarget()

		if chosen then

			LockedTarget = chosen
			SetTarget(chosen)

			return
		end
	end

	-- AIM ASSIST
	if Settings.AimAssist then

		local chosen = ChooseTarget()

		if chosen then
			SetTarget(chosen)
			return
		end
	end

	SetTarget(nil)
end

--//========================================================
--// CAMERA AIM
--//========================================================

local function UpdateTargetCamera(deltaTime)

	if not Settings.TargetLock
		and not Settings.AimAssist then

		return
	end

	local target = CurrentTarget

	if not target then
		return
	end

	if target == LocalPlayer then
		SetTarget(nil)
		return
	end

	if not IsValidTarget(target) then

		if Settings.TargetLock then
			LockedTarget = nil
		end

		SetTarget(nil)

		return
	end

	local character = target.Character
	local head = GetHead(character)

	if not head then
		return
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local cameraPosition = camera.CFrame.Position

	-- HEAD TARGET
	local desiredCFrame =
		CFrame.lookAt(
			cameraPosition,
			head.Position
		)

	-- Smooth but strong.
	local strength =
		math.clamp(
			Settings.AimSmoothness
			* Settings.CameraStrength
			* 10,
			0.5,
			18
		)

	local alpha =
		1 - math.exp(
			-strength
			* math.max(deltaTime, 1 / 240)
		)

	camera.CFrame =
		camera.CFrame:Lerp(
			desiredCFrame,
			alpha
		)
end

