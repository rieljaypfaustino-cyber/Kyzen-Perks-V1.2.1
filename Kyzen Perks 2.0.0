local Pages = {}

local function CreatePage(name)

	local page = New("ScrollingFrame", {

		Name = name,

		Size = UDim2.fromScale(
			1,
			1
		),

		BackgroundTransparency = 1,

		BorderSizePixel = 0,

		ScrollBarThickness = 2,

		ScrollBarImageColor3 = Blue,

		AutomaticCanvasSize =
			Enum.AutomaticSize.Y,

		CanvasSize =
			UDim2.new(
				0,
				0,
				0,
				0
			),

		Visible = false,

		ZIndex = 12,

	}, Content)

	Pages[name] = page

	return page
end

local AimPage = CreatePage("AimTarget")
local SettingsPage = CreatePage("Settings")
local InfoPage = CreatePage("InfoCredit")

