--========================================================
-- TOGGLE
--========================================================

local function CreateToggle(
	page,
	title,
	description,
	default,
	callback,
	order
)

	local box = New("Frame", {

		Size = UDim2.new(
			1,
			0,
			0,
			55
		),

		BackgroundColor3 = Panel2,

		LayoutOrder = order,

		ZIndex = 13,

	}, page)

	AddCorner(box, 9)
	AddStroke(box, StrokeColor, 1, 0.15)

	New("TextLabel", {

		Position = UDim2.new(
			0,
			12,
			0,
			7
		),

		Size = UDim2.new(
			1,
			-85,
			0,
			19
		),

		BackgroundTransparency = 1,

		Text = title,

		TextColor3 = White,

		TextSize = 10,

		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 14,

	}, box)

	New("TextLabel", {

		Position = UDim2.new(
			0,
			12,
			0,
			27
		),

		Size = UDim2.new(
			1,
			-85,
			0,
			16
		),

		BackgroundTransparency = 1,

		Text = description,

		TextColor3 = Gray,

		TextSize = 7.5,

		Font = Enum.Font.GothamMedium,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 14,

	}, box)

	local toggle = New("TextButton", {

		AnchorPoint = Vector2.new(
			1,
			0.5
		),

		Position = UDim2.new(
			1,
			-11,
			0.5,
			0
		),

		Size = UDim2.fromOffset(
			45,
			23
		),

		BackgroundColor3 = Color3.fromRGB(
			55,
			63,
			78
		),

		Text = "",

		AutoButtonColor = false,

		ZIndex = 15,

	}, box)

	AddCorner(toggle, 999)

	local dot = New("Frame", {

		AnchorPoint = Vector2.new(
			0,
			0.5
		),

		Position = UDim2.new(
			0,
			3,
			0.5,
			0
		),

		Size = UDim2.fromOffset(
			17,
			17
		),

		BackgroundColor3 = White,

		ZIndex = 16,

	}, toggle)

	AddCorner(dot, 999)

	local enabled = default

	local function Refresh()

		if enabled then

			Tween(toggle, 0.14, {
				BackgroundColor3 = Blue,
			}):Play()

			Tween(dot, 0.14, {
				Position = UDim2.new(
					1,
					-20,
					0.5,
					0
				),
			}):Play()

		else

			Tween(toggle, 0.14, {
				BackgroundColor3 =
					Color3.fromRGB(
						55,
						63,
						78
					),
			}):Play()

			Tween(dot, 0.14, {
				Position = UDim2.new(
					0,
					3,
					0.5,
					0
				),
			}):Play()

		end

	end

	toggle.Activated:Connect(function()

		enabled = not enabled

		callback(enabled)

		Refresh()

	end)

	Refresh()

	return box
end

--========================================================
-- NUMBER CONTROL
--========================================================

local function CreateNumber(
	page,
	title,
	description,
	default,
	minimum,
	maximum,
	step,
	callback,
	order
)

	local box = New("Frame", {

		Size = UDim2.new(
			1,
			0,
			0,
			55
		),

		BackgroundColor3 = Panel2,

		LayoutOrder = order,

		ZIndex = 13,

	}, page)

	AddCorner(box, 9)
	AddStroke(box, StrokeColor, 1, 0.15)

	New("TextLabel", {

		Position = UDim2.new(
			0,
			12,
			0,
			7
		),

		Size = UDim2.new(
			1,
			-145,
			0,
			19
		),

		BackgroundTransparency = 1,

		Text = title,

		TextColor3 = White,

		TextSize = 10,

		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 14,

	}, box)

	New("TextLabel", {

		Position = UDim2.new(
			0,
			12,
			0,
			27
		),

		Size = UDim2.new(
			1,
			-145,
			0,
			16
		),

		BackgroundTransparency = 1,

		Text = description,

		TextColor3 = Gray,

		TextSize = 7.5,

		Font = Enum.Font.GothamMedium,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 14,

	}, box)

	local minus = New("TextButton", {

		AnchorPoint = Vector2.new(
			1,
			0.5
		),

		Position = UDim2.new(
			1,
			-76,
			0.5,
			0
		),

		Size = UDim2.fromOffset(
			24,
			24
		),

		BackgroundColor3 = Panel,

		Text = "−",

		TextColor3 = White,

		TextSize = 14,

		Font = Enum.Font.GothamBold,

		AutoButtonColor = false,

		ZIndex = 15,

	}, box)

	AddCorner(minus, 7)
	AddStroke(minus, StrokeColor)

	local valueLabel = New("TextLabel", {

		AnchorPoint = Vector2.new(
			1,
			0.5
		),

		Position = UDim2.new(
			1,
			-40,
			0.5,
			0
		),

		Size = UDim2.fromOffset(
			32,
			24
		),

		BackgroundColor3 = BlueDark,

		TextColor3 = White,

		TextSize = 7,

		Font = Enum.Font.GothamBold,

		ZIndex = 15,

	}, box)

	AddCorner(valueLabel, 7)

	local plus = New("TextButton", {

		AnchorPoint = Vector2.new(
			1,
			0.5
		),

		Position = UDim2.new(
			1,
			-9,
			0.5,
			0
		),

		Size = UDim2.fromOffset(
			24,
			24
		),

		BackgroundColor3 = Panel,

		Text = "+",

		TextColor3 = White,

		TextSize = 14,

		Font = Enum.Font.GothamBold,

		AutoButtonColor = false,

		ZIndex = 15,

	}, box)

	AddCorner(plus, 7)
	AddStroke(plus, StrokeColor)

	local current = default

	local function Refresh()
		valueLabel.Text = tostring(current)
	end

	minus.Activated:Connect(function()

		current = math.clamp(
			current - step,
			minimum,
			maximum
		)

		callback(current)

		Refresh()

	end)

	plus.Activated:Connect(function()

		current = math.clamp(
			current + step,
			minimum,
			maximum
		)

		callback(current)

		Refresh()

	end)

	Refresh()

end

