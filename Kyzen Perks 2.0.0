--========================================================
-- TAB CREATION
--========================================================

local function CreateTab(
	name,
	text,
	order
)

	local button = New("TextButton", {

		Name = name,

		Size = UDim2.new(
			1,
			0,
			0,
			37
		),

		BackgroundColor3 = Panel,

		Text = "   " .. text,

		TextColor3 = Gray,

		TextSize = 7.5,

		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		AutoButtonColor = false,

		LayoutOrder = order,

		ZIndex = 13,

	}, TabHolder)

	AddCorner(button, 7)

	local activeLine = New("Frame", {

		Position = UDim2.new(
			0,
			0,
			0.5,
			-8
		),

		Size = UDim2.fromOffset(
			3,
			16
		),

		BackgroundColor3 = Blue,

		Visible = false,

		ZIndex = 14,

	}, button)

	AddCorner(activeLine, 3)

	TabData[name] = {
		Button = button,
		Line = activeLine,
	}

	button.Activated:Connect(function()

		for pageName, page in pairs(Pages) do

			page.Visible =
				pageName == name

		end

		for tabName, data in pairs(TabData) do

			local active =
				tabName == name

			data.Line.Visible = active

			Tween(data.Button, 0.12, {

				BackgroundColor3 =
					active
					and BlueDark
					or Panel,

				TextColor3 =
					active
					and White
					or Gray,

			}):Play()

		end

	end)

end

CreateTab(
	"AimTarget",
	"AIM & TARGET",
	1
)

CreateTab(
	"Settings",
	"SETTINGS",
	2
)

CreateTab(
	"InfoCredit",
	"INFO & CREDIT",
	3
)

--========================================================
-- TARGET VARIABLES
--========================================================

local CurrentTarget = nil
local LockedTarget = nil

local CurrentHighlight = nil
local CurrentBillboard = nil

--========================================================
-- CLEAR TARGET VISUALS
--========================================================

local function ClearTargetVisuals()

	if CurrentHighlight then

		CurrentHighlight:Destroy()

		CurrentHighlight = nil

	end

	if CurrentBillboard then

		CurrentBillboard:Destroy()

		CurrentBillboard = nil

	end

end

--========================================================
-- PLAYER VALIDATION
--========================================================

local function IsValidTarget(player)

	if not player then
		return false
	end

	if player == LocalPlayer then
		return false
	end

	local character = player.Character

	if not character then
		return false
	end

	if not IsAlive(character) then
		return false
	end

	local head = GetHead(character)
	local root = GetRoot(character)

	if not head or not root then
		return false
	end

	local localCharacter =
		LocalPlayer.Character

	local localRoot =
		GetRoot(localCharacter)

	if not localRoot then
		return false
	end

	local distance =
		(root.Position - localRoot.Position).Magnitude

	if distance > Settings.TargetRange then
		return false
	end

	return true
end

--========================================================
-- FOV CHECK
--========================================================

local function IsInsideFOV(player)

	if not Settings.ShowFOV then
		return true
	end

	local head =
		GetHead(player.Character)

	if not head then
		return false
	end

	local screenPosition, visible =
		Camera:WorldToViewportPoint(
			head.Position
		)

	if not visible then
		return false
	end

	local center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	local point = Vector2.new(
		screenPosition.X,
		screenPosition.Y
	)

	return (
		point - center
	).Magnitude
		<= Settings.FOVRadius
end

--========================================================
-- GET TARGETS
--========================================================

local function GetTargets()

	local targets = {}

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if IsValidTarget(player) then

			if not Settings.ShowFOV
				or IsInsideFOV(player) then

				table.insert(
					targets,
					player
				)

			end

		end

	end

	return targets
end

--========================================================
-- NEAREST
--========================================================

local function FindNearest()

	local localRoot =
		GetRoot(LocalPlayer.Character)

	if not localRoot then
		return nil
	end

	local nearest = nil
	local shortest = math.huge

	for _, player in ipairs(
		GetTargets()
	) do

		local root =
			GetRoot(player.Character)

		if root then

			local distance =
				(
					root.Position
					- localRoot.Position
				).Magnitude

			if distance < shortest then

				shortest = distance
				nearest = player

			end

		end

	end

	return nearest
end

--========================================================
-- SMART TARGET
--========================================================

local function FindSmart()

	local best = nil
	local bestScore = math.huge

	local center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	local localRoot =
		GetRoot(LocalPlayer.Character)

	for _, player in ipairs(
		GetTargets()
	) do

		local head =
			GetHead(player.Character)

		local root =
			GetRoot(player.Character)

		if head and root then

			local screenPosition, visible =
				Camera:WorldToViewportPoint(
					head.Position
				)

			if visible then

				local screenPoint =
					Vector2.new(
						screenPosition.X,
						screenPosition.Y
					)

				local screenDistance =
					(
						screenPoint
						- center
					).Magnitude

				local worldDistance = 0

				if localRoot then

					worldDistance =
						(
							root.Position
							- localRoot.Position
						).Magnitude

				end

				-- CENTER IS MORE IMPORTANT
				-- THAN WORLD DISTANCE
				local score =
					screenDistance
					+ (worldDistance * 0.08)

				if score < bestScore then

					bestScore = score
					best = player

				end

			end

		end

	end

	return best
end

--========================================================
-- LOCK TARGET
--========================================================

local function FindLocked()

	if LockedTarget
		and IsValidTarget(LockedTarget) then

		return LockedTarget
	end

	local newTarget = FindSmart()

	LockedTarget = newTarget

	return newTarget
end

--========================================================
-- TARGET VISUALS
--========================================================

function UpdateTargetVisuals()

	ClearTargetVisuals()

	if not CurrentTarget then
		return
	end

	if not IsValidTarget(CurrentTarget) then
		return
	end

	local character =
		CurrentTarget.Character

	if not character then
		return
	end

	--====================================================
	-- THROUGH WALL ESP
	--====================================================

	if Settings.ShowHighlight then

		local highlight =
			Instance.new("Highlight")

		highlight.Name =
			"KyzenTargetESP"

		highlight.Adornee =
			character

		highlight.FillColor =
			Red

		highlight.FillTransparency =
			0.78

		highlight.OutlineColor =
			Red2

		highlight.OutlineTransparency =
			0

		-- IMPORTANT:
		-- ALWAYS ON TOP = visible through walls
		highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop

		highlight.Parent =
			character

		CurrentHighlight =
			highlight

	end

	--====================================================
	-- TARGET TEXT
	--====================================================

	if Settings.ShowTargetText then

		local head =
			GetHead(character)

		if head then

			local billboard =
				Instance.new("BillboardGui")

			billboard.Name =
				"KyzenTargetText"

			billboard.Adornee =
				head

			billboard.AlwaysOnTop =
				true

			billboard.MaxDistance =
				10000

			billboard.Size =
				UDim2.fromOffset(
					190,
					32
				)

			billboard.StudsOffset =
				Vector3.new(
					0,
					3.2,
					0
				)

			billboard.Parent =
				head

			local text =
				New("TextLabel", {

					Size =
						UDim2.fromScale(
							1,
							1
						),

					BackgroundTransparency = 1,

					Text =
						"TARGET  •  "
						.. CurrentTarget.DisplayName,

					TextColor3 =
						Red2,

					TextStrokeColor3 =
						Color3.fromRGB(
							0,
							0,
							0
						),

					TextStrokeTransparency =
						0,

					TextSize = 10,

					Font =
						Enum.Font.GothamBold,

					ZIndex = 20,

				}, billboard)

			CurrentBillboard =
				billboard

		end

	end
end

--========================================================
-- CHOOSE TARGET
--========================================================

local function ChooseTarget()

	-- LOCK MODE
	if Settings.TargetMode == "LOCK" then

		return FindLocked()

	end

	-- TARGET LOCK ENABLED
	if Settings.TargetLock then

		if LockedTarget
			and IsValidTarget(
				LockedTarget
			) then

			return LockedTarget
		end

		local target =
			FindSmart()

		LockedTarget =
			target

		return target
	end

	-- NEAREST
	if Settings.TargetMode == "NEAREST" then

		return FindNearest()

	end

	-- SMART
	return FindSmart()
end

--========================================================
-- UPDATE TARGET
--========================================================

local LastTarget = nil

local function UpdateTarget()

	local target =
		ChooseTarget()

	-- If target changed
	if target ~= LastTarget then

		LastTarget = target

		CurrentTarget =
			target

		if target then

			LockedTarget =
				target

		end

		UpdateTargetVisuals()

	end

	-- Invalid target
	if CurrentTarget
		and not IsValidTarget(
			CurrentTarget
		) then

		CurrentTarget = nil
		LastTarget = nil

		if Settings.TargetMode ~= "LOCK"
			and not Settings.TargetLock then

			LockedTarget = nil

		end

		ClearTargetVisuals()

	end
end

--========================================================
-- CAMERA TARGETING
--========================================================

local function UpdateTargetCamera(deltaTime)

	if not Settings.TargetLock
		and not Settings.AimAssist then

		return
	end

	local target =
		CurrentTarget

	if not target then
		return
	end

	if not IsValidTarget(target) then
		return
	end

	-- HEAD ONLY
	local head =
		GetHead(target.Character)

	if not head then
		return
	end

	--====================================================
	-- TRUE 360° WORLD TRACKING
	--====================================================

	local cameraPosition =
		Camera.CFrame.Position

	local direction =
		head.Position
		- cameraPosition

	if direction.Magnitude <= 0.01 then
		return
	end

	local desired =
		CFrame.lookAt(
			cameraPosition,
			head.Position
		)

	--====================================================
	-- SMOOTHNESS
	--====================================================

	-- Higher smoothness value =
	-- faster target locking.
	local strength =
		math.clamp(
			Settings.AimSmoothness
			* Settings.CameraStrength
			* 9,

			0.5,
			14
		)

	local alpha =
		1
		- math.exp(
			-strength
			* math.max(
				deltaTime,
				1 / 240
			)
		)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			desired,
			alpha
		)
end

--========================================================
-- CAMERA RENDER LOOP
--========================================================

RunService:BindToRenderStep(
	"KyzenPerksCamera",
	Enum.RenderPriority.Camera.Value + 100,

	function(deltaTime)

		if not ScreenGui.Parent then
			return
		end

		UpdateTargetCamera(
			deltaTime
		)

	end
)

--========================================================
-- TARGET UPDATE LOOP
--========================================================

task.spawn(function()

	while ScreenGui.Parent do

		UpdateTarget()

		task.wait(
			Settings.TargetRefresh
		)

	end

end)

--========================================================
-- FOV CENTER SAFETY
--========================================================

task.spawn(function()

	while ScreenGui.Parent do

		FOVCircle.AnchorPoint =
			Vector2.new(
				0.5,
				0.5
			)

		FOVCircle.Position =
			UDim2.fromScale(
				0.5,
				0.5
			)

		FOVCircle.Size =
			UDim2.fromOffset(
				Settings.FOVRadius * 2,
				Settings.FOVRadius * 2
			)

		FOVCircle.Visible =
			Settings.ShowFOV

		task.wait(0.05)

	end

end)

--========================================================
-- PLAYER REMOVAL
--========================================================

Players.PlayerRemoving:Connect(
	function(player)

		if player == CurrentTarget
			or player == LockedTarget then

			CurrentTarget = nil
			LockedTarget = nil
			LastTarget = nil

			ClearTargetVisuals()

		end

	end
)

--========================================================
-- RESPAWN
--========================================================

LocalPlayer.CharacterAdded:Connect(
	function()

		CurrentTarget = nil
		LockedTarget = nil
		LastTarget = nil

		ClearTargetVisuals()

		task.wait(0.4)

		UpdateUIScale()

	end
)

--========================================================
-- DRAGGING
--========================================================

local dragging = false
local dragStart = nil
local startPosition = nil

Header.InputBegan:Connect(
	function(input)

		if input.UserInputType
			== Enum.UserInputType.MouseButton1
			or input.UserInputType
			== Enum.UserInputType.Touch then

			dragging = true

			dragStart =
				input.Position

			startPosition =
				Main.Position

		end

	end
)

Header.InputEnded:Connect(
	function(input)

		if input.UserInputType
			== Enum.UserInputType.MouseButton1
			or input.UserInputType
			== Enum.UserInputType.Touch then

			dragging = false

		end

	end
)

UserInputService.InputChanged:Connect(
	function(input)

		if not dragging then
			return
		end

		if input.UserInputType
			~= Enum.UserInputType.MouseMovement
			and input.UserInputType
			~= Enum.UserInputType.Touch then

			return
		end

		local delta =
			input.Position
			- dragStart

		Main.Position =
			UDim2.new(

				startPosition.X.Scale,

				startPosition.X.Offset
					+ delta.X,

				startPosition.Y.Scale,

				startPosition.Y.Offset
					+ delta.Y

			)

	end
)

--========================================================
-- OPEN / CLOSE
--========================================================

local function OpenGUI()

	if Main.Visible then
		return
	end

	Main.Visible = true

	Main.Size =
		UDim2.fromOffset(
			640,
			405
		)

	Tween(
		Main,
		0.22,
		{
			Size =
				UDim2.fromOffset(
					680,
					430
				)
		}
	):Play()

	-- First page
	for name, page in pairs(Pages) do
		page.Visible =
			name == "AimTarget"
	end

	-- First tab
	for name, data in pairs(TabData) do

		local active =
			name == "AimTarget"

		data.Line.Visible =
			active

		data.Button.BackgroundColor3 =
			active
			and BlueDark
			or Panel

		data.Button.TextColor3 =
			active
			and White
			or Gray

	end
end

local function CloseGUI()

	Tween(
		Main,
		0.16,
		{
			Size =
				UDim2.fromOffset(
					640,
					405
				)
		}
	):Play()

	task.delay(
		0.16,
		function()

			if Main.Parent then
				Main.Visible = false
			end

		end
	)
end

OpenButton.Activated:Connect(
	function()

		if Main.Visible then
			CloseGUI()
		else
			OpenGUI()
		end

	end
)

Close.Activated:Connect(
	CloseGUI
)

--========================================================
-- CLOSE HOVER
--========================================================

Close.MouseEnter:Connect(
	function()

		Tween(
			Close,
			0.1,
			{
				BackgroundColor3 =
					Red2
			}
		):Play()

	end
)

Close.MouseLeave:Connect(
	function()

		Tween(
			Close,
			0.1,
			{
				BackgroundColor3 =
					Red
			}
		):Play()

	end
)

--========================================================
-- INITIAL
--========================================================

FOVCircle.Visible = false

task.delay(
	0.25,
	function()

		OpenGUI()

	end
)

