	TextSize = 10,

	Font = Enum.Font.GothamBold,

	TextXAlignment = Enum.TextXAlignment.Left,

	ZIndex = 14,

}, ModeBox)

local Modes = {
	"SMART",
	"NEAREST",
	"LOCK"
}

for index, mode in ipairs(Modes) do

	local button = New("TextButton", {

		Position = UDim2.new(
			0,
			10 + ((index - 1) * 86),
			0,
			34
		),

		Size = UDim2.fromOffset(
			78,
			26
		),

		BackgroundColor3 =
			mode == Settings.TargetMode
			and Blue
			or Panel,

		Text = mode,

		TextColor3 = White,

		TextSize = 7.5,

		Font = Enum.Font.GothamBold,

		AutoButtonColor = false,

		ZIndex = 14,

	}, ModeBox)

	AddCorner(button, 7)
	AddStroke(button, StrokeColor)

	button.Activated:Connect(function()

		Settings.TargetMode = mode

		if mode == "LOCK" then
			LockedTarget = CurrentTarget
		else
			LockedTarget = nil
		end

		for _, child in ipairs(
			ModeBox:GetChildren()
		) do

			if child:IsA("TextButton") then

				child.BackgroundColor3 =
					child.Text == mode
					and Blue
					or Panel

			end

		end

	end)

end

