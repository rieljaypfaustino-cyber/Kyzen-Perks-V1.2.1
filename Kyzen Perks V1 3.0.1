--------------------------------------------------------
-- SELECT TARGET
--------------------------------------------------------

local function SelectTarget(candidate)

	if not candidate then

		CurrentTarget = nil

		ClearTargetVisual()

		return
	end

	if CurrentTarget
		and CurrentTarget.Model ==
		candidate.Model then

		return
	end

	CurrentTarget =
		candidate

	ApplyTargetVisual(
		candidate.Model
	)
end

--------------------------------------------------------
-- TARGET UPDATE
--------------------------------------------------------

local function UpdateTarget()

	if not (
		Settings.TargetLock
		or Settings.AimAssist
	) then

		CurrentTarget = nil
		LockedTarget = nil

		ClearTargetVisual()

		return
	end

	local candidates =
		GetCandidates()

	if #candidates == 0 then

		CurrentTarget = nil
		LockedTarget = nil

		ClearTargetVisual()

		return
	end

	local selected

	----------------------------------------------------
	-- LOCK
	----------------------------------------------------

	if Settings.TargetMode ==
		"LOCK" then

		selected =
			FindLocked(candidates)

		if not selected then

			selected =
				FindNearest(candidates)

		end

	----------------------------------------------------
	-- NEAREST
	----------------------------------------------------

	elseif Settings.TargetMode ==
		"NEAREST" then

		selected =
			FindNearest(candidates)

	----------------------------------------------------
	-- SMART
	----------------------------------------------------

	else

		selected =
			FindSmart(candidates)

	end

	if selected then

		SelectTarget(selected)

		-- Only create a locked reference
		-- while targeting is active.

		LockedTarget =
			selected.Model

	else

		CurrentTarget = nil

		ClearTargetVisual()

	end
end

--------------------------------------------------------
-- CAMERA ACTIVATION
--------------------------------------------------------

local function EnableTargetCamera()

	local camera =
		GetCamera()

	if not camera then
		return
	end

	if camera.CameraType
		~= Enum.CameraType.Scriptable then

		CameraWasScriptable = false

	else

		CameraWasScriptable = true
	end

	camera.CameraType =
		Enum.CameraType.Scriptable
end

--------------------------------------------------------
-- CAMERA RESTORE
--------------------------------------------------------

local function DisableTargetCamera()

	local camera =
		GetCamera()

	if not camera then
		return
	end

	if not (
		Settings.TargetLock
		or Settings.AimAssist
	) then

		if not CameraWasScriptable then

			camera.CameraType =
				Enum.CameraType.Custom

			camera.CameraSubject =
				LocalPlayer.Character
				and LocalPlayer.Character:
					FindFirstChildOfClass("Humanoid")

		end

	end
end

--------------------------------------------------------
-- CAMERA SMOOTHNESS
--------------------------------------------------------

local function GetSmoothAlpha(deltaTime)

	-- 1 = slowest
	-- 100 = fastest

	local normalized =
		math.clamp(
			Settings.AimSmoothness / 100,
			0.01,
			1
		)

	-- At 60 FPS:
	-- 18 behaves close to the old 0.18 Lerp.
	--
	-- But this calculation is frame-rate independent.

	local frameAlpha =
		1 - math.pow(
			1 - normalized,
			deltaTime * 60
		)

	frameAlpha *=
		math.max(
			Settings.CameraSpeed,
			0.01
		)

	return math.clamp(
		frameAlpha,
		0.01,
		1
	)
end

--------------------------------------------------------
-- CAMERA UPDATE
--------------------------------------------------------

local function UpdateCamera(deltaTime)

	if not (
		Settings.TargetLock
		or Settings.AimAssist
	) then

		DisableTargetCamera()

		return
	end

	if not CurrentTarget then
		return
	end

	local camera =
		GetCamera()

	if not camera then
		return
	end

	local model =
		CurrentTarget.Model

	if not model
		or not model.Parent then

		CurrentTarget = nil
		return
	end

	if not IsValidTarget(model) then

		CurrentTarget = nil
		LockedTarget = nil

		ClearTargetVisual()

		return
	end

	local head =
		GetHead(model)

	if not head then
		return
	end

	----------------------------------------------------
	-- FORCE SCRIPTABLE
	----------------------------------------------------

	if camera.CameraType
		~= Enum.CameraType.Scriptable then

		camera.CameraType =
			Enum.CameraType.Scriptable
	end

	----------------------------------------------------
	-- KEEP CURRENT CAMERA POSITION
	----------------------------------------------------

	local cameraPosition =
		camera.CFrame.Position

	----------------------------------------------------
	-- ALWAYS LOOK AT HEAD
	----------------------------------------------------

	local desired =
		CFrame.lookAt(
			cameraPosition,
			head.Position
		)

	----------------------------------------------------
	-- SMOOTH
	----------------------------------------------------

	local alpha =
		GetSmoothAlpha(deltaTime)

	camera.CFrame =
		camera.CFrame:Lerp(
			desired,
			alpha
		)
end

--------------------------------------------------------
-- RENDER STEP
--------------------------------------------------------

pcall(function()

	RunService:UnbindFromRenderStep(
		"KyzenPerksCamera"
	)

end)

RunService:BindToRenderStep(
	"KyzenPerksCamera",
	Enum.RenderPriority.Camera.Value + 10,
	function(deltaTime)

		if Settings.TargetLock
			or Settings.AimAssist then

			EnableTargetCamera()

		end

		UpdateCamera(
			deltaTime
		)
	end
)

--------------------------------------------------------
-- TARGET LOOP
--------------------------------------------------------

task.spawn(function()

	while ScreenGui.Parent do

		if Settings.TargetLock
			or Settings.AimAssist then

			UpdateTarget()

		end

		task.wait(0.04)
	end

end)

--------------------------------------------------------
-- VISUAL SAFETY
--------------------------------------------------------

task.spawn(function()

	while ScreenGui.Parent do

		if CurrentTarget then

			local model =
				CurrentTarget.Model

			if not model
				or not model.Parent
				or not IsValidTarget(model) then

				CurrentTarget = nil

				LockedTarget = nil

				ClearTargetVisual()
			end
		end

		task.wait(0.08)
	end

end)

--------------------------------------------------------
-- FOV POSITION
--------------------------------------------------------

RunService.RenderStepped:Connect(function()

	if FOVCircle then

		FOVCircle.Position =
			UDim2.fromScale(
				0.5,
				0.5
			)

	end

	if FOVLabel then

		FOVLabel.Position =
			UDim2.new(
				0.5,
				0,
				0.5,
				-(Settings.FOVRadius + 8)
			)

	end
end)

--------------------------------------------------------
-- RESPAWN
--------------------------------------------------------

LocalPlayer.CharacterAdded:Connect(function()

	CurrentTarget = nil

	LockedTarget = nil

	ClearTargetVisual()

	----------------------------------------------------
	-- RESTORE CAMERA
	----------------------------------------------------

	task.wait(0.5)

	local camera =
		GetCamera()

	if camera
		and not (
			Settings.TargetLock
			or Settings.AimAssist
		) then

		camera.CameraType =
			Enum.CameraType.Custom

		local humanoid =
			LocalPlayer.Character:
			FindFirstChildOfClass("Humanoid")

		if humanoid then
			camera.CameraSubject =
				humanoid
		end
	end

	if Settings.ShowFOV then
		SetFOVVisible(true)
	end

end)

--------------------------------------------------------
-- TOGGLE SAFETY
--------------------------------------------------------

task.spawn(function()

	while ScreenGui.Parent do

		if not (
			Settings.TargetLock
			or Settings.AimAssist
		) then

			local camera =
				GetCamera()

			if camera
				and camera.CameraType ==
				Enum.CameraType.Scriptable
				and not CameraWasScriptable then

				camera.CameraType =
					Enum.CameraType.Custom

				local character =
					LocalPlayer.Character

				if character then

					local humanoid =
						character:
						FindFirstChildOfClass(
							"Humanoid"
						)

					if humanoid then

						camera.CameraSubject =
							humanoid

					end
				end
			end
		end

		task.wait(0.1)
	end
end)

