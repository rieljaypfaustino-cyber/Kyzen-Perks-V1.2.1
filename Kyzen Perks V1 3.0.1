-- LOADING
--------------------------------------------------------

task.spawn(function()

	local steps = {

		{
			Progress = 0.18,
			Status = "Loading interface..."
		},

		{
			Progress = 0.38,
			Status = "Loading target system..."
		},

		{
			Progress = 0.58,
			Status = "Loading FOV detection..."
		},

		{
			Progress = 0.78,
			Status = "Loading developer controls..."
		},

		{
			Progress = 1,
			Status = "System ready."
		},
	}

	for _, step in ipairs(steps) do

		LoadingStatus.Text =
			step.Status

		Tween(
			LoadingFill,
			{
				Size = UDim2.new(
					step.Progress,
					0,
					1,
					0
				)
			},
			0.28,
			Enum.EasingStyle.Quad
		)

		task.wait(0.32)
	end

	task.wait(0.35)

	for _, child in ipairs(
		LoadingOverlay:GetDescendants()
	) do

		if child:IsA("TextLabel") then

			Tween(
				child,
				{
					TextTransparency = 1
				},
				0.2
			)

		elseif child:IsA("Frame") then

			Tween(
				child,
				{
					BackgroundTransparency = 1
				},
				0.2
			)
		end
	end

	Tween(
		LoadingOverlay,
		{
			BackgroundTransparency = 1
		},
		0.25
	)

	task.wait(0.3)

	LoadingOverlay.Visible =
		false

	OpenMain()

end)

