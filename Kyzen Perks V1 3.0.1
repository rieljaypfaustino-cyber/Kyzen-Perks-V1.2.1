local function CreateToggle(parent, title, description, initialValue, callback)

	local holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundColor3 = COLORS.Panel2,
		BorderSizePixel = 0,
		LayoutOrder = 3,
		ZIndex = 23,
	}, parent)

	AddCorner(holder, 8)
	AddStroke(holder, Color3.fromRGB(38, 45, 57), 1, 0)

	New("TextLabel", {
		Position = UDim2.fromOffset(13, 9),
		Size = UDim2.new(1, -80, 0, 22),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = COLORS.White,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 24,
	}, holder)

	New("TextLabel", {
		Position = UDim2.fromOffset(13, 31),
		Size = UDim2.new(1, -80, 0, 18),
		BackgroundTransparency = 1,
		Text = description,
		TextColor3 = COLORS.Muted,
		TextSize = 9,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 24,
	}, holder)

	local button = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -13, 0.5, 0),
		Size = UDim2.fromOffset(42, 23),
		BackgroundColor3 = Color3.fromRGB(35, 40, 49),
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 25,
	}, holder)

	AddCorner(button, 20)

	local dot = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(17, 17),
		BackgroundColor3 = COLORS.Light,
		BorderSizePixel = 0,
		ZIndex = 26,
	}, button)

	AddCorner(dot, 20)

	local state = initialValue

	local function Refresh()
		if state then
			Tween(button, {
				BackgroundColor3 = COLORS.Blue
			}, 0.12)

			Tween(dot, {
				Position = UDim2.new(1, -20, 0.5, 0),
				BackgroundColor3 = COLORS.White
			}, 0.12)
		else
			Tween(button, {
				BackgroundColor3 = Color3.fromRGB(35, 40, 49)
			}, 0.12)

			Tween(dot, {
				Position = UDim2.new(0, 3, 0.5, 0),
				BackgroundColor3 = COLORS.Light
			}, 0.12)
		end
	end

	button.MouseButton1Click:Connect(function()

		state = not state

		Refresh()

		if callback then
			callback(state)
		end
	end)

	Refresh()

	return holder
end

