local function CreateModeSelector(parent)

	local holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 82),
		BackgroundColor3 = COLORS.Panel2,
		BorderSizePixel = 0,
		LayoutOrder = 5,
		ZIndex = 23,
	}, parent)

	AddCorner(holder, 8)
	AddStroke(holder, Color3.fromRGB(38, 45, 57), 1, 0)

	New("TextLabel", {
		Position = UDim2.fromOffset(13, 8),
		Size = UDim2.new(1, -26, 0, 20),
		BackgroundTransparency = 1,
		Text = "TARGET MODE",
		TextColor3 = COLORS.White,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 24,
	}, holder)

	New("TextLabel", {
		Position = UDim2.fromOffset(13, 28),
		Size = UDim2.new(1, -26, 0, 16),
		BackgroundTransparency = 1,
		Text = "Choose how the target is selected.",
		TextColor3 = COLORS.Muted,
		TextSize = 9,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 24,
	}, holder)

	local modes = {
		"SMART",
		"NEAREST",
		"LOCK",
	}

	local buttons = {}

	for index, mode in ipairs(modes) do

		local button = New("TextButton", {
			Position = UDim2.new(
				0,
				13 + ((index - 1) * 92),
				0,
				52
			),

			Size = UDim2.fromOffset(84, 22),

			BackgroundColor3 = Color3.fromRGB(27, 32, 41),

			BorderSizePixel = 0,

			Text = mode,

			TextColor3 = COLORS.Light,

			TextSize = 9,

			Font = Enum.Font.GothamBold,

			AutoButtonColor = false,

			ZIndex = 25,
		}, holder)

		AddCorner(button, 6)

		button.MouseButton1Click:Connect(function()
			Settings.TargetMode = mode

			for _, info in ipairs(buttons) do

				if info.mode == Settings.TargetMode then

					info.button.BackgroundColor3 = COLORS.Blue
					info.button.TextColor3 = COLORS.White

				else

					info.button.BackgroundColor3 =
						Color3.fromRGB(27, 32, 41)

					info.button.TextColor3 = COLORS.Light
				end
			end
		end)

		table.insert(buttons, {
			mode = mode,
			button = button,
		})
	end

	for _, info in ipairs(buttons) do
		if info.mode == Settings.TargetMode then
			info.button.BackgroundColor3 = COLORS.Blue
			info.button.TextColor3 = COLORS.White
		end
	end

	return holder
end

